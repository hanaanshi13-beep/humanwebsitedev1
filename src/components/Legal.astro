---
import Base from '../layouts/Base.astro';
interface Props {
  title: string;
  intro: string;
  sections: { h: string; items: string[] }[];
}
const { title, intro, sections } = Astro.props;
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<Base title={`${title} (draft) — HUMAN`} description={`${title} for HUMAN. Draft — not approved for public launch.`}>
  <article class="legal on-light">
    <div class="wrap legal__grid">
      <header class="legal__head">
        <p class="legal__flag" role="note">Draft — not approved for public launch</p>
        <h1 class="display">{title}</h1>
        <p class="lede">{intro}</p>
        <p class="note">
          This page is an outline awaiting legal review. It is not a binding notice or agreement, and it has no
          effective date. HUMAN is not collecting personal information through this website yet.
        </p>
      </header>
      <nav class="legal__toc" aria-label="On this page">
        <h2 class="eyebrow no-rule"><span>On this page</span></h2>
        <ol>
          {sections.map((s) => <li><a href={`#${slug(s.h)}`}>{s.h}</a></li>)}
        </ol>
      </nav>
      <div class="legal__body">
        {
          sections.map((s) => (
            <section id={slug(s.h)}>
              <h2>{s.h}</h2>
              <p class="note">To be confirmed in review. This section is intended to cover:</p>
              <ul>
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </section>
          ))
        }
        <p class="note">
          Related drafts: <a class="text-link" href="/privacy">Privacy</a> ·
          <a class="text-link" href="/terms">Terms</a> ·
          <a class="text-link" href="/medical-disclaimer">Medical disclaimer</a>
        </p>
      </div>
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: calc(var(--header-h) + clamp(48px, 7vw, 96px)) clamp(72px, 9vw, 128px);
  }
  .legal__grid {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: 40px clamp(24px, 4vw, 72px);
  }
  .legal__head {
    grid-column: 1 / -1;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--text);
  }
  .legal__head h1 {
    margin: 22px 0;
  }
  .legal__head .note {
    margin-top: 18px;
    max-width: 44em;
  }
  .legal__flag {
    display: inline-block;
    padding: 8px 14px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .legal__toc {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    align-self: start;
  }
  .legal__toc ol {
    margin-top: 12px;
  }
  .legal__toc a {
    display: flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .legal__toc a:hover,
  .legal__toc a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .legal__body section {
    padding-bottom: 36px;
    margin-bottom: 36px;
    border-bottom: 1px solid var(--rule);
    max-width: 44em;
  }
  .legal__body h2 {
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }
  .legal__body ul {
    list-style: disc;
    padding-left: 1.2em;
    margin-top: 12px;
    color: var(--muted);
  }
  .legal__body li + li {
    margin-top: 6px;
  }
  @media (max-width: 899px) {
    .legal__grid {
      grid-template-columns: 1fr;
    }
    .legal__toc {
      position: static;
    }
  }
  @media print {
    .legal__toc {
      display: none;
    }
  }
</style>
