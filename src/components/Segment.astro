---
// Shared page for /women and /men: one structure and one set of styles, two colour worlds and two sets of copy.
// The copy below is founder-approved (2026-11). Plain language; planned areas of focus, not services on offer.
import Base from '../layouts/Base.astro';
import Slot from './Slot.astro';
import Material from './Material.astro';

interface Props {
  variant: 'her' | 'him';
}
const { variant } = Astro.props;
const her = variant === 'her';

const JOURNEY_HEAD = ['Know your health.', 'Stay informed.'];
const c = her
  ? {
      title: 'HUMAN for Her — preventive health, designed for women',
      desc: 'HUMAN is building a preventive health platform in India with a focus on women’s hormones, health markers and conditions. In development; testing and medical services are not yet available.',
      eyebrow: 'HUMAN for Her',
      h1: ['Preventive health.', 'Designed for women.'],
      support:
        'HUMAN is building a preventive health platform in India that focuses on women’s hormones, health markers and conditions that are often overlooked in routine health checkups.',
      one: {
        label: 'Understanding women’s health',
        head: ['Women’s bodies', 'work differently.'],
        body: [
          'From periods and hormonal changes to energy levels and metabolism, women have different health needs.',
          'We believe health checkups should take these differences into account.',
        ],
      },
      areas: {
        label: 'Planned areas of focus',
        head: ['The health issues', 'that matter to women.'],
        note: '',
        items: [
          { t: 'Hormonal health', d: 'Hormonal imbalances, PCOS and irregular periods.', lead: false },
          { t: 'Thyroid health', d: 'Thyroid-related changes in energy, mood and weight.', lead: false },
          { t: 'Nutritional health', d: 'Iron deficiency, vitamin deficiencies and anaemia.', lead: false },
          { t: 'Metabolic health', d: 'Blood sugar, cholesterol and weight management.', lead: false },
          { t: 'Reproductive health', d: 'Menstrual health, fertility and menopause.', lead: false },
          { t: 'Fitness and wellbeing', d: 'Energy levels, physical performance and recovery.', lead: false },
        ],
      },
      approach: {
        label: 'Our approach',
        head: ['More than', 'a routine blood test.'],
        lede: 'We are designing an experience that helps women:',
        numbered: false,
        points: [
          'Understand which health tests are relevant to them.',
          'Make sense of their blood test results.',
          'Understand potential health risks.',
          'Take informed steps towards better health.',
          'Track changes in their health over time.',
        ],
        close: 'The aim is to make health information easier to understand and act on.',
      },
      journey: {
        label: 'The HUMAN approach',
        numbered: false,
        steps: [
          { t: 'Test', d: 'Understand what’s happening inside your body.' },
          { t: 'Understand', d: 'Make sense of your results.' },
          { t: 'Act', d: 'Take informed steps with professional guidance.' },
          { t: 'Track', d: 'Follow changes in your health.' },
          { t: 'Retest', d: 'Check relevant health markers when needed.' },
          { t: 'Improve', d: 'Use what you learn to make better health decisions.' },
        ],
        link: 'See the journey in full',
        note: '',
      },
      cta: {
        label: '',
        head: ['Be among', 'the first.'],
        lede: 'We’re building HUMAN for Her to make preventive healthcare more relevant and accessible to women in India.',
        micro: 'The waitlist is open to women across India. The first pilot is planned for Delhi NCR. Joining registers interest only.',
        disclaimer: 'Nothing on this page is medical advice. For a personal health concern, please speak to a licensed professional.',
      },
      tone: 'garnet' as const,
    }
  : {
      title: 'HUMAN for Him — preventive health, designed for men',
      desc: 'HUMAN is building a preventive health platform in India with a focus on men’s hormones, health markers, physical wellbeing and common health risks. In development; testing and medical services are not yet available.',
      eyebrow: 'HUMAN for Him',
      h1: ['Preventive health.', 'Designed for men.'],
      support:
        'HUMAN is building a preventive health platform in India with a focus on men’s hormones, health markers, physical wellbeing and common health risks.',
      one: {
        label: 'Understanding men’s health',
        head: ['Feeling healthy', 'isn’t the whole picture.'],
        body: [
          'High cholesterol, high blood pressure and diabetes can develop without noticeable symptoms.',
          'Regular health checkups can help you identify potential health risks early and make more informed decisions about your health.',
        ],
      },
      areas: {
        label: 'What we’re focusing on',
        head: ['The health issues', 'that matter to men.'],
        note: 'Our planned areas of focus.',
        items: [
          { t: 'Hormonal health', d: 'Testosterone levels and hormonal imbalances.', lead: true },
          { t: 'Heart health', d: 'Cholesterol, blood pressure and heart disease risk.', lead: true },
          { t: 'Metabolic health', d: 'Blood sugar, diabetes and weight management.', lead: false },
          { t: 'Nutritional health', d: 'Vitamin deficiencies, iron levels and nutrition.', lead: false },
          { t: 'Reproductive health', d: 'Fertility, sexual health and prostate health.', lead: false },
          { t: 'Fitness and recovery', d: 'Muscle health, strength, energy and recovery.', lead: true },
        ],
      },
      approach: {
        label: 'Our approach',
        head: ['More than', 'a routine blood test.'],
        lede: 'We’re building an experience that helps men understand their health beyond a standard blood test report.',
        numbered: true,
        points: [
          'Know which health tests are relevant to you.',
          'Understand your hormones and blood test results.',
          'Identify potential health risks early.',
          'Make informed decisions about your health.',
          'Track your health and physical wellbeing over time.',
        ],
        close: 'Our goal is to make health information easier to understand and act on.',
      },
      journey: {
        label: 'The HUMAN approach',
        numbered: true,
        steps: [
          { t: 'Test', d: 'Get relevant health tests.' },
          { t: 'Understand', d: 'Make sense of your results.' },
          { t: 'Act', d: 'Take informed steps with professional guidance.' },
          { t: 'Track', d: 'Follow changes in your health over time.' },
          { t: 'Retest', d: 'Check relevant health markers when needed.' },
          { t: 'Improve', d: 'Use what you learn to make better health decisions.' },
        ],
        link: 'Explore the complete HUMAN approach',
        note: 'Our planned approach to preventive healthcare.',
      },
      cta: {
        label: 'Join HUMAN',
        head: ['Be among', 'the first.'],
        lede: 'We’re building HUMAN for Him to make preventive healthcare more relevant, accessible and easier to understand for men in India.',
        micro: 'Open to people across India. First pilot planned for Delhi NCR.',
        disclaimer: 'This website does not provide medical advice. Please discuss any personal health concern with a qualified healthcare professional.',
      },
      tone: 'teal' as const,
    };
const nn = (i: number) => String(i + 1).padStart(2, '0');
// The portal photograph doubles as this page's hero once it exists in src/assets/human/.
const photo = variant === 'her' ? 'portal-her' : 'portal-him';
const hasPhoto = Object.keys(import.meta.glob('../assets/human/*.{png,jpg,jpeg,webp,avif}')).some((f) => f.split('/').pop()!.replace(/\.[^.]+$/, '') === photo);
---

<Base title={c.title} description={c.desc} bodyClass={`seg seg--${variant}`}>
  <section class="page-hero seg__hero" aria-labelledby="seg-title" data-reveal-eager>
    <Material tone={c.tone} shape={her ? 'a' : 'c'} />
    <Material tone={c.tone} shape={her ? 'd' : 'b'} opacity={0.5} />
    {hasPhoto && <Slot name={photo} ratio="auto" tone={c.tone} position={her ? '62% 26%' : '42% 12%'} sizes="(max-width: 899px) 100vw, 55vw" eager class="seg__hero-photo" />}
    <div class="wrap seg__hero-inner">
      <p class="eyebrow" data-reveal><span>{c.eyebrow}</span></p>
      <h1 class="display" id="seg-title" data-reveal="mask" style="--d:80ms">
        <span class="mask"><span>{c.h1[0]}</span></span>
        <span class="mask" style="--i:1"><span><em>{c.h1[1]}</em></span></span>
      </h1>
      <p class="lede" data-reveal style="--d:300ms">{c.support}</p>
      <div class="actions" data-reveal="fade" style="--d:420ms">
        <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
        <a class="link" href="#understanding">Explore further <span class="arr arr--down" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="section seg__one" id="understanding" aria-labelledby="sg-2">
    <div class="wrap split">
      <div class="a">
        <p class="eyebrow" data-reveal><span class="num">01</span><span>{c.one.label}</span></p>
        <h2 class="display" id="sg-2" data-reveal="mask">
          <span class="mask"><span>{c.one.head[0]}</span></span>
          <span class="mask" style="--i:1"><span><em>{c.one.head[1]}</em></span></span>
        </h2>
      </div>
      <div class="b prose seg__one-prose" data-reveal style="--d:120ms">
        {c.one.body.map((t) => <p>{t}</p>)}
      </div>
    </div>
  </section>

  <section class="section on-light sg-areas" aria-labelledby="sg-3">
    <div class="wrap">
      <p class="eyebrow" data-reveal><span class="num">02</span><span>{c.areas.label}</span></p>
      <h2 class="display" id="sg-3" data-reveal="mask">
        <span class="mask"><span>{c.areas.head[0]}</span></span>
        <span class="mask" style="--i:1"><span><em>{c.areas.head[1]}</em></span></span>
      </h2>
      <ol class="sg-areas__list">
        {c.areas.items.map((a, i) => (
          <li class:list={{ 'is-lead': a.lead }} data-reveal style={`--d:${(i % 2) * 90}ms`}>
            <span class="sg-areas__n" aria-hidden="true">{nn(i)}</span>
            <h3>{a.t}</h3>
            <p>{a.d}</p>
          </li>
        ))}
      </ol>
      {c.areas.note && <p class="note sg-note" data-reveal="fade">{c.areas.note}</p>}
    </div>
  </section>

  <section class="section sg-approach" aria-labelledby="sg-4">
    <div class="wrap split">
      <div class="a">
        <p class="eyebrow" data-reveal><span class="num">03</span><span>{c.approach.label}</span></p>
        <h2 class="display" id="sg-4" data-reveal="mask">
          <span class="mask"><span>{c.approach.head[0]}</span></span>
          <span class="mask" style="--i:1"><span><em>{c.approach.head[1]}</em></span></span>
        </h2>
      </div>
      <div class="b sg-approach__body" data-reveal style="--d:120ms">
        <p class="lede">{c.approach.lede}</p>
        {c.approach.numbered ? (
          <ol class="sg-approach__list sg-approach__list--num">
            {c.approach.points.map((h, i) => <li><span class="sg-approach__n" aria-hidden="true">{nn(i)}</span>{h}</li>)}
          </ol>
        ) : (
          <ul class="sg-approach__list">
            {c.approach.points.map((h) => <li>{h}</li>)}
          </ul>
        )}
        <p class="sg-approach__close">{c.approach.close}</p>
      </div>
    </div>
  </section>

  <section class="section on-light seg__journey sg-journey" aria-labelledby="sg-5">
    <div class="wrap">
      <p class="eyebrow" data-reveal><span class="num">04</span><span>{c.journey.label}</span></p>
      <h2 class="display" id="sg-5" data-reveal="mask">
        <span class="mask"><span>{JOURNEY_HEAD[0]}</span></span>
        <span class="mask" style="--i:1"><span><em>{JOURNEY_HEAD[1]}</em></span></span>
      </h2>
      <ol class={`seg__stages seg__stages--${variant}`} data-reveal="fade">
        {c.journey.steps.map((st, i) => (
          <li style={`--i:${i}`}>
            <span class="seg__dot" aria-hidden="true" />
            {c.journey.numbered && <span class="seg__stage-n" aria-hidden="true">{nn(i)}</span>}
            <h3>{st.t}</h3>
            <p>{st.d}</p>
          </li>
        ))}
      </ol>
      <p class="sg-journey__foot" data-reveal="fade">
        <a class="link" href="/#scene-06">{c.journey.link} <span class="arr" aria-hidden="true">→</span></a>
        {c.journey.note && <span class="note">{c.journey.note}</span>}
      </p>
    </div>
  </section>

  <section class="section cta-band seg__cta" aria-labelledby="segcta-title">
    <Material tone={c.tone} shape="b" opacity={0.7} />
    <div class="wrap">
      {c.cta.label && <p class="eyebrow" data-reveal><span class="num">05</span><span>{c.cta.label}</span></p>}
      <h2 class="display" id="segcta-title" data-reveal="mask">
        <span class="mask"><span>{c.cta.head[0]}</span></span>
        <span class="mask" style="--i:1"><span><em>{c.cta.head[1]}</em></span></span>
      </h2>
      <p class="lede" data-reveal style="--d:120ms">{c.cta.lede}</p>
      <div class="actions" data-reveal="fade">
        <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
        <a class="link" href={her ? '/men' : '/women'}>
          {her ? 'HUMAN for Him' : 'HUMAN for Her'} <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="sg-notice" data-reveal="fade" role="note">
        <span class="status-pill">In development</span>
        <p>
          <strong>Currently in development. Testing and medical services are not yet available.</strong>
          {c.cta.disclaimer}
        </p>
      </div>
      <p class="note sg-micro" data-reveal="fade">
        {c.cta.micro}
        <a class="text-link" href="/faq">Read the FAQ</a>
      </p>
    </div>
  </section>
</Base>

<style is:global>
  .seg--her {
    --w-ink: var(--her-ink);
    --w-mid: var(--her-garnet);
    --w-glow: var(--her-glow);
    --w-accent: #f0c9d6;
    --w-accent-dark: #6d2f4b;
  }
  .seg--him {
    --w-ink: var(--him-ink);
    --w-mid: var(--him-ocean);
    --w-glow: var(--him-teal);
    --w-accent: #c9ebe6;
    --w-accent-dark: #1b5a56;
  }
  .seg main > section:not(.on-light) {
    background: var(--w-ink);
    color: var(--text-on-dark);
    --text: var(--text-on-dark);
    --muted: #cfc8c2;
    --rule: rgba(243, 239, 230, 0.2);
    --accent: var(--w-accent);
  }
  .seg main > section.on-light {
    --accent: var(--w-accent-dark);
  }
  .seg .site-footer {
    background: var(--w-ink);
  }
  .seg .seg__hero {
    background: radial-gradient(ellipse at 78% 30%, var(--w-glow) 0%, var(--w-mid) 34%, var(--w-ink) 78%);
  }
  .seg--him .seg__hero {
    background: radial-gradient(ellipse at 22% 24%, var(--w-glow) 0%, var(--w-mid) 34%, var(--w-ink) 78%);
  }
  .seg__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, var(--w-ink) 0%, transparent 46%);
  }
  /* photograph on the side opposite the copy, dissolved into the page colour (no blur over the image) */
  .seg__hero .slot.seg__hero-photo {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(44%, 720px);
    aspect-ratio: auto;
    border-radius: 0;
    z-index: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
  }
  .seg--him .seg__hero .slot.seg__hero-photo {
    inset: 0 auto 0 0;
    -webkit-mask-image: linear-gradient(270deg, transparent 0%, #000 46%);
    mask-image: linear-gradient(270deg, transparent 0%, #000 46%);
  }
  @media (max-width: 899px) {
    .seg__hero .slot.seg__hero-photo,
    .seg--him .seg__hero .slot.seg__hero-photo {
      inset: 0 0 auto 0;
      width: 100%;
      height: 58%;
      -webkit-mask-image: linear-gradient(0deg, transparent 0%, #000 55%);
      mask-image: linear-gradient(0deg, transparent 0%, #000 55%);
      opacity: 0.8;
    }
  }
  .seg__hero h1 {
    max-width: none;
  }
  /* Her: copy bottom-left. Him: copy bottom-right, mirrored composition. */
  .seg--him .seg__hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }
  .seg--him .seg__hero-inner .eyebrow {
    flex-direction: row-reverse;
  }
  .seg--him .seg__hero-inner .actions {
    justify-content: flex-end;
  }
  .seg__one h2,
  .seg__journey h2 {
    margin: 22px 0 0;
  }
  .seg__one-prose {
    font-size: 1.125rem;
    padding-top: clamp(0px, 3.4vw, 46px);
  }

  /* journey — Her: two-column numbered ledger. Him: one horizontal line with six nodes. */
  .seg__stages {
    margin: clamp(40px, 5vw, 72px) 0 32px;
  }
  .seg__stages h3 {
    font-size: clamp(1.25rem, 1.9vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .seg__stages p {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-top: 6px;
  }
  .seg__dot {
    display: block;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    background: var(--w-ink);
  }
  .seg__stages--her {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(24px, 6vw, 96px);
    counter-reset: st;
  }
  .seg__stages--her li {
    position: relative;
    padding: 22px 0 22px 34px;
    border-top: 1px solid var(--rule);
  }
  .seg__stages--her .seg__dot {
    position: absolute;
    left: 0;
    top: 30px;
    background: var(--accent);
  }
  .seg__stages--him {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    padding-top: 0;
  }
  .seg__stages--him::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    height: 1px;
    background: var(--accent);
    transform-origin: left;
  }
  .js-motion .seg__stages--him::before {
    transform: scaleX(0);
    transition: transform 1200ms var(--ease-inout) 150ms;
  }
  .js-motion .seg__stages--him.is-in::before {
    transform: none;
  }
  .seg__stages--him li {
    position: relative;
  }
  .seg__stages--him .seg__dot {
    margin-bottom: 20px;
  }
  .seg__cta h2 {
    margin: 0 0 22px;
  }

  /* ---- HUMAN for Her: areas of focus, approach, notice ---- */
  .sg-areas h2,
  .sg-approach h2 {
    margin: 22px 0 0;
  }
  /* an editorial index, not cards: two ruled columns, a serif numeral, a name and one plain line */
  .sg-areas__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(28px, 6vw, 104px);
    margin-top: clamp(36px, 5vw, 72px);
    border-bottom: 1px solid var(--rule);
  }
  .sg-areas__list li {
    display: grid;
    grid-template-columns: clamp(52px, 5.4vw, 84px) 1fr;
    column-gap: 8px;
    align-items: baseline;
    padding: clamp(22px, 2.6vw, 34px) 0;
    border-top: 1px solid var(--rule);
  }
  .sg-areas__n {
    grid-row: span 2;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    line-height: 1;
    color: var(--accent);
  }
  .sg-areas__list h3 {
    font-size: clamp(1.25rem, 1.9vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .sg-areas__list p {
    margin-top: 8px;
    max-width: 26em;
    color: var(--muted);
    text-wrap: pretty;
  }
  .sg-approach__body {
    padding-top: clamp(0px, 3.4vw, 46px);
  }
  .sg-approach__list {
    margin: clamp(18px, 2vw, 26px) 0 0;
    border-top: 1px solid var(--rule);
  }
  .sg-approach__list li {
    position: relative;
    padding: 16px 0 16px 30px;
    border-bottom: 1px solid var(--rule);
    font-size: 1.125rem;
    line-height: 1.4;
  }
  .sg-approach__list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 1.45em;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }
  .sg-approach__close {
    margin-top: clamp(20px, 2.4vw, 30px);
    max-width: 22em;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .seg .sg-journey .seg__dot {
    background: var(--accent);
  }
  .seg__stage-n {
    display: block;
    margin-bottom: 6px;
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .sg-journey__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 24px;
  }
  .sg-note {
    margin-top: 18px;
  }
  /* slight emphasis for the areas named as priorities: a heavier top rule and a larger name, same layout */
  .sg-areas__list li.is-lead {
    border-top-color: var(--accent);
    box-shadow: inset 0 1px 0 var(--accent);
  }
  .sg-areas__list li.is-lead h3 {
    font-size: clamp(1.375rem, 2.15vw, 1.95rem);
  }
  .sg-areas__list li.is-lead .sg-areas__n {
    font-size: clamp(2rem, 3vw, 2.9rem);
  }
  /* numbered points: a serif numeral in place of the dash */
  .sg-approach__list--num li {
    padding-left: 52px;
  }
  .sg-approach__list--num li::before {
    display: none;
  }
  .sg-approach__n {
    position: absolute;
    left: 0;
    top: 12px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--accent);
  }
  .seg__cta .eyebrow {
    margin-bottom: 22px;
  }
  .sg-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    max-width: 46em;
    margin-top: clamp(28px, 3vw, 40px);
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--muted);
  }
  .sg-notice p {
    flex: 1 1 22em;
  }
  .sg-notice strong {
    display: block;
    color: var(--text);
    font-weight: 600;
  }
  .sg-micro {
    margin-top: 14px;
    max-width: 46em;
  }
  .sg-micro .text-link {
    margin-left: 4px;
