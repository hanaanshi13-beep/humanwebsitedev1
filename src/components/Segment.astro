---
// Shared skeleton for /women and /men so the two routes stay at parity (F01/F02), with deliberately different
// colour worlds, hero composition, theme layout and journey layout. No people photography yet (asset pending).
import Base from '../layouts/Base.astro';
import Slot from './Slot.astro';
import Material from './Material.astro';
import { STAGES } from '../data/site';

interface Props {
  variant: 'her' | 'him';
}
const { variant } = Astro.props;
const her = variant === 'her';

const c = her
  ? {
      title: 'HUMAN for Her — a more thoughtful way to understand your health',
      desc: 'HUMAN for Her is part of a preventive-health membership being built in India. In development; nothing is available yet.',
      eyebrow: 'Human for her',
      h1a: 'A more thoughtful way',
      h1b: 'to understand your health.',
      support:
        'HUMAN is being built around the idea that your health changes with your life — and deserves more than a one-off report.',
      oneTitleA: 'Your health isn’t',
      oneTitleB: 'one-size-fits-all.',
      one: [
        'What matters at twenty-five may not be what matters at forty-five. Work, family, sleep, cycles, plans — they shift, and so does what’s worth paying attention to.',
        'HUMAN for Her starts from your context rather than a checklist. We won’t assume what you’re dealing with, or what you want.',
      ],
      themes: [
        { t: 'Understanding what’s relevant to you', d: 'Not every test is for everyone. The aim is a starting point that reflects your life stage and priorities, considered with professional context.' },
        { t: 'Turning information into better questions', d: 'A result is more useful when you know what to ask about it — and who to ask.' },
        { t: 'Staying connected to follow-through', d: 'Health rarely changes in one appointment. We’re designing for the months in between.' },
      ],
      journeyTitleA: 'One connected',
      journeyTitleB: 'journey.',
      ctaA: 'Be part of',
      ctaB: 'what we’re building.',
      tone: 'garnet' as const,
    }
  : {
      title: 'HUMAN for Him — go beyond what you can see',
      desc: 'HUMAN for Him is part of a preventive-health membership being built in India. In development; nothing is available yet.',
      eyebrow: 'Human for him',
      h1a: 'Go beyond',
      h1b: 'what you can see.',
      support:
        'HUMAN is being built for the part of your health that doesn’t show up in the mirror, at the gym or on a watch.',
      oneTitleA: 'There’s more to your health',
      oneTitleB: 'than how you feel.',
      one: [
        'Plenty of us only think about health when something goes wrong. Feeling fine is good — it just isn’t the whole picture.',
        'HUMAN for Him is about knowing a little more, a little earlier, without the drama. No scare tactics. No performance targets.',
      ],
      themes: [
        { t: 'Relevant context', d: 'Your age, work, family history and habits shape what’s worth looking at. The starting point should reflect that.' },
        { t: 'Understandable information', d: 'Plain explanations, with appropriate professional context, instead of a page of numbers.' },
        { t: 'Meaningful follow-up', d: 'A way to keep going after the first look — so it isn’t a one-off.' },
      ],
      journeyTitleA: 'Six stages,',
      journeyTitleB: 'joined up.',
      ctaA: 'Start with',
      ctaB: 'your interest.',
      tone: 'teal' as const,
    };
// The portal photograph doubles as this page's hero once it exists in src/assets/human/.
const photo = variant === 'her' ? 'portal-her' : 'portal-him';
const hasPhoto = Object.keys(import.meta.glob('../assets/human/*.{png,jpg,jpeg,webp,avif}')).some((f) => f.split('/').pop()!.replace(/\.[^.]+$/, '') === photo);
---

<Base title={c.title} description={c.desc} bodyClass={`seg seg--${variant}`}>
  <section class="page-hero seg__hero" aria-labelledby="seg-title" data-reveal-eager>
    <Material tone={c.tone} shape={her ? 'a' : 'c'} />
    <Material tone={c.tone} shape={her ? 'd' : 'b'} opacity={0.5} />
    {hasPhoto && <Slot name={photo} ratio="auto" tone={c.tone} position={her ? '62% 26%' : '38% 26%'} sizes="(max-width: 899px) 100vw, 55vw" eager class="seg__hero-photo" />}
    <div class="wrap seg__hero-inner">
      <p class="eyebrow" data-reveal><span>{c.eyebrow}</span></p>
      <h1 class="display" id="seg-title" data-reveal="mask" style="--d:80ms">
        <span class="mask"><span>{c.h1a}</span></span>
        <span class="mask" style="--i:1"><span><em>{c.h1b}</em></span></span>
      </h1>
      <p class="lede" data-reveal style="--d:300ms">{c.support}</p>
      <div class="actions" data-reveal="fade" style="--d:420ms">
        <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
        <a class="link" href="#context">Read on <span class="arr arr--down" aria-hidden="true">↓</span></a>
        <span class="status-pill">In development</span>
      </div>
    </div>
  </section>

  <section class="section seg__one" id="context" aria-labelledby="one-title">
    <div class="wrap split">
      <div class="a">
        <p class="eyebrow" data-reveal><span class="num">01</span><span>Context</span></p>
        <h2 class="display" id="one-title" data-reveal="mask">
          <span class="mask"><span>{c.oneTitleA}</span></span>
          <span class="mask" style="--i:1"><span><em>{c.oneTitleB}</em></span></span>
        </h2>
      </div>
      <div class="b prose seg__one-prose" data-reveal style="--d:120ms">
        {c.one.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section seg__themes on-light" aria-labelledby="themes-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal><span class="num">02</span><span>What we’re designing for</span></p>
      <h2 class="vh" id="themes-title">Three themes</h2>
      <ol class={`seg__theme-list seg__theme-list--${variant}`}>
        {
          c.themes.map((t, i) => (
            <li data-reveal style={`--d:${i * 110}ms`}>
              <span class="seg__theme-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t.t}</h3>
              <p>{t.d}</p>
            </li>
          ))
        }
      </ol>
      <p class="note" data-reveal="fade">
        These are design intentions, not confirmed features. No tests, panels or consultations are on offer.
      </p>
    </div>
  </section>

  <section class="section seg__journey" aria-labelledby="journey-title">
    <div class="wrap">
      <p class="eyebrow" data-reveal><span class="num">03</span><span>The planned HUMAN journey</span></p>
      <h2 class="display" id="journey-title" data-reveal="mask">
        <span class="mask"><span>{c.journeyTitleA}</span></span>
        <span class="mask" style="--i:1"><span><em>{c.journeyTitleB}</em></span></span>
      </h2>
      <ol class={`seg__stages seg__stages--${variant}`} data-reveal="fade">
        {
          STAGES.map((s, i) => (
            <li style={`--i:${i}`}>
              <span class="seg__dot" aria-hidden="true" />
              <h3>{s.name}</h3>
              <p>{s.line}</p>
            </li>
          ))
        }
      </ol>
      <p data-reveal="fade">
        <a class="link" href="/#scene-06">See the journey in full <span class="arr" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <section class="section seg__app on-light" aria-labelledby="segapp-title">
    <div class="wrap split">
      <div class="a">
        <p class="eyebrow" data-reveal><span class="num">04</span><span>Where it stands</span></p>
        <h2 class="display" id="segapp-title" data-reveal="mask">
          <span class="mask"><span>We’re developing</span></span>
          <span class="mask" style="--i:1"><span><em>this experience.</em></span></span>
        </h2>
      </div>
      <div class="b prose" data-reveal style="--d:120ms">
        <p>
          An app prototype is in development. We’ll share real screens when they’re ready, rather than illustrations of
          things that don’t exist yet.
        </p>
        <p>
          <strong>Today, HUMAN is not a medical service.</strong> There is nothing to book or buy, and nothing on this
          page is medical advice. For personal health concerns, please speak to a licensed professional.
        </p>
        <p><a class="text-link" href="/faq">Availability, pricing and other straight answers</a></p>
      </div>
    </div>
  </section>

  <section class="section cta-band seg__cta" aria-labelledby="segcta-title">
    <Material tone={c.tone} shape="b" opacity={0.7} />
    <div class="wrap">
      <h2 class="display" id="segcta-title" data-reveal="mask">
        <span class="mask"><span>{c.ctaA}</span></span>
        <span class="mask" style="--i:1"><span><em>{c.ctaB}</em></span></span>
      </h2>
      <p class="lede" data-reveal style="--d:120ms">
        Register your interest and, if you opt in, hear about HUMAN as it develops.
      </p>
      <p class="note" data-reveal="fade" style="margin-top:12px;max-width:36em">
        Open to people across India. First pilot planned for Delhi NCR. Joining registers interest only.
      </p>
      <div class="actions" data-reveal="fade">
        <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
        <a class="link" href={her ? '/men' : '/women'}>
          {her ? 'HUMAN for Him' : 'HUMAN for Her'} <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .seg--her {
    --w-ink: var(--her-ink);
    --w-mid: var(--her-garnet);
    --w-glow: var(--her-glow);
    --w-accent: #f0c9d6;
    --w-accent-dark: #6d2f4b;
  }
  .seg--him {
    --w-ink: var(--him-ink);
    --w-mid: var(--him-ocean);
    --w-glow: var(--him-teal);
    --w-accent: #c9ebe6;
    --w-accent-dark: #1b5a56;
  }
  .seg main > section:not(.on-light) {
    background: var(--w-ink);
    color: var(--text-on-dark);
    --text: var(--text-on-dark);
    --muted: #cfc8c2;
    --rule: rgba(243, 239, 230, 0.2);
    --accent: var(--w-accent);
  }
  .seg main > section.on-light {
    --accent: var(--w-accent-dark);
  }
  .seg .site-footer {
    background: var(--w-ink);
  }
  .seg .seg__hero {
    background: radial-gradient(ellipse at 78% 30%, var(--w-glow) 0%, var(--w-mid) 34%, var(--w-ink) 78%);
  }
  .seg--him .seg__hero {
    background: radial-gradient(ellipse at 22% 24%, var(--w-glow) 0%, var(--w-mid) 34%, var(--w-ink) 78%);
  }
  .seg__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, var(--w-ink) 0%, transparent 46%);
  }
  /* photograph on the side opposite the copy, dissolved into the page colour (no blur over the image) */
  .seg__hero .slot.seg__hero-photo {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(44%, 720px);
    aspect-ratio: auto;
    border-radius: 0;
    z-index: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 46%);
  }
  .seg--him .seg__hero .slot.seg__hero-photo {
    inset: 0 auto 0 0;
    -webkit-mask-image: linear-gradient(270deg, transparent 0%, #000 46%);
    mask-image: linear-gradient(270deg, transparent 0%, #000 46%);
  }
  @media (max-width: 899px) {
    .seg__hero .slot.seg__hero-photo,
    .seg--him .seg__hero .slot.seg__hero-photo {
      inset: 0 0 auto 0;
      width: 100%;
      height: 58%;
      -webkit-mask-image: linear-gradient(0deg, transparent 0%, #000 55%);
      mask-image: linear-gradient(0deg, transparent 0%, #000 55%);
      opacity: 0.8;
    }
  }
  .seg__hero h1 {
    max-width: none;
  }
  /* Her: copy bottom-left. Him: copy bottom-right, mirrored composition. */
  .seg--him .seg__hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
  }
  .seg--him .seg__hero-inner .eyebrow {
    flex-direction: row-reverse;
  }
  .seg--him .seg__hero-inner .actions {
    justify-content: flex-end;
  }
  .seg__one h2,
  .seg__journey h2,
  .seg__app h2 {
    margin: 22px 0 0;
  }
  .seg__one-prose {
    font-size: 1.125rem;
    padding-top: clamp(0px, 3.4vw, 46px);
  }

  /* themes — Her: stacked editorial rows. Him: three offset columns. */
  .seg__theme-list {
    margin: clamp(32px, 4vw, 56px) 0 28px;
  }
  .seg__theme-list h3 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.7rem, 3vw, 2.7rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .seg__theme-list p {
    color: var(--muted);
    max-width: 30em;
  }
  .seg__theme-n {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .seg__theme-list--her li {
    display: grid;
    grid-template-columns: 60px 5fr 6fr;
    gap: 12px clamp(20px, 3vw, 48px);
    align-items: baseline;
    padding: clamp(22px, 3vw, 40px) 0;
    border-top: 1px solid var(--rule);
  }
  .seg__theme-list--her li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .seg__theme-list--him {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 48px);
  }
  .seg__theme-list--him li {
    border-top: 1px solid var(--text);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .seg__theme-list--him li:nth-child(2) {
    margin-top: clamp(0px, 5vw, 72px);
  }
  .seg__theme-list--him li:nth-child(3) {
    margin-top: clamp(0px, 10vw, 144px);
  }

  /* journey — Her: two-column numbered ledger. Him: one horizontal line with six nodes. */
  .seg__stages {
    margin: clamp(40px, 5vw, 72px) 0 32px;
  }
  .seg__stages h3 {
    font-size: clamp(1.25rem, 1.9vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .seg__stages p {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-top: 6px;
  }
  .seg__dot {
    display: block;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    background: var(--w-ink);
  }
  .seg__stages--her {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(24px, 6vw, 96px);
    counter-reset: st;
  }
  .seg__stages--her li {
    position: relative;
    padding: 22px 0 22px 34px;
    border-top: 1px solid var(--rule);
  }
  .seg__stages--her .seg__dot {
    position: absolute;
    left: 0;
    top: 30px;
    background: var(--accent);
  }
  .seg__stages--him {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    padding-top: 0;
  }
  .seg__stages--him::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    height: 1px;
    background: var(--accent);
    transform-origin: left;
  }
  .js-motion .seg__stages--him::before {
    transform: scaleX(0);
    transition: transform 1200ms var(--ease-inout) 150ms;
  }
  .js-motion .seg__stages--him.is-in::before {
    transform: none;
  }
  .seg__stages--him li {
    position: relative;
  }
  .seg__stages--him .seg__dot {
    margin-bottom: 20px;
  }
  .seg__cta h2 {
    margin: 0 0 22px;
  }
  @media (max-width: 899px) {
    .seg--him .seg__hero-inner {
      align-items: flex-start;
      text-align: left;
    }
    .seg--him .seg__hero-inner .eyebrow {
      flex-direction: row;
    }
    .seg--him .seg__hero-inner .actions {
      justify-content: flex-start;
    }
    .seg__theme-list--her li {
      grid-template-columns: 1fr;
    }
    .seg__theme-list--him {
      grid-template-columns: 1fr;
    }
    .seg__theme-list--him li:nth-child(n) {
      margin-top: 0;
    }
    .seg__stages--her {
      grid-template-columns: 1fr;
    }
    .seg__stages--him {
      grid-template-columns: 1fr;
      gap: 0;
      padding-left: 30px;
    }
    .seg__stages--him::before {
      left: 5px;
      right: auto;
      top: 8px;
      bottom: 30px;
      width: 1px;
      height: auto;
      transform-origin: top;
    }
    .js-motion .seg__stages--him::before {
      transform: scaleY(0);
    }
    .seg__stages--him li {
      padding-bottom: 22px;
    }
    .seg__stages--him .seg__dot {
      position: absolute;
      left: -30px;
      top: 6px;
      margin: 0;
    }
  }
</style>
