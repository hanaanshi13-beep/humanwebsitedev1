---
// Code-drawn abstract "material": translucent ribbons, purely metaphorical (C01).
// Not a scan, not data. Decorative, hidden from assistive tech.
interface Props {
  tone?: 'amber' | 'garnet' | 'teal' | 'ivory';
  shape?: 'a' | 'b' | 'c' | 'd';
  class?: string;
  opacity?: number;
}
const { tone = 'amber', shape = 'a', class: cls = '', opacity = 1 } = Astro.props;
const id = `m-${tone}-${shape}-${Math.random().toString(36).slice(2, 7)}`;
const tones = {
  amber: ['#e8a523', '#f6dfae', '#8a5f0a'],
  garnet: ['#c06a8a', '#f0c9d6', '#54263b'],
  teal: ['#4fa39c', '#c9ebe6', '#164846'],
  ivory: ['#b8b09c', '#ffffff', '#8c8573'],
}[tone];
const shapes: Record<string, string[]> = {
  a: [
    'M620 -40 C 420 160, 900 300, 700 520 S 520 820, 860 960',
    'M700 -60 C 560 180, 1010 320, 800 540 S 640 800, 980 980',
    'M540 -20 C 360 200, 820 340, 610 560 S 420 840, 760 1000',
  ],
  b: [
    'M-40 620 C 220 420, 420 860, 700 600 S 980 380, 1060 520',
    'M-60 700 C 240 520, 420 940, 720 690 S 960 470, 1080 620',
    'M-40 540 C 200 330, 440 780, 690 520 S 990 300, 1060 430',
  ],
  c: [
    'M180 -40 C 520 180, 80 420, 420 620 S 860 760, 620 1040',
    'M260 -60 C 600 200, 180 430, 500 640 S 930 790, 720 1060',
    'M100 -30 C 430 170, -10 420, 340 610 S 780 740, 520 1030',
  ],
  d: [
    'M-40 260 C 260 80, 520 420, 760 240 S 980 60, 1060 200',
    'M-40 360 C 280 190, 520 520, 780 340 S 990 170, 1060 300',
    'M-60 460 C 300 300, 520 620, 800 440 S 1000 280, 1080 400',
  ],
};
const paths = shapes[shape];
---

<svg
  class={`material ${cls}`}
  viewBox="0 0 1000 1000"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  style={`opacity:${opacity}`}
>
  <defs>
    <linearGradient id={`${id}-g1`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={tones[1]} stop-opacity="0"></stop>
      <stop offset="0.45" stop-color={tones[0]} stop-opacity="0.55"></stop>
      <stop offset="1" stop-color={tones[2]} stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id={`${id}-g2`} x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color={tones[0]} stop-opacity="0"></stop>
      <stop offset="0.5" stop-color={tones[1]} stop-opacity="0.8"></stop>
      <stop offset="1" stop-color={tones[0]} stop-opacity="0"></stop>
    </linearGradient>
    <filter id={`${id}-soft`} filterUnits="userSpaceOnUse" x="-400" y="-400" width="1800" height="1800">
      <feGaussianBlur stdDeviation="26"></feGaussianBlur>
    </filter>
    <filter id={`${id}-mid`} filterUnits="userSpaceOnUse" x="-400" y="-400" width="1800" height="1800">
      <feGaussianBlur stdDeviation="7"></feGaussianBlur>
    </filter>
  </defs>
  <g fill="none" stroke-linecap="round">
    <path d={paths[0]} stroke={`url(#${id}-g1)`} stroke-width="150" filter={`url(#${id}-soft)`} opacity="0.5"></path>
    <path d={paths[1]} stroke={`url(#${id}-g1)`} stroke-width="70" filter={`url(#${id}-mid)`} opacity="0.45"></path>
    <path d={paths[0]} stroke={`url(#${id}-g2)`} stroke-width="1.2" opacity="0.9"></path>
    <path d={paths[1]} stroke={`url(#${id}-g2)`} stroke-width="0.8" opacity="0.7"></path>
    <path d={paths[2]} stroke={`url(#${id}-g2)`} stroke-width="0.6" opacity="0.5"></path>
  </g>
</svg>
