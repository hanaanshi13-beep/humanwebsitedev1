---
// Scene 02 — YOU KNOW THE PROGRESS YOU CAN SEE. Three concepts drawn as line art. No numbers, no dashboard.
import Slot from '../Slot.astro';
const frames = [
  {
    key: 'movement',
    label: 'Movement',
    text: 'You know how much you can lift. How far you can run.',
    // a rising stride
    path: 'M10 150 C 60 150, 70 110, 110 110 S 160 70, 200 70 S 250 30, 290 30',
  },
  {
    key: 'rest',
    label: 'Rest',
    text: 'Whether you’ve been sleeping better.',
    // a slow, even wave
    path: 'M10 100 C 45 40, 80 40, 115 100 S 185 160, 220 100 S 265 60, 290 80',
  },
  {
    key: 'routine',
    label: 'Routine',
    text: 'You can see the changes. You know when something is working.',
    // steady, repeating marks
    path: 'M10 120 H 50 V 90 H 90 V 120 H 130 V 90 H 170 V 120 H 210 V 90 H 250 V 120 H 290',
  },
];
---

<section class="on-light on-ivory s2" id="scene-02" aria-labelledby="s2-title">
  <div class="wrap">
    <div class="s2__head">
      <p class="eyebrow" data-reveal><span class="num">02</span><span>What you can see</span></p>
      <h2 class="display" id="s2-title" data-reveal="mask">
        <span class="mask"><span>You know the progress</span></span>
        <span class="mask" style="--i:1"><span><em>you can see.</em></span></span>
      </h2>
    </div>

    <div class="s2__grid">
      <div class="s2__photo" data-reveal="clip">
        <Slot name="progress-stride" ratio="4 / 5" tone="amber" shape="a" position="50% 30%" sizes="(max-width: 899px) 100vw, 36vw" />
      </div>

      <div class="s2__measures" data-progress>
        <span class="s2__trace" aria-hidden="true"><span></span></span>
        <ul class="s2__frames">
          {
            frames.map((f, i) => (
              <li class="s2__frame" data-reveal style={`--d:${i * 110}ms;--i:${i}`}>
                <span class="s2__mark" aria-hidden="true" />
                <div>
                  <h3>{f.label}</h3>
                  <p>{f.text}</p>
                </div>
                <svg viewBox="0 0 300 180" aria-hidden="true" focusable="false">
                  <path d={f.path} pathLength="1" />
                </svg>
              </li>
            ))
          }
        </ul>
        <p class="note s2__note" data-reveal="fade">Line drawings are illustrative. They are not measurements.</p>
      </div>
    </div>

    <p class="s2__turn" data-reveal>
      <span class="s2__turn-rule" aria-hidden="true"></span>
      But there’s <em>another side</em> to your health.
    </p>
  </div>
  <!-- visible information thins out and the page darkens into the side you can't see -->
  <div class="s2__dusk" aria-hidden="true"></div>
</section>

<style>
  .s2 {
    position: relative;
    padding-top: clamp(72px, 9.5vw, 144px);
  }
  .s2__head h2 {
    margin: 22px 0 0;
  }
  .s2__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(20px, 3vw, 48px);
    row-gap: 40px;
    align-items: center;
    margin-top: clamp(40px, 5vw, 72px);
  }
  .s2__photo {
    grid-column: 1 / span 5;
  }
  .s2__measures {
    grid-column: 7 / span 6;
    position: relative;
    padding-left: 34px;
    --p: 1;
  }
  /* one line traces down the three measures as the reader advances */
  .s2__trace {
    position: absolute;
    left: 6px;
    top: 10px;
    bottom: 56px;
    width: 1px;
    background: var(--rule);
  }
  .s2__trace span {
    position: absolute;
    inset: 0;
    background: var(--text);
    transform-origin: top;
    transform: scaleY(var(--p));
  }
  .s2__frame {
    position: relative;
    display: grid;
    grid-template-columns: 1fr clamp(110px, 14vw, 190px);
    gap: 20px;
    align-items: center;
    padding: clamp(18px, 2.2vw, 30px) 0;
    border-bottom: 1px solid var(--rule);
  }
  .s2__mark {
    position: absolute;
    left: -34px;
    top: calc(clamp(18px, 2.2vw, 30px) + 2px);
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1px solid var(--text);
    background: color-mix(in srgb, var(--text) calc(clamp(0, (var(--p) - var(--i) * 0.3) * 6, 1) * 100%), var(--ivory));
  }
  .s2__frame svg {
    width: 100%;
    height: auto;
  }
  .s2__frame path {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  :global(.js-motion) .s2__frame path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1300ms var(--ease-inout) calc(var(--d, 0ms) + 200ms);
  }
  :global(.js-motion) .s2__frame.is-in path {
    stroke-dashoffset: 0;
  }
  .s2__frame h3 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.9rem, 3.2vw, 3rem);
    line-height: 1;
    margin-bottom: 8px;
  }
  .s2__frame p {
    line-height: 1.45;
    max-width: 20em;
    color: var(--muted);
  }
  .s2__note {
    margin-top: 18px;
  }
  .s2__turn {
    margin-top: clamp(64px, 8vw, 120px);
    font-size: clamp(1.9rem, 4.6vw, 4.2rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 15em;
    margin-left: auto;
    text-wrap: balance;
  }
  .s2__turn em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.08em;
  }
  .s2__turn-rule {
    display: block;
    width: 64px;
    height: 1px;
    background: var(--accent);
    margin-bottom: 26px;
  }
  .s2__dusk {
    height: clamp(120px, 16vw, 220px);
    margin-top: clamp(40px, 5vw, 72px);
    background: linear-gradient(180deg, var(--ivory) 0%, #8d897f 45%, #2a2b2b 78%, var(--carbon) 100%);
  }
  @media (max-width: 899px) {
    .s2__photo,
    .s2__measures {
      grid-column: 1 / -1;
    }
    .s2__photo {
      max-width: 460px;
    }
    .s2__frame {
      grid-template-columns: minmax(0, 1fr) min(96px, 22vw);
    }
    .s2__frame h3 {
      font-size: min(9vw, 2.2rem);
    }
  }
</style>
