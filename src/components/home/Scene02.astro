---
// Scene 02 — YOU KNOW THE PROGRESS YOU CAN SEE. Three concepts drawn as line art. No numbers, no dashboard.
import Slot from '../Slot.astro';
const frames = [
  {
    key: 'movement',
    label: 'Movement',
    text: 'You know how much you can lift. How far you can run.',
    // a rising stride
    path: 'M10 150 C 60 150, 70 110, 110 110 S 160 70, 200 70 S 250 30, 290 30',
  },
  {
    key: 'rest',
    label: 'Rest',
    text: 'Whether you’ve been sleeping better.',
    // a slow, even wave
    path: 'M10 100 C 45 40, 80 40, 115 100 S 185 160, 220 100 S 265 60, 290 80',
  },
  {
    key: 'routine',
    label: 'Routine',
    text: 'You can see the changes. You know when something is working.',
    // steady, repeating marks
    path: 'M10 120 H 50 V 90 H 90 V 120 H 130 V 90 H 170 V 120 H 210 V 90 H 250 V 120 H 290',
  },
];
---

<section class="section on-light on-ivory s2" id="scene-02" aria-labelledby="s2-title">
  <div class="wrap">
    <div class="s2__grid">
      <div class="s2__head">
        <p class="eyebrow" data-reveal><span class="num">02</span><span>What you can see</span></p>
        <h2 class="display" id="s2-title" data-reveal="mask">
          <span class="mask"><span>You know the progress</span></span>
          <span class="mask" style="--i:1"><span><em>you can see.</em></span></span>
        </h2>
      </div>

      <div class="s2__photo" data-reveal="clip">
        <Slot name="progress-stride" ratio="4 / 5" tone="amber" shape="a" position="50% 30%" sizes="(max-width: 899px) 100vw, 36vw" />
      </div>

      <div class="s2__measures">
        <ul class="s2__frames">
          {
            frames.map((f, i) => (
              <li class="s2__frame" data-reveal style={`--d:${i * 90}ms`}>
                <span class="s2__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{f.label}</h3>
                  <p>{f.text}</p>
                </div>
                <svg viewBox="0 0 300 180" aria-hidden="true" focusable="false">
                  <path d={f.path} pathLength="1" />
                </svg>
              </li>
            ))
          }
        </ul>
        <p class="note s2__note" data-reveal="fade">Line drawings are illustrative. They are not measurements.</p>
      </div>
    </div>

    <p class="s2__turn" data-reveal>
      <span class="s2__turn-rule" aria-hidden="true"></span>
      But there’s <em>another side</em> to your health.
    </p>
  </div>
</section>

<style>
  /* Desktop: the photograph holds the left; heading and the three measures stack on the right. */
  .s2__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-areas:
      'photo photo photo photo photo . head head head head head head'
      'photo photo photo photo photo . list list list list list list';
    grid-template-rows: auto 1fr;
    column-gap: var(--col-gap);
    row-gap: clamp(32px, 4vw, 56px);
    align-items: start;
  }
  .s2__head {
    grid-area: head;
  }
  .s2__head h2 {
    margin: var(--stack-label) 0 0;
    font-size: clamp(2.25rem, 4.1vw, 4rem);
  }
  .s2__photo {
    grid-area: photo;
    align-self: stretch;
  }
  .s2__photo :global(.slot) {
    height: 100%;
    min-height: 100%;
  }
  .s2__measures {
    grid-area: list;
    align-self: end;
  }
  .s2__frames {
    border-top: 1px solid var(--rule);
  }
  .s2__frame {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) clamp(96px, 11vw, 150px);
    gap: 16px;
    align-items: center;
    padding: clamp(18px, 2vw, 26px) 0;
    border-bottom: 1px solid var(--rule);
  }
  .s2__n {
    align-self: start;
    padding-top: 0.7em;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .s2__frame svg {
    width: 100%;
    height: auto;
    opacity: 0.7;
  }
  .s2__frame path {
    fill: none;
    stroke: var(--text);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .s2__frame h3 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: var(--fs-h3);
    line-height: 1.05;
    margin-bottom: 6px;
  }
  .s2__frame p {
    line-height: 1.5;
    max-width: 24em;
    color: var(--muted);
  }
  .s2__note {
    margin-top: 16px;
  }
  .s2__turn {
    margin-top: clamp(72px, 9vw, 136px);
    font-size: clamp(1.75rem, 3.8vw, 3.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 14em;
    margin-left: auto;
    text-wrap: balance;
  }
  .s2__turn em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.08em;
  }
  .s2__turn-rule {
    display: block;
    width: 48px;
    height: 1px;
    background: var(--accent);
    margin-bottom: 24px;
  }
  @media (max-width: 899px) {
    .s2__grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'head' 'photo' 'list';
      grid-template-rows: auto;
    }
    .s2__photo {
      max-width: 460px;
    }
    .s2__photo :global(.slot) {
      height: auto;
    }
    .s2__frame {
      grid-template-columns: 1.75rem minmax(0, 1fr) min(84px, 20vw);
      gap: 12px;
    }
    .s2__turn {
      margin-left: 0;
    }
  }
</style>
