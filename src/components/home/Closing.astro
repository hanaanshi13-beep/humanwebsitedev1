---
// Scene 07, Scene 08, Her/Him portals, app prototype slot, final invitation.
// Photographs load by filename through <Slot>; until they exist each frame shows abstract artwork.
import Material from '../Material.astro';
import Slot from '../Slot.astro';
const differs = ['Your age', 'Your lifestyle', 'Your health history', 'Your priorities', 'Your life stage'];
---

<!-- Scene 07 -->
<section class="section on-light s7" id="scene-07" aria-labelledby="s7-title" data-progress>
  <div class="wrap s7__grid">
    <div class="s7__copy">
      <p class="eyebrow" data-reveal><span class="num">07</span><span>No two people</span></p>
      <h2 class="display" id="s7-title" data-reveal="mask">
        <span class="mask"><span>Your health.</span></span>
        <span class="mask" style="--i:1"><span>Your body.</span></span>
        <span class="mask" style="--i:2"><span><em>Your journey.</em></span></span>
      </h2>
      <div class="prose" data-reveal style="--d:120ms">
        <p>What deserves attention for one person may differ for another.</p>
      </div>
      <ul class="s7__list" aria-label="What makes your health yours" data-reveal style="--d:200ms">
        {differs.map((d) => <li>{d}</li>)}
        <li class="s7__matters">all matter.</li>
      </ul>
      <p class="s7__built" data-reveal style="--d:260ms"><strong>HUMAN is being built around that idea.</strong></p>
    </div>

    <div class="s7__mosaic">
      <div class="s7__f s7__f--a" data-reveal="clip">
        <Slot name="journey-elder" ratio="4 / 5" tone="ivory" shape="c" position="50% 30%" sizes="(max-width: 899px) 100vw, 26vw" />
      </div>
      <div class="s7__f s7__f--b" data-reveal="clip" style="--d:140ms">
        <Slot name="journey-parent" ratio="3 / 2" tone="amber" shape="d" position="50% 30%" sizes="(max-width: 899px) 100vw, 30vw" />
      </div>
      <div class="s7__f s7__f--c" data-reveal="clip" style="--d:260ms">
        <Slot name="journey-professional" ratio="4 / 5" tone="ivory" shape="b" position="60% 25%" sizes="(max-width: 899px) 60vw, 20vw" />
      </div>
      <p class="note s7__note">Images, where shown, are of models. They are not HUMAN members.</p>
    </div>
  </div>
</section>

<!-- Scene 08 -->
<section class="on-dark s8" id="scene-08" aria-labelledby="s8-title" data-progress>
  <Material tone="amber" shape="d" opacity={0.4} class="s8__mat" />
  <span class="s8__aperture" aria-hidden="true"></span>
  <div class="wrap s8__inner">
    <p class="eyebrow no-rule s8__eyebrow" data-reveal><span class="num">08</span><span id="s8-title" role="heading" aria-level="2">The story continues</span></p>
    <div class="s8__lines">
      <p data-reveal>You don’t have to wait until something feels wrong <em>to start understanding your health.</em></p>
      <p data-reveal style="--d:140ms">And you don’t have to figure everything out <em>alone.</em></p>
    </div>
    <p class="s8__bridge" data-reveal style="--d:240ms">There’s more to your health than what you can see.</p>
    <span class="s8__rule" aria-hidden="true"></span>
    <p class="s8__mark" data-reveal="fade" style="--d:320ms">There’s <span class="s8__human">HUMAN</span><span class="vh">.</span></p>
  </div>
</section>

<!-- Portals -->
<section class="portals on-dark" id="paths" aria-labelledby="portals-title">
  <div class="wrap portals__head">
    <h2 class="lede" id="portals-title" data-reveal>
      Different bodies. Different life stages. <em class="serif">A more thoughtful starting point.</em>
    </h2>
    <p class="note" data-reveal="fade">
      Two editorial paths into the same idea. They show what we intend to build — not live, personalised services.
    </p>
  </div>
  <div class="wrap portals__pair">
    <a class="portal portal--her" href="/women" data-reveal="clip">
      <Slot name="portal-her" ratio="auto" tone="garnet" shape="c" position="62% 28%" sizes="(max-width: 767px) 100vw, 50vw" class="portal__media" />
      <span class="portal__shade" aria-hidden="true"></span>
      <span class="portal__body">
        <span class="portal__eyebrow">HUMAN for Her</span>
        <span class="portal__title">For <em>Her</em></span>
        <span class="portal__sub">A more thoughtful way to understand your health, across life stages.</span>
        <span class="btn btn--ghost portal__go">Explore <span class="arr" aria-hidden="true">→</span></span>
      </span>
    </a>
    <a class="portal portal--him" href="/men" data-reveal="clip" style="--d:120ms">
      <Slot name="portal-him" ratio="auto" tone="teal" shape="a" position="42% 12%" sizes="(max-width: 767px) 100vw, 50vw" class="portal__media" />
      <span class="portal__shade" aria-hidden="true"></span>
      <span class="portal__body">
        <span class="portal__eyebrow">HUMAN for Him</span>
        <span class="portal__title">For <em>Him</em></span>
        <span class="portal__sub">Go beyond what you can see — without waiting for something to feel wrong.</span>
        <span class="btn btn--ghost portal__go">Explore <span class="arr" aria-hidden="true">→</span></span>
      </span>
    </a>
  </div>
</section>

<!-- App prototype slot: honest placeholder until the real folder is audited (Part H). No invented screens. -->
<section class="section on-light app" id="app" aria-labelledby="app-title">
  <div class="wrap split">
    <div class="a">
      <p class="eyebrow" data-reveal><span>The HUMAN experience</span></p>
      <h2 class="display" id="app-title" data-reveal="mask">
        <span class="mask"><span>A look at what</span></span>
        <span class="mask" style="--i:1"><span><em>we’re building.</em></span></span>
      </h2>
      <div class="prose" data-reveal style="--d:120ms">
        <p>
          We’re prototyping an app to carry the connected journey. We’ll show real screens from that prototype here
          once they’re ready to share — not mock-ups made for a website.
        </p>
      </div>
      <div class="actions" data-reveal="fade">
        <a class="btn btn--dark" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="b">
      <div class="app__slot" data-reveal role="img" aria-label="Empty frame. The app prototype preview has not been published yet.">
        <span class="status-pill">Prototype preview — coming soon</span>
        <p>No screens are shown yet. Nothing here can be used or purchased today.</p>
      </div>
    </div>
  </div>
</section>

<!-- Final invitation -->
<section class="on-dark cta-band final" id="join" aria-labelledby="join-title">
  <Material tone="amber" shape="b" opacity={0.5} />
  <span class="final__horizon" aria-hidden="true"></span>
  <div class="wrap final__inner">
    <p class="final__statement" data-reveal>
      Health isn’t a single test or a single visit. It’s something you come to understand <em>over time</em> — with
      context, with qualified people, and at your own pace.
    </p>
    <h2 class="display final__title" id="join-title" data-reveal="mask">
      <span class="mask"><span>Be part of what</span></span>
      <span class="mask" style="--i:1"><span><em>we’re building.</em></span></span>
    </h2>
    <div class="final__tray" data-reveal style="--d:160ms">
      <div class="final__tray-copy">
        <span class="status-pill">In development</span>
        <p>Register your interest and, if you opt in, hear about HUMAN as it develops.</p>
      </div>
      <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <p class="note final__note" data-reveal="fade" style="--d:240ms">
      Open to people across India. First pilot planned for Delhi NCR. Joining registers interest only — it does not
      reserve a place or start any service.
    </p>
  </div>
</section>

<style>
  /* ---- Scene 07 ---- */
  .s7 {
    --p: 0.5;
  }
  .s7__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(20px, 3vw, 48px);
    row-gap: 48px;
    align-items: center;
  }
  .s7__copy {
    grid-column: 1 / span 5;
  }
  .s7__copy h2 {
    margin: 22px 0 28px;
  }
  .s7__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-top: 30px;
    max-width: 30em;
  }
  .s7__list li {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.2;
  }
  .s7__list li:not(.s7__matters)::after {
    content: '·';
    margin-left: 10px;
    color: var(--accent);
    font-style: normal;
  }
  .s7__matters {
    flex-basis: 100%;
    margin-top: 6px;
    font-family: var(--sans) !important;
    font-style: normal !important;
    font-weight: 700;
    font-size: clamp(1.35rem, 2vw, 1.8rem) !important;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .s7__built {
    margin-top: 26px;
  }
  /* asymmetric editorial mosaic: three frames at three depths */
  .s7__mosaic {
    grid-column: 7 / span 6;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    column-gap: clamp(12px, 1.6vw, 24px);
    row-gap: clamp(12px, 1.6vw, 24px);
    align-items: start;
  }
  .s7__f--a {
    grid-column: 1 / span 3;
    grid-row: 1 / span 2;
    margin-top: clamp(40px, 6vw, 96px);
  }
  .s7__f--b {
    grid-column: 4 / span 3;
    grid-row: 1;
  }
  .s7__f--c {
    grid-column: 4 / span 2;
    grid-row: 2;
  }
  :global(.js-motion) .s7__f--a {
    translate: 0 calc((0.5 - var(--p)) * 28px);
  }
  :global(.js-motion) .s7__f--c {
    translate: 0 calc((var(--p) - 0.5) * 24px);
  }
  .s7__note {
    grid-column: 1 / -1;
  }
  @media (max-width: 899px) {
    .s7__copy,
    .s7__mosaic {
      grid-column: 1 / -1;
    }
    .s7__f--a {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: 0;
    }
    .s7__f--b {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .s7__f--c {
      grid-column: 3 / span 4;
      grid-row: auto;
    }
    :global(.js-motion) .s7__f--a,
    :global(.js-motion) .s7__f--c {
      translate: none;
    }
  }

  /* ---- Scene 08: the aperture closes to a line, and the line becomes the name ---- */
  .s8 {
    --p: 1;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(96px, 13vw, 190px) clamp(80px, 10vw, 150px);
    text-align: center;
    background:
      radial-gradient(60% 50% at 50% 46%, rgba(232, 165, 35, 0.07), transparent 70%),
      var(--carbon);
  }
  .s8 :global(.s8__mat) {
    opacity: calc(0.55 - var(--p) * 0.4) !important;
  }
  .s8__aperture {
    position: absolute;
    left: 50%;
    top: 46%;
    width: min(92vw, 900px);
    aspect-ratio: 1.5;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-bottom-color: rgba(232, 165, 35, 0.55);
    box-shadow:
      inset 0 14px 40px -22px rgba(255, 255, 255, 0.22),
      inset 0 -18px 44px -24px rgba(232, 165, 35, 0.35);
    transform: translate(-50%, -50%) scale(calc(1.3 - var(--p) * 0.45), calc(1.3 - var(--p) * 0.62));
    opacity: calc(0.25 + var(--p) * 0.5);
    pointer-events: none;
  }
  .s8__inner {
    position: relative;
    z-index: var(--z-content);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .s8__eyebrow {
    justify-content: center;
  }
  .s8__lines {
    display: grid;
    gap: 0.5em;
    max-width: 22em;
    margin-top: 34px;
    font-size: clamp(1.5rem, 3vw, 2.7rem);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .s8__lines em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.1em;
    letter-spacing: -0.01em;
  }
  .s8__bridge {
    margin-top: 34px;
    color: var(--muted);
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
  }
  .s8__rule {
    width: min(60vw, 420px);
    height: 1px;
    margin: clamp(40px, 5vw, 72px) 0 clamp(28px, 3vw, 44px);
    background: linear-gradient(90deg, transparent, var(--amber) 30%, var(--amber) 70%, transparent);
    transform: scaleX(clamp(0, (var(--p) - 0.35) * 2.2, 1));
  }
  .s8__mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-style: italic;
    font-size: min(8vw, clamp(1.5rem, 2.4vw, 2.1rem));
    line-height: 1;
  }
  .s8__human {
    font-family: var(--sans);
    font-style: normal;
    font-weight: 600;
    font-size: min(13vw, clamp(2.6rem, 8vw, 6.6rem));
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    line-height: 1.05;
  }
  /* the dark resolves into two colours: the portals' worlds, before they arrive */
  .s8::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 46%;
    z-index: 0;
    background:
      radial-gradient(60% 100% at 22% 100%, rgba(84, 38, 59, 0.55), transparent 70%),
      radial-gradient(60% 100% at 78% 100%, rgba(22, 72, 70, 0.55), transparent 70%);
    opacity: var(--p);
    pointer-events: none;
  }

  /* ---- Portals ---- */
  .portals {
    position: relative;
    padding-block: clamp(40px, 5vw, 72px) clamp(72px, 9vw, 128px);
    background: linear-gradient(90deg, #170b10 0%, var(--carbon) 50%, #07191a 100%);
  }
  .portals__head {
    display: grid;
    gap: 14px;
    justify-items: center;
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .portals__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 1.6vw, 24px);
  }
  .portal {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(82svh, 780px);
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-panel);
    color: var(--text-on-dark);
    text-decoration: none;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
      0 30px 70px -30px rgba(0, 0, 0, 0.7);
  }
  .portal :global(.portal__media) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    z-index: -2;
    transition: transform 900ms var(--ease-human);
  }
  /* readability comes from this shade, never from blurring the photograph */
  .portal__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: opacity 420ms var(--ease-human);
  }
  .portal--her .portal__shade {
    background:
      linear-gradient(0deg, rgba(26, 10, 17, 0.94) 0%, rgba(26, 10, 17, 0.5) 34%, rgba(26, 10, 17, 0) 62%),
      linear-gradient(90deg, rgba(26, 10, 17, 0.5) 0%, rgba(26, 10, 17, 0) 46%);
  }
  .portal--him .portal__shade {
    background:
      linear-gradient(0deg, rgba(6, 22, 23, 0.94) 0%, rgba(6, 22, 23, 0.5) 34%, rgba(6, 22, 23, 0) 62%),
      linear-gradient(270deg, rgba(6, 22, 23, 0.5) 0%, rgba(6, 22, 23, 0) 46%);
  }
  /* a thin light edge that shifts on hover / focus */
  .portal::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22);
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.1), transparent 22%);
    opacity: 0.5;
    transition: opacity 420ms var(--ease-human);
  }
  .portal__body {
    display: grid;
    justify-items: start;
    gap: 12px;
    width: 100%;
    padding: clamp(24px, 3.2vw, 52px);
  }
  .portal--him .portal__body {
    justify-items: end;
    text-align: right;
  }
  .portal__eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .portal--her .portal__eyebrow {
    color: #f0c9d6;
  }
  .portal--him .portal__eyebrow {
    color: #c9ebe6;
  }
  .portal__title {
    font-size: clamp(3.2rem, 7.4vw, 7.4rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .portal__title em {
    font-family: var(--serif);
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: 1.12em;
  }
  .portal__sub {
    max-width: 22em;
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    line-height: 1.45;
  }
  .portal__go {
    margin-top: 12px;
  }
  .portal--her .portal__go {
    --btn-edge: rgba(255, 206, 224, 0.4);
    --btn-caustic: rgba(214, 110, 150, 0.4);
  }
  .portal--him .portal__go {
    --btn-edge: rgba(196, 244, 238, 0.38);
    --btn-caustic: rgba(86, 190, 182, 0.4);
  }
  .portal:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-panel);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .portal:hover :global(.portal__media),
    .portal:focus-visible :global(.portal__media) {
      transform: scale(1.018);
    }
  }
  .portal:hover::after,
  .portal:focus-visible::after {
    opacity: 1;
  }
  .portal:hover .portal__go,
  .portal:focus-visible .portal__go {
    --btn-edge: rgba(255, 255, 255, 0.5);
  }
  .portal:hover .portal__go .arr::before,
  .portal:focus-visible .portal__go .arr::before {
    transform: translateX(3px);
  }
  @media (max-width: 767px) {
    .portals {
      background: var(--carbon);
    }
    .portals__pair {
      grid-template-columns: 1fr;
    }
    .portal {
      min-height: min(74svh, 560px);
    }
    .portal--him .portal__body {
      justify-items: start;
      text-align: left;
    }
    .portal--him .portal__shade {
      background:
        linear-gradient(0deg, rgba(6, 22, 23, 0.94) 0%, rgba(6, 22, 23, 0.5) 40%, rgba(6, 22, 23, 0) 70%);
    }
  }

  /* ---- App slot ---- */
  .app h2 {
    margin: 22px 0 30px;
  }
  .app__slot {
    aspect-ratio: 4 / 3;
    border: 1px dashed rgba(20, 25, 28, 0.4);
    border-radius: var(--radius-panel);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 14px;
    padding: clamp(20px, 3vw, 40px);
    background: repeating-linear-gradient(135deg, transparent 0 14px, rgba(20, 25, 28, 0.035) 14px 15px);
  }
  .app__slot p {
    max-width: 24em;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  /* ---- Final: the end act. A horizon of light, one statement, one action. ---- */
  .final {
    padding-block: clamp(96px, 12vw, 180px) clamp(88px, 10vw, 150px);
    text-align: center;
    background: #08090b;
  }
  .final__horizon {
    position: absolute;
    left: 50%;
    bottom: -62%;
    width: 160vw;
    max-width: 2400px;
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    border-radius: 50%;
    border-top: 1px solid rgba(255, 228, 176, 0.4);
    background: radial-gradient(60% 60% at 50% 0%, rgba(232, 165, 35, 0.2), rgba(232, 165, 35, 0.03) 46%, transparent 70%);
    box-shadow: 0 -30px 120px -30px rgba(232, 165, 35, 0.22);
    pointer-events: none;
  }
  .final__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .final__statement {
    max-width: 30em;
    font-size: clamp(1.125rem, 1.6vw, 1.4rem);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: balance;
  }
  .final__statement em {
    font-family: var(--serif);
    font-size: 1.12em;
    color: var(--text-on-dark);
  }
  .final .final__title {
    max-width: none;
    margin: clamp(36px, 4.6vw, 64px) 0 clamp(32px, 4vw, 52px);
    font-size: clamp(2.5rem, 7vw, 6.4rem);
  }
  /* one glass tray groups the status, the promise and the single action */
  .final__tray {
    display: flex;
    align-items: center;
    gap: 18px 28px;
    max-width: 100%;
    padding: 12px 12px 12px 26px;
    border-radius: 999px;
    border: 1px solid var(--glass-dark-edge);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 24px 60px rgba(0, 0, 0, 0.45);
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturation));
    text-align: left;
  }
  .final__tray-copy {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .final__tray-copy p {
    max-width: 24em;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .final__tray .btn {
    flex: none;
    min-height: 56px;
    padding-inline: 30px;
  }
  .final__note {
    max-width: 44em;
    margin-top: 26px;
  }
