---
// Scene 07, Scene 08, Her/Him portals, app prototype slot, final invitation.
// Photographs load by filename through <Slot>; until they exist each frame shows abstract artwork.
import Slot from '../Slot.astro';
import { STAGES } from '../../data/site';
// Six points on a circle, starting at the top and running clockwise, for the planned-journey schematic.
const ring = STAGES.map((st, i) => {
  const a = (i / STAGES.length) * Math.PI * 2 - Math.PI / 2;
  return { name: st.name, n: String(i + 1).padStart(2, '0'), x: 50 + Math.cos(a) * 50, y: 50 + Math.sin(a) * 50, side: Math.cos(a) > 0.2 ? 'r' : Math.cos(a) < -0.2 ? 'l' : Math.sin(a) < 0 ? 't' : 'b' };
});
const differs = ['Your age', 'Your lifestyle', 'Your health history', 'Your priorities', 'Your life stage'];
---

<!-- Scene 07 -->
<section class="section on-light s7" id="scene-07" aria-labelledby="s7-title">
  <div class="wrap s7__grid">
    <div class="s7__copy">
      <p class="eyebrow" data-reveal><span class="num">07</span><span>No two people</span></p>
      <h2 class="display" id="s7-title" data-reveal="mask">
        <span class="mask"><span>Your health.</span></span>
        <span class="mask" style="--i:1"><span>Your body.</span></span>
        <span class="mask" style="--i:2"><span><em>Your journey.</em></span></span>
      </h2>
      <div class="prose" data-reveal style="--d:120ms">
        <p>What deserves attention for one person may differ for another.</p>
      </div>
      <ul class="s7__list" aria-label="What makes your health yours" data-reveal style="--d:200ms">
        {differs.map((d) => <li>{d}</li>)}
        <li class="s7__matters">all matter.</li>
      </ul>
      <p class="s7__built" data-reveal style="--d:260ms"><strong>HUMAN is being built around that idea.</strong></p>
    </div>

    <div class="s7__mosaic">
      <div class="s7__f s7__f--a" data-reveal="clip">
        <Slot name="journey-elder" ratio="4 / 5" tone="ivory" shape="c" position="50% 30%" sizes="(max-width: 899px) 100vw, 26vw" />
      </div>
      <div class="s7__f s7__f--b" data-reveal="clip" style="--d:140ms">
        <Slot name="journey-parent" ratio="3 / 2" tone="amber" shape="d" position="50% 30%" sizes="(max-width: 899px) 100vw, 30vw" />
      </div>
      <div class="s7__f s7__f--c" data-reveal="clip" style="--d:260ms">
        <Slot name="journey-professional" ratio="4 / 5" tone="ivory" shape="b" position="60% 25%" sizes="(max-width: 899px) 60vw, 20vw" />
      </div>
      <p class="note s7__note">Images, where shown, are of models. They are not HUMAN members.</p>
    </div>
  </div>
</section>

<!-- Scene 08 -->
<section class="on-dark s8" id="scene-08" aria-labelledby="s8-title">
  <div class="wrap s8__inner">
    <p class="eyebrow no-rule s8__eyebrow" data-reveal><span class="num">08</span><span id="s8-title" role="heading" aria-level="2">The story continues</span></p>
    <div class="s8__lines">
      <p data-reveal>You don’t have to wait until something feels wrong <em>to start understanding your health.</em></p>
      <p data-reveal style="--d:120ms">And you don’t have to figure everything out <em>alone.</em></p>
    </div>
    <p class="s8__bridge" data-reveal style="--d:200ms">There’s more to your health than what you can see.</p>
    <span class="s8__rule" aria-hidden="true" data-reveal="rule" style="--d:260ms"></span>
    <p class="s8__mark" data-reveal="fade" style="--d:420ms">There’s <span class="s8__human">HUMAN</span><span class="vh">.</span></p>
  </div>
</section>

<!-- Portals -->
<section class="portals on-dark" id="paths" aria-labelledby="portals-title">
  <div class="wrap portals__head">
    <h2 class="lede" id="portals-title" data-reveal>
      Different bodies. Different life stages. <em class="serif">A more thoughtful starting point.</em>
    </h2>
    <p class="note" data-reveal="fade">
      Two editorial paths into the same idea. They show what we intend to build — not live, personalised services.
    </p>
  </div>
  <div class="wrap portals__pair">
    <a class="portal portal--her" href="/women" data-reveal="clip">
      <Slot name="portal-her" ratio="auto" tone="garnet" shape="c" position="62% 28%" sizes="(max-width: 767px) 100vw, 50vw" class="portal__media" />
      <span class="portal__shade" aria-hidden="true"></span>
      <span class="portal__body">
        <span class="portal__eyebrow">HUMAN for Her</span>
        <span class="portal__title">For <em>Her</em></span>
        <span class="portal__sub">A more thoughtful way to understand your health, across life stages.</span>
        <span class="btn btn--ghost portal__go">Explore <span class="arr" aria-hidden="true">→</span></span>
      </span>
    </a>
    <a class="portal portal--him" href="/men" data-reveal="clip" style="--d:120ms">
      <Slot name="portal-him" ratio="auto" tone="teal" shape="a" position="42% 12%" sizes="(max-width: 767px) 100vw, 50vw" class="portal__media" />
      <span class="portal__shade" aria-hidden="true"></span>
      <span class="portal__body">
        <span class="portal__eyebrow">HUMAN for Him</span>
        <span class="portal__title">For <em>Him</em></span>
        <span class="portal__sub">Go beyond what you can see — without waiting for something to feel wrong.</span>
        <span class="btn btn--ghost portal__go">Explore <span class="arr" aria-hidden="true">→</span></span>
      </span>
    </a>
  </div>
</section>

<!-- The planned experience. An honest schematic of the journey the app is being prototyped to carry:
     stage names only. No screens, values, dashboards or records are shown or implied (Part H). -->
<section class="section on-light app" id="app" aria-labelledby="app-title">
  <div class="wrap split">
    <div class="a">
      <p class="eyebrow" data-reveal><span>The HUMAN experience</span></p>
      <h2 class="display" id="app-title" data-reveal="mask">
        <span class="mask"><span>A look at what</span></span>
        <span class="mask" style="--i:1"><span><em>we’re building.</em></span></span>
      </h2>
      <div class="prose" data-reveal style="--d:120ms">
        <p>
          We’re prototyping an app to carry the connected journey. We’ll show real screens from that prototype here
          once they’re ready to share — not mock-ups made for a website.
        </p>
      </div>
      <dl class="app__facts" data-reveal style="--d:180ms">
        <div><dt>Status</dt><dd>A prototype is in development.</dd></div>
        <div><dt>Screens</dt><dd>None are shown yet.</dd></div>
        <div><dt>Today</dt><dd>Nothing here can be used or purchased.</dd></div>
      </dl>
    </div>
    <div class="b">
      <figure class="app__plate" data-reveal="fade">
        <div class="app__ring" role="img" aria-label="Schematic of the planned journey: Test, Understand, Act, Track, Retest, Improve, arranged as one connected circle. It is a diagram, not a screen from the app.">
          <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <circle cx="50" cy="50" r="50" />
          </svg>
          {
            ring.map((r) => (
              <span class={`app__pt app__pt--${r.side}`} style={`left:${r.x.toFixed(2)}%;top:${r.y.toFixed(2)}%`} aria-hidden="true">
                <i />
                <span><b>{r.n}</b>{r.name}</span>
              </span>
            ))
          }
          <div class="app__core" aria-hidden="true">
            <span class="app__core-mark">HUMAN</span>
            <span class="status-pill">Prototype in development</span>
          </div>
        </div>
        <figcaption class="note">
          A schematic of the planned journey — not a screen from the app. No screens are shown yet.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- Final invitation -->
<section class="on-dark final" id="join" aria-labelledby="join-title">
  <div class="wrap final__grid">
    <div class="final__lead">
      <p class="final__statement" data-reveal>
        Health isn’t a single test or a single visit. It’s something you come to understand <em>over time</em> — with
        context, with qualified people, and at your own pace.
      </p>
      <h2 class="display final__title" id="join-title" data-reveal="mask">
        <span class="mask"><span>Be part of what</span></span>
        <span class="mask" style="--i:1"><span><em>we’re building.</em></span></span>
      </h2>
    </div>
    <div class="final__act" data-reveal style="--d:140ms">
      <span class="status-pill">In development</span>
      <p class="final__offer">Register your interest and, if you opt in, hear about HUMAN as it develops.</p>
      <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
      <p class="note final__note">
        Open to people across India. First pilot planned for Delhi NCR. Joining registers interest only — it does not
        reserve a place or start any service.
      </p>
    </div>
  </div>
</section>

<style>
  /* ---- Scene 07 ---- */
  .s7__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: center;
  }
  .s7__copy {
    grid-column: 1 / span 5;
  }
  .s7__copy h2 {
    margin: var(--stack-label) 0 var(--stack-head);
  }
  .s7__list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 28px;
    max-width: 30em;
  }
  .s7__list li {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.375rem, 1.9vw, 1.75rem);
    line-height: 1.25;
  }
  .s7__list li:not(.s7__matters)::after {
    content: '·';
    margin-left: 10px;
    color: var(--accent);
    font-style: normal;
  }
  .s7__list li:nth-last-child(2)::after {
    display: none;
  }
  .s7__list .s7__matters {
    flex-basis: 100%;
    margin-top: 8px;
    font-family: var(--sans);
    font-style: normal;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .s7__built {
    margin-top: 24px;
  }
  /* asymmetric editorial mosaic: one tall portrait, one landscape, one small portrait */
  .s7__mosaic {
    grid-column: 7 / span 6;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(12px, 1.6vw, 24px);
    align-items: start;
  }
  .s7__f--a {
    grid-column: 1 / span 3;
    grid-row: 1 / span 2;
    margin-top: clamp(40px, 6vw, 96px);
  }
  .s7__f--b {
    grid-column: 4 / span 3;
    grid-row: 1;
  }
  .s7__f--c {
    grid-column: 4 / span 2;
    grid-row: 2;
  }
  .s7__note {
    grid-column: 1 / -1;
    margin-top: 4px;
  }
  @media (max-width: 899px) {
    .s7__copy,
    .s7__mosaic {
      grid-column: 1 / -1;
    }
    .s7__f--a {
      grid-column: 1 / span 4;
      grid-row: 1;
      margin-top: 0;
    }
    .s7__f--b {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .s7__f--c {
      grid-column: 5 / span 2;
      grid-row: 1;
      align-self: end;
    }
  }

  /* ---- Scene 08: three quiet lines, one amber rule, the name ---- */
  .s8 {
    padding-block: clamp(88px, 11vw, 168px) clamp(72px, 9vw, 128px);
    text-align: center;
  }
  .s8__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .s8__eyebrow {
    justify-content: center;
  }
  .s8__lines {
    display: grid;
    gap: 0.55em;
    max-width: 21em;
    margin-top: 32px;
    font-size: clamp(1.5rem, 2.9vw, 2.625rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .s8__lines em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.1em;
    letter-spacing: -0.01em;
  }
  .s8__bridge {
    margin-top: 32px;
    color: var(--muted);
    font-size: var(--fs-lede);
  }
  .s8__rule {
    width: 48px;
    height: 1px;
    margin: clamp(40px, 5vw, 64px) 0 clamp(28px, 3vw, 40px);
    background: var(--amber);
  }
  :global(.js-motion) .s8__rule[data-reveal='rule'] {
    transform-origin: center;
  }
  .s8__mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-family: var(--serif);
    font-style: italic;
    font-size: min(8vw, clamp(1.5rem, 2.2vw, 2rem));
    line-height: 1;
  }
  .s8__human {
    font-family: var(--sans);
    font-style: normal;
    font-weight: 600;
    font-size: min(13vw, clamp(2.6rem, 7vw, 6rem));
    letter-spacing: 0.3em;
    margin-right: -0.3em;
    line-height: 1.05;
  }

  /* ---- Portals: two editorial plates ---- */
  .portals {
    padding-block: clamp(32px, 4vw, 56px) var(--section-y);
  }
  .portals__head {
    display: grid;
    gap: 12px;
    justify-items: center;
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 56px);
  }
  .portals__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(12px, 1.6vw, 24px);
  }
  .portal {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(80svh, 760px);
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-image);
    color: var(--text-on-dark);
    --text: var(--text-on-dark);
    text-decoration: none;
  }
  .portal :global(.portal__media) {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border-radius: 0;
    z-index: -2;
    transition: transform 900ms var(--ease-human);
  }
  /* readability comes from this shade, never from blurring the photograph */
  .portal__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .portal--her .portal__shade {
    background: linear-gradient(0deg, rgba(20, 9, 14, 0.94) 0%, rgba(20, 9, 14, 0.62) 28%, rgba(20, 9, 14, 0) 58%);
  }
  .portal--him .portal__shade {
    background: linear-gradient(0deg, rgba(6, 18, 19, 0.94) 0%, rgba(6, 18, 19, 0.62) 28%, rgba(6, 18, 19, 0) 58%);
  }
  .portal__body {
    display: grid;
    justify-items: start;
    gap: 12px;
    width: 100%;
    padding: clamp(24px, 3vw, 48px);
  }
  .portal__eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .portal--her .portal__eyebrow {
    color: #f0c9d6;
  }
  .portal--him .portal__eyebrow {
    color: #c9ebe6;
  }
  .portal__title {
    font-size: clamp(3rem, 6.2vw, 6rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  .portal__title em {
    font-family: var(--serif);
    font-weight: 400;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: 1.12em;
  }
  .portal__sub {
    max-width: 24em;
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .portal__go {
    margin-top: 12px;
  }
  .portal:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--radius-image);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .portal:hover :global(.portal__media) {
      transform: scale(1.015);
    }
  }
  .portal:hover .portal__go,
  .portal:focus-visible .portal__go {
    --btn-border: var(--text-on-dark);
    background: rgba(243, 239, 230, 0.08);
  }
  .portal:hover .portal__go .arr::before,
  .portal:focus-visible .portal__go .arr::before {
    transform: translateX(3px);
  }
  @media (max-width: 767px) {
    .portals__pair {
      grid-template-columns: 1fr;
    }
    .portal {
      min-height: min(70svh, 540px);
    }
  }

  /* ---- The planned experience ---- */
  .app h2 {
    margin: var(--stack-label) 0 var(--stack-head);
  }
  .app :global(.split) {
    align-items: center;
  }
  .app__facts {
    margin-top: var(--stack-action);
    max-width: var(--measure);
    border-top: 1px solid var(--rule);
  }
  .app__facts > div {
    display: grid;
    grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
    gap: 16px;
    overflow-wrap: anywhere;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    font-size: var(--fs-small);
  }
  .app__facts dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.3em;
  }
  .app__facts dd {
    margin: 0;
  }
  .app__plate {
    background: var(--ink);
    color: var(--text-on-dark);
    --text: var(--text-on-dark);
    --muted: var(--muted-on-dark);
    --rule: var(--rule-on-dark);
    --accent: var(--amber);
    border-radius: var(--radius-control);
    padding: clamp(20px, 2.6vw, 36px);
  }
  .app__ring {
    position: relative;
    width: min(62%, 400px);
    aspect-ratio: 1;
    margin: clamp(56px, 7vw, 88px) auto;
  }
  .app__ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .app__ring circle {
    fill: none;
    stroke: rgba(243, 239, 230, 0.28);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .app__pt {
    position: absolute;
    width: 0;
    height: 0;
  }
  .app__pt i {
    position: absolute;
    left: -4px;
    top: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 5px var(--ink);
  }
  .app__pt > span {
    position: absolute;
    display: flex;
    gap: 8px;
    align-items: baseline;
    white-space: nowrap;
    font-size: min(0.75rem, 3vw); /* vw-capped so the labels stay inside the plate at 200% text size */
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .app__pt b {
    font-size: 0.85em;
    font-weight: 600;
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }
  .app__pt--t > span {
    left: 0;
    bottom: 16px;
    transform: translateX(-50%);
  }
  .app__pt--b > span {
    left: 0;
    top: 16px;
    transform: translateX(-50%);
  }
  .app__pt--r > span {
    left: 16px;
    top: 0;
    transform: translateY(-50%);
  }
  .app__pt--l > span {
    right: 16px;
    top: 0;
    transform: translateY(-50%);
  }
  .app__core {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
  }
  .app__core-mark {
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.32em;
    margin-right: -0.32em;
  }
  .app__core .status-pill {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }
  .app__plate figcaption {
    text-align: center;
  }
  @media (max-width: 599px) {
    .app__ring {
      width: min(46%, 220px);
      margin-block: 52px;
    }
    .app__pt > span {
      font-size: min(0.625rem, 2.8vw);
      letter-spacing: 0.1em;
      gap: 5px;
    }
    .app__core-mark {
      font-size: min(1.125rem, 4.4vw);
    }
    .app__pt--r > span {
      left: 10px;
    }
    .app__pt--l > span {
      right: 10px;
    }
    .app__core .status-pill {
      display: none;
    }
    .app__facts > div {
      grid-template-columns: minmax(0, 5.5rem) minmax(0, 1fr);
    }
  }

  /* ---- Final invitation: the statement on the left, the single action on the right ---- */
  .final {
    padding-block: var(--section-y);
    border-top: 1px solid var(--rule);
  }
  .final__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: end;
  }
  .final__lead {
    grid-column: 1 / span 7;
  }
  .final__statement {
    max-width: 30em;
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .final__statement em {
    font-family: var(--serif);
    font-size: 1.12em;
    color: var(--text-on-dark);
  }
  .final__title {
    margin-top: clamp(32px, 4vw, 56px);
    font-size: clamp(2.5rem, 6vw, 5.5rem);
  }
  .final__act {
    grid-column: 9 / span 4;
    display: grid;
    justify-items: start;
    gap: 18px;
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .final__offer {
    font-size: var(--fs-lede);
    line-height: 1.4;
    max-width: 22em;
  }
  .final__act .btn {
    min-height: 56px;
    padding-inline: 32px;
    margin-top: 6px;
  }
  .final__note {
    margin-top: 6px;
    max-width: 34em;
  }
  @media (max-width: 1023px) {
    .final__lead,
    .final__act {
      grid-column: 1 / -1;
    }
    .final__act {
      max-width: 34em;
    }
  }
