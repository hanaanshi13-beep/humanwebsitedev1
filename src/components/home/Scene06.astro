---
// Scene 06 — THAT'S WHY WE'RE BUILDING HUMAN. Signature 3: THE CONNECTED THREAD (V3-SIG-15..21).
// A semantic ordered list of six stages. An amber thread fills along the list as you scroll; the nearest stage is
// "active". Each stage is also a real button: selecting one sets the active stage and pauses scroll-driven changes
// (interaction wins). Every description is visible at all times; nothing is gated behind motion.
import { STAGES } from '../../data/site';
const status = [
  { what: 'The membership', now: 'Planned. Not on sale.' },
  { what: 'The app', now: 'A prototype is in development.' },
  { what: 'Testing and care', now: 'Not available yet.' },
  { what: 'Where', now: 'Interest welcome from across India. First pilot planned for Delhi NCR.' },
  { what: 'Pricing and what’s included', now: 'Not decided.' },
];
---

<section class="section on-dark s6" id="scene-06" aria-labelledby="s6-title">
  <div class="wrap s6__grid">
    <div class="s6__intro">
      <p class="eyebrow" data-reveal><span class="num">06</span><span>A connected journey</span></p>
      <h2 class="display" id="s6-title" data-reveal="mask">
        <span class="mask"><span>That’s why</span></span>
        <span class="mask" style="--i:1"><span>we’re building</span></span>
        <span class="mask" style="--i:2"><span><em>Human.</em></span></span>
      </h2>
      <p class="lede" data-reveal style="--d:140ms">
        We’re building a membership designed to connect six stages that usually happen apart — or not at all.
      </p>
      <p class="note s6__planned" data-reveal="fade" style="--d:200ms">
        <span class="status-pill">Planned</span>
        This describes what HUMAN is intended to become. None of it is available today.
      </p>
    </div>

    <div class="s6__journey" data-journey data-progress>
      <span class="s6__track" aria-hidden="true"><span class="s6__fill"></span></span>
      <ol class="s6__stages">
        {
          STAGES.map((s, i) => (
            <li class="s6__stage" data-stage={i}>
              <button type="button" class="s6__btn" aria-pressed="false" aria-describedby={`s6-d-${s.key}`}>
                <span class="s6__node" aria-hidden="true" />
                <span class="s6__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="s6__name">{s.name}</span>
              </button>
              <div class="s6__text" id={`s6-d-${s.key}`}>
                <p class="s6__line">{s.line}</p>
                <p class="s6__detail">{s.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="wrap s6__status" id="status">
    <h3 class="eyebrow" data-reveal><span>What’s planned / what’s available now</span></h3>
    <dl data-reveal>
      {
        status.map((r) => (
          <div>
            <dt>{r.what}</dt>
            <dd>{r.now}</dd>
          </div>
        ))
      }
    </dl>
    <p data-reveal="fade">
      <a class="link" href="/faq">Read the straight answers <span class="arr" aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-journey]');
  if (root) {
    const stages = Array.from(root.querySelectorAll<HTMLElement>('.s6__stage'));
    let locked = false;
    let current = -1;
    const setActive = (i: number) => {
      if (i === current) return;
      current = i;
      stages.forEach((s, n) => {
        s.classList.toggle('is-active', n === i);
        s.classList.toggle('is-done', n < i);
        s.querySelector('button')?.setAttribute('aria-pressed', String(n === i));
      });
    };
    // Scroll-driven: the thread fills with --p; the active stage follows unless the visitor has chosen one.
    root.addEventListener('scrollprogress', (e) => {
      const p = (e as CustomEvent<number>).detail;
      if (locked) return;
      setActive(Math.min(stages.length - 1, Math.floor(p * stages.length * 1.02)));
    });
    stages.forEach((s, i) =>
      s.querySelector('button')?.addEventListener('click', () => {
        locked = true;
        root.classList.add('is-locked');
        setActive(i);
      }),
    );
    setActive(0);
    // Arrow keys move along the rail (the buttons stay ordinary tab stops too).
    root.addEventListener('keydown', (e) => {
      const i = stages.findIndex((st) => st.contains(document.activeElement));
      if (i < 0) return;
      const horizontal = getComputedStyle(stages[0]).display === 'contents';
      const fwd = horizontal ? 'ArrowRight' : 'ArrowDown';
      const back = horizontal ? 'ArrowLeft' : 'ArrowUp';
      const to = e.key === fwd ? i + 1 : e.key === back ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? stages.length - 1 : -1;
      if (to < 0 || to >= stages.length || to === i) return;
      e.preventDefault();
      const b = stages[to].querySelector('button')!;
      b.focus();
      b.click();
    });
    // Release the lock once the journey has left the viewport, so a later visit scrubs again.
    new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) {
        locked = false;
        root.classList.remove('is-locked');
      }
    }).observe(root);
  }
</script>

<style>
  .s6 {
    background: var(--carbon);
  }
  .s6__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(20px, 3vw, 48px);
    row-gap: 56px;
    align-items: start;
  }
  .s6__intro {
    grid-column: 1 / span 5;
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }
  .s6__intro h2 {
    margin: 22px 0 28px;
  }
  .s6__planned {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 28px;
    max-width: 34em;
  }
  .s6__journey {
    grid-column: 7 / span 6;
    position: relative;
    --p: 1; /* static default: thread fully drawn */
  }
  .s6__track {
    position: absolute;
    left: 9px;
    top: 22px;
    bottom: 60px;
    width: 1px;
    background: var(--rule);
  }
  .s6__fill {
    position: absolute;
    inset: 0;
    background: var(--amber);
    transform-origin: top;
    transform: scaleY(var(--p));
  }
  .s6__journey.is-locked .s6__fill {
    transform: scaleY(1);
    opacity: 0.45;
  }
  .s6__stage {
    position: relative;
    padding: 0 0 clamp(28px, 3.4vw, 48px) 52px;
  }
  .s6__btn {
    display: flex;
    align-items: baseline;
    gap: 16px;
    width: 100%;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
  }
  .s6__node {
    position: absolute;
    left: 3px;
    top: 15px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--carbon);
    border: 1px solid var(--muted);
    transition:
      background 220ms var(--ease-out),
      border-color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }
  .s6__n {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .s6__name {
    font-size: min(11vw, clamp(2rem, 4.2vw, 3.9rem));
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1;
    text-transform: uppercase;
    transition: color 220ms var(--ease-out);
  }
  .s6__btn:hover .s6__name {
    color: var(--amber);
  }
  .s6__text {
    max-width: 30em;
    margin-top: 10px;
  }
  .s6__line {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.25;
  }
  .s6__detail {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  /* Active emphasis. Inactive stages stay fully readable (V3-SIG-17). */
  :global(.js) .s6__stage .s6__name {
    color: #cfcabd;
  }
  .s6__stage.is-active .s6__name {
    color: var(--text-on-dark);
  }
  .s6__stage.is-active .s6__node {
    background: var(--amber);
    border-color: var(--amber);
    box-shadow: 0 0 0 4px rgba(232, 165, 35, 0.22);
  }
  .s6__stage.is-done .s6__node {
    border-color: var(--amber);
  }
  .s6__stage.is-active .s6__detail {
    color: var(--text-on-dark);
  }

  .s6__status {
    margin-top: clamp(80px, 10vw, 150px);
  }
  .s6__status dl {
    margin: 26px 0 30px;
    border-top: 1px solid var(--rule);
  }
  .s6__status dl > div {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 12px 32px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .s6__status dt {
    font-weight: 600;
  }
  .s6__status dd {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .s6__intro,
    .s6__journey {
      grid-column: 1 / -1;
    }
    .s6__intro {
      position: static;
    }
    .s6__name {
      font-size: min(8.5vw, 2.4rem);
    }
    .s6__stage {
      padding-bottom: 22px;
    }
  }

  /* Desktop with JS: the six stages become one compact glass rail with a single description pane.
     All six panes share one grid cell, so switching never changes the layout height. */
  @media (min-width: 1024px) {
    :global(.js) .s6__grid {
      row-gap: 44px;
    }
    :global(.js) .s6__intro {
      grid-column: 1 / -1;
      position: static;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: clamp(20px, 3vw, 48px);
      align-items: end;
    }
    :global(.js) .s6__intro > .eyebrow,
    :global(.js) .s6__intro > h2 {
      grid-column: 1 / span 6;
    }
    :global(.js) .s6__intro > h2 {
      margin-bottom: 0;
    }
    :global(.js) .s6__intro > .lede {
      grid-column: 8 / span 5;
      grid-row: 2;
    }
    :global(.js) .s6__intro > .s6__planned {
      grid-column: 8 / span 5;
      margin-top: 18px;
    }
    :global(.js) .s6__journey {
      grid-column: 1 / -1;
    }
    :global(.js) .s6__stages {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      grid-template-rows: 64px auto;
      column-gap: 4px;
      padding-inline: 6px;
    }
    :global(.js) .s6__stages::before {
      content: '';
      grid-area: 1 / 1 / 2 / -1;
      margin-inline: -6px;
      border-radius: 999px;
      border: 1px solid var(--glass-dark-edge);
      background: rgba(255, 255, 255, 0.05);
      box-shadow: var(--glass-inner-line), 0 14px 40px rgba(0, 0, 0, 0.35);
    }
    :global(.js) .s6__stage {
      display: contents;
    }
    :global(.js) .s6__btn {
      grid-row: 1;
      position: relative;
      align-self: center;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 52px;
      padding: 0 10px;
      border-radius: 999px;
      border: 1px solid transparent;
      transition:
        background var(--motion-control) var(--ease-human),
        border-color var(--motion-control) var(--ease-human),
        box-shadow var(--motion-control) var(--ease-human);
    }
    :global(.js) .s6__stage:nth-child(1) .s6__btn { grid-column: 1; }
    :global(.js) .s6__stage:nth-child(2) .s6__btn { grid-column: 2; }
    :global(.js) .s6__stage:nth-child(3) .s6__btn { grid-column: 3; }
    :global(.js) .s6__stage:nth-child(4) .s6__btn { grid-column: 4; }
    :global(.js) .s6__stage:nth-child(5) .s6__btn { grid-column: 5; }
    :global(.js) .s6__stage:nth-child(6) .s6__btn { grid-column: 6; }
    :global(.js) .s6__btn:hover {
      background: rgba(255, 255, 255, 0.07);
    }
    :global(.js) .s6__btn:focus-visible {
      border-radius: 999px;
    }
    :global(.js) .s6__node {
      display: none;
    }
    :global(.js) .s6__name {
      font-size: clamp(0.875rem, 1.15vw, 1.0625rem);
      font-weight: 600;
      letter-spacing: 0.01em;
      text-transform: none;
      line-height: 1.1;
    }
    :global(.js) .s6__stage.is-active .s6__btn {
      background: rgba(255, 255, 255, 0.11);
      border-color: rgba(232, 165, 35, 0.7);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 0 0 4px rgba(232, 165, 35, 0.08);
    }
    :global(.js) .s6__stage.is-active .s6__n {
      color: var(--amber);
    }
    :global(.js) .s6__text {
      grid-area: 2 / 1 / 3 / -1;
      max-width: none;
      margin: 52px -6px 0;
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: clamp(20px, 3vw, 48px);
      align-items: start;
      visibility: hidden;
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity var(--motion-control) var(--ease-human),
        transform 420ms var(--ease-human),
        visibility 0s linear var(--motion-control);
    }
    :global(.js) .s6__stage.is-active .s6__text {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
    :global(.js) .s6__line {
      grid-column: 1 / span 6;
      font-size: clamp(1.9rem, 3vw, 2.9rem);
      line-height: 1.08;
    }
    :global(.js) .s6__detail {
      grid-column: 8 / span 5;
      margin-top: 6px;
      font-size: 1.0625rem;
      color: var(--text-on-dark);
    }
    /* the thread runs under the rail and fills left to right */
    :global(.js) .s6__track {
      left: 24px;
      right: 24px;
      top: 82px;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    :global(.js) .s6__fill {
      transform-origin: left;
      transform: scaleX(var(--p));
    }
    :global(.js) .s6__journey.is-locked .s6__fill {
      transform: scaleX(1);
    }
    :global(.js) .s6__status {
      margin-top: clamp(56px, 6vw, 96px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .s6__text,
    .s6__btn {
      transition: none !important;
    }
  }
  @media (max-width: 599px) {
    .s6__status dl > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .s6__stage {
      padding-left: 40px;
    }
  }
</style>
