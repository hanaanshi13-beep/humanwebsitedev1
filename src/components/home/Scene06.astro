---
// Scene 06 — THAT'S WHY WE'RE BUILDING HUMAN. Signature 3: THE CONNECTED THREAD (V3-SIG-15..21).
// A semantic ordered list of six stages on one hairline. All six names, lines and planned details are visible at
// once: no tabs, no scroll-driven state, no script. Desktop reads as a 3 × 2 plate; phones as one vertical thread.
import { STAGES } from '../../data/site';
const status = [
  { what: 'The membership', now: 'Planned. Not on sale.' },
  { what: 'The app', now: 'A prototype is in development.' },
  { what: 'Testing and care', now: 'Not available yet.' },
  { what: 'Where', now: 'Interest welcome from across India. First pilot planned for Delhi NCR.' },
  { what: 'Pricing and what’s included', now: 'Not decided.' },
];
---

<section class="section on-dark s6" id="scene-06" aria-labelledby="s6-title">
  <div class="wrap">
    <div class="s6__intro">
      <p class="eyebrow" data-reveal><span class="num">06</span><span>A connected journey</span></p>
      <h2 class="display" id="s6-title" data-reveal="mask">
        <span class="mask"><span>That’s why</span></span>
        <span class="mask" style="--i:1"><span>we’re building</span></span>
        <span class="mask" style="--i:2"><span><em>Human.</em></span></span>
      </h2>
      <div class="s6__lead">
        <p class="lede" data-reveal style="--d:140ms">
          We’re building a membership designed to connect six stages that usually happen apart — or not at all.
        </p>
        <p class="note s6__planned" data-reveal="fade" style="--d:200ms">
          <span class="status-pill">Planned</span>
          This describes what HUMAN is intended to become. None of it is available today.
        </p>
      </div>
    </div>

    <ol class="s6__stages" aria-label="The six planned stages">
      {
        STAGES.map((s, i) => (
          <li class="s6__stage" data-reveal style={`--d:${(i % 3) * 90}ms`}>
            <span class="s6__node" aria-hidden="true" />
            <span class="s6__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="s6__name">{s.name}</h3>
            <p class="s6__line">{s.line}</p>
            <p class="s6__detail">{s.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="wrap s6__status" id="status">
    <h3 class="eyebrow" data-reveal><span>What’s planned / what’s available now</span></h3>
    <dl data-reveal>
      {
        status.map((r) => (
          <div>
            <dt>{r.what}</dt>
            <dd>{r.now}</dd>
          </div>
        ))
      }
    </dl>
    <p data-reveal="fade">
      <a class="link" href="/faq">Read the straight answers <span class="arr" aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .s6__intro {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    align-items: end;
  }
  .s6__intro > .eyebrow,
  .s6__intro > h2 {
    grid-column: 1 / span 6;
  }
  .s6__intro > h2 {
    margin: var(--stack-label) 0 0;
  }
  .s6__lead {
    grid-column: 8 / span 5;
    grid-row: 2;
  }
  .s6__planned {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 22px;
    max-width: 34em;
  }

  /* The plate: one hairline per row carries the six nodes. */
  .s6__stages {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--col-gap);
    row-gap: clamp(44px, 5vw, 72px);
    margin-top: clamp(56px, 7vw, 104px);
  }
  .s6__stage {
    position: relative;
    padding-top: 26px;
  }
  .s6__stage::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: calc(100% + var(--col-gap));
    height: 1px;
    background: var(--rule);
  }
  .s6__stage:nth-child(3n)::before {
    width: 100%;
  }
  .s6__node {
    position: absolute;
    left: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--amber);
  }
  .s6__n {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }
  .s6__name {
    margin-top: 12px;
    font-size: clamp(1.625rem, 2.5vw, 2.375rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
  }
  .s6__line {
    margin-top: 12px;
    max-width: 16em;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    line-height: 1.22;
    text-wrap: balance;
  }
  .s6__detail {
    margin-top: 14px;
    max-width: 30em;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--muted);
    text-wrap: pretty;
  }

  .s6__status {
    margin-top: clamp(64px, 8vw, 112px);
  }
  .s6__status dl {
    margin: 26px 0 30px;
    border-top: 1px solid var(--rule);
  }
  .s6__status dl > div {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 12px 32px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .s6__status dt {
    font-weight: 600;
  }
  .s6__status dd {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .s6__intro > .eyebrow,
    .s6__intro > h2,
    .s6__lead {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .s6__lead {
      margin-top: var(--stack-head);
    }
    .s6__stages {
      grid-template-columns: repeat(2, 1fr);
    }
    .s6__stage:nth-child(3n)::before {
      width: calc(100% + var(--col-gap));
    }
    .s6__stage:nth-child(2n)::before {
      width: 100%;
    }
  }
  /* Phones: one vertical thread, written for reading. */
  @media (max-width: 639px) {
    .s6__stages {
      grid-template-columns: 1fr;
      row-gap: 0;
      margin-top: 44px;
      border-left: 1px solid var(--rule);
    }
    .s6__stage {
      padding: 0 0 30px 24px;
    }
    .s6__stage:last-child {
      padding-bottom: 0;
    }
    .s6__stage::before {
      display: none;
    }
    .s6__node {
      left: -4px;
      top: 3px;
    }
    .s6__name {
      margin-top: 8px;
      font-size: 1.5rem;
    }
    .s6__line {
      margin-top: 8px;
      font-size: 1.25rem;
    }
    .s6__detail {
      margin-top: 8px;
    }
    .s6__status dl > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
