---
// Scene 05 — AFTER THE REPORT. A full-viewport, scroll-controlled film in six acts, built from the founders'
// approved assets: one studio plate, the isolated report, a macro close-up, and eight exact slices of the report.
//
//   I   arrival          the report rises into the studio light
//   II  immersion        the camera moves into the page (macro plate on wide screens)
//   III deconstruction   the six information rows leave the sheet, each to its own depth
//   IV  transformation   each paper row becomes a thin optical plane in the same place
//   V   understanding    six planes gather into three: context, questions, next steps
//   VI  resolution       the camera withdraws; the closing line
//
// Everything on screen is a pure function of one number, the scroll progress p (0..1), so the same scroll
// position always gives the same picture, forwards or backwards. Nothing is timed, queued or one-shot.
// The depth is CSS perspective and compositing; nothing here is a 3D model or real refraction.
//
// The report is an illustration. No values, scores or findings are shown or added, and the three final planes
// are ideas (context, questions, next steps), not a classification of anyone's results.
// With reduced motion or without JavaScript the film is replaced by a still: the report, the three ideas, the line.
import { getImage } from 'astro:assets';
import env from '../../assets/scene05/human-s05-environment.webp';
import macro from '../../assets/scene05/human-s05-macro.webp';
import report from '../../assets/scene05/human-s05-report.png';
import fHeader from '../../assets/scene05/human-s05-frag-header.png';
import fCardio from '../../assets/scene05/human-s05-frag-cardiovascular.png';
import fMetabolic from '../../assets/scene05/human-s05-frag-metabolic.png';
import fHormonal from '../../assets/scene05/human-s05-frag-hormonal.png';
import fNutritional from '../../assets/scene05/human-s05-frag-nutritional.png';
import fContext from '../../assets/scene05/human-s05-frag-clinical-context.png';
import fFollow from '../../assets/scene05/human-s05-frag-follow-up.png';
import fFooter from '../../assets/scene05/human-s05-frag-footer.png';

// Exact geometry from the founders' fragment-layout.json (source canvas 1086 × 1448).
const CW = 1086;
const CH = 1448;
const pieces = [
  { key: 'header', src: fHeader, y: 0, h: 529, row: false, label: '' },
  { key: 'cardiovascular', src: fCardio, y: 529, h: 110, row: true, label: 'Cardiovascular' },
  { key: 'metabolic', src: fMetabolic, y: 639, h: 112, row: true, label: 'Metabolic' },
  { key: 'hormonal', src: fHormonal, y: 751, h: 116, row: true, label: 'Hormonal' },
  { key: 'nutritional', src: fNutritional, y: 867, h: 116, row: true, label: 'Nutritional' },
  { key: 'clinical-context', src: fContext, y: 983, h: 110, row: true, label: 'Clinical context' },
  { key: 'follow-up', src: fFollow, y: 1093, h: 111, row: true, label: 'Follow-up' },
  { key: 'footer', src: fFooter, y: 1204, h: 244, row: false, label: '' },
];
// alpha is kept; the slices stay at their native size so they tile exactly
const webp = (src: ImageMetadata, quality = 92) => getImage({ src, width: src.width, format: 'webp', quality });
const frag = await Promise.all(pieces.map(async (p) => ({ ...p, url: (await webp(p.src)).src })));
const reportImg = await webp(report);
const envImg = await getImage({ src: env, width: env.width, format: 'webp', quality: 86 });
const macroImg = await getImage({ src: macro, width: macro.width, format: 'webp', quality: 88 });

const acts = [
  { a: 'You got tested.', b: 'Now what?' },
  { a: 'So much information.', b: 'So little clarity.' },
  { a: 'But what', b: 'actually matters?' },
  { a: 'Numbers alone', b: 'aren’t the whole story.' },
  { a: 'Understand more.', b: 'Guess less.' },
  { a: 'Getting tested', b: 'is only the beginning.' },
];
const planes = [
  { key: 'context', label: 'Context', q: 'What matters?' },
  { key: 'questions', label: 'Questions', q: 'What should I ask?' },
  { key: 'next', label: 'Next steps', q: 'What happens next?' },
];
const pct = (n: number, d: number) => `${((n / d) * 100).toFixed(4)}%`;
---

<section class="s5 on-dark" id="scene-05" aria-labelledby="s5-title" data-s5>
  <!-- The whole story in words, for assistive technology and for anyone the film does not reach. -->
  <div class="vh">
    <h2 id="s5-title">Getting tested is only the beginning.</h2>
    <p>
      You got tested. Now what? So much information, so little clarity. But what actually matters? Numbers alone
      aren’t the whole story. Understand more. Guess less.
    </p>
    <p>Three ideas: Context — what matters? Questions — what should I ask? Next steps — what happens next?</p>
  </div>

  <div class="s5__track" data-s5-track>
    <div class="s5__view" data-s5-view>
      <!-- LAYER 1: the studio -->
      <img class="s5__env" src={envImg.src} width={env.width} height={env.height} alt="" loading="lazy" decoding="async" />
      <span class="s5__dim" data-s5-dim aria-hidden="true"></span>
      <span class="s5__shadow" data-s5-shadow aria-hidden="true"></span>

      <!-- LAYER 2: the macro plate (wide screens) -->
      <img class="s5__macro" data-s5-macro src={macroImg.src} width={macro.width} height={macro.height} alt="" loading="lazy" decoding="async" />

      <!-- LAYER 3: camera → document → pieces -->
      <div class="s5__cam" data-s5-cam>
        <div class="s5__doc" data-s5-doc>
          <img
            class="s5__whole"
            data-s5-whole
            src={reportImg.src}
            width={CW}
            height={CH}
            alt="Illustration of a one-page health report with six headings: cardiovascular, metabolic, hormonal, nutritional, clinical context and follow-up. It shows no results."
            loading="lazy"
            decoding="async"
          />
          <div class="s5__pieces" data-s5-pieces aria-hidden="true">
            {
              frag.map((f) => (
                <div class={`s5__piece ${f.row ? 's5__piece--row' : 's5__piece--edge'}`} data-s5-piece={f.key} style={`top:${pct(f.y, CH)};height:${pct(f.h, CH)}`}>
                  <img src={f.url} width={CW} height={f.h} alt="" loading="lazy" decoding="async" />
                  {f.row && (
                    <span class="s5__glass">
                      <span>{f.label}</span>
                    </span>
                  )}
                </div>
              ))
            }
            {
              planes.map((pl) => (
                <div class="s5__plane" data-s5-plane={pl.key}>
                  <span class="s5__plane-label">{pl.label}</span>
                  <span class="s5__plane-q">{pl.q}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- LAYER 4: one statement at a time -->
      <span class="s5__scrim" data-s5-scrim aria-hidden="true"></span>
      <div class="s5__lines" aria-hidden="true">
        {
          acts.map((t, i) => (
            <p class="s5__line" data-s5-line={i}>
              <span class="s5__line-a">{t.a}</span>
              <em class="s5__line-b">{t.b}</em>
            </p>
          ))
        }
      </div>

      <p class="s5__disclosure">Illustrative report. No patient results.</p>
      <button type="button" class="s5__skip" data-s5-skip>Skip animation</button>
      <a class="link s5__go" data-s5-go href="#scene-06">See how HUMAN is designed to help <span class="arr arr--down" aria-hidden="true">↓</span></a>
      <span class="s5__floor" data-s5-floor aria-hidden="true"></span>
    </div>
  </div>

  <!-- The still: shown instead of the film with reduced motion or without JavaScript. -->
  <div class="s5__still">
    <img class="s5__env" src={envImg.src} width={env.width} height={env.height} alt="" loading="lazy" decoding="async" />
    <div class="wrap s5__still-in">
      <img class="s5__still-report" src={reportImg.src} width={CW} height={CH} alt="Illustration of a one-page health report with six headings. It shows no results." loading="lazy" decoding="async" />
      <div class="s5__still-copy">
        <p class="s5__line s5__line--still" aria-hidden="true">
          <span class="s5__line-a">Getting tested</span>
          <em class="s5__line-b">is only the beginning.</em>
        </p>
        <ul class="s5__still-planes">
          {
            planes.map((pl) => (
              <li>
                <span class="s5__plane-label">{pl.label}</span>
                <span class="s5__plane-q">{pl.q}</span>
              </li>
            ))
          }
        </ul>
        <p class="s5__disclosure s5__disclosure--still">Illustrative report. No patient results.</p>
        <a class="link" href="#scene-06">See how HUMAN is designed to help <span class="arr arr--down" aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-s5]');
  const track = sec?.querySelector<HTMLElement>('[data-s5-track]');
  const view = sec?.querySelector<HTMLElement>('[data-s5-view]');
  if (sec && track && view) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => sec.querySelector<T>(s)!;
    const cam = $('[data-s5-cam]');
    const doc = $('[data-s5-doc]');
    const whole = $('[data-s5-whole]');
    const piecesBox = $('[data-s5-pieces]');
    const macroEl = $('[data-s5-macro]');
    const dim = $('[data-s5-dim]');
    const shadow = $('[data-s5-shadow]');
    const scrim = $('[data-s5-scrim]');
    const floor = $('[data-s5-floor]');
    const skip = $<HTMLButtonElement>('[data-s5-skip]');
    const go = $<HTMLAnchorElement>('[data-s5-go]');
    const lines = Array.from(sec.querySelectorAll<HTMLElement>('[data-s5-line]'));
    const all = Array.from(sec.querySelectorAll<HTMLElement>('[data-s5-piece]'));
    const rows = all.filter((e) => e.classList.contains('s5__piece--row'));
    const edges = all.filter((e) => e.classList.contains('s5__piece--edge'));
    const rowImg = rows.map((r) => r.querySelector('img')!);
    const rowGlass = rows.map((r) => r.querySelector<HTMLElement>('.s5__glass')!);
    const rowText = rowGlass.map((g) => g.firstElementChild as HTMLElement);
    const planeEls = Array.from(sec.querySelectorAll<HTMLElement>('[data-s5-plane]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ramp = (v: number, a: number, b: number) => clamp((v - a) / (b - a));
    const ease = (t: number) => t * t * (3 - 2 * t);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    // piecewise-linear keyframes: [[p, value], …]
    const key = (p: number, ks: number[][]) => {
      if (p <= ks[0][0]) return ks[0][1];
      for (let i = 1; i < ks.length; i++) if (p <= ks[i][0]) return lerp(ks[i - 1][1], ks[i][1], ease((p - ks[i - 1][0]) / (ks[i][0] - ks[i - 1][0])));
      return ks[ks.length - 1][1];
    };

    // ---- the choreography of the six rows (fractions of the report's width / height; depth in px; degrees) ----
    // [dx, dy, z, rotateY, rotateZ, when it starts within the act (0..0.35)]
    const SEP = [
      [-0.17, -0.125, 40, 7, -2.2, 0.0],
      [0.15, -0.078, 5, -6, 1.6, 0.1],
      [-0.03, -0.03, 70, 2, -0.6, 0.05],
      [0.11, 0.028, -20, -5, -1.2, 0.18],
      [-0.14, 0.08, 85, 6, 1.8, 0.12],
      [0.06, 0.13, 25, -4, -1.6, 0.25],
    ];
    const ROW_Y = [529, 639, 751, 867, 983, 1093];
    const ROW_H = [110, 112, 116, 116, 110, 111];
    const rowCentre = (i: number) => (ROW_Y[i] + ROW_H[i] / 2) / 1448;
    // the three planes: centres down the page, a shallow fan in depth
    const PLANE_Y = [0.44, 0.615, 0.79];
    const PLANE_Z = [60, 0, -60];
    const PLANE_X = [-0.045, 0, 0.045];

    let W = 0;
    let H = 0;
    let vw = 0;
    let vh = 0;
    let wide = true;
    const measure = () => {
      W = doc.offsetWidth;
      H = doc.offsetHeight;
      vw = view.clientWidth;
      vh = view.clientHeight;
      wide = vw >= 900 && vw > vh;
    };

    let lastState = '';
    const render = (p: number, arrive: number) => {
      if (!W) return;
      const spread = wide ? 1 : 0.24; // phones: far less sideways travel
      // ---------- camera ----------
      const sIn = clamp((1.04 * vw) / (W * 0.875), 2.4, 3.6); // the paper a little wider than the screen
      // how large the separated rows sit: as big as the room between the header and the statement allows
      const sOpen = wide ? Math.min(1.5, (0.46 * vw) / W, (vh - 330) / (0.8 * H)) : Math.min(1.12, (0.8 * vw) / W, (vh - 300) / (0.78 * H));
      const scale = key(p, [[0, 1], [0.16, 1], [0.31, sIn], [0.4, sIn * 1.04], [0.414, sIn * 0.7], [0.51, sOpen], [0.8, sOpen], [1, sOpen * 0.88]]);
      // which point of the page the camera looks at (fractions of the page), and how firmly
      const fx = key(p, [[0.16, 0.5], [0.31, 0.43], [0.414, 0.46], [0.53, 0.5]]);
      const fy = key(p, [[0.16, 0.5], [0.31, 0.25], [0.414, 0.42], [0.51, 0.6], [0.8, 0.615], [1, 0.6]]);
      const hold = key(p, [[0.16, 0], [0.3, 1]]);
      const lift = (1 - ease(arrive)) * vh * 0.06;
      const tx = -(fx - 0.5) * W * scale * hold;
      const ty = -(fy - 0.5) * H * scale * hold + lift;
      cam.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, 0) scale(${(scale * (0.88 + 0.12 * ease(arrive))).toFixed(4)})`;
      // the page's own attitude: master pose → leaning away at the deepest point → turned to show depth
      const ry = key(p, [[0.16, -8], [0.31, -5], [0.43, -4], [0.55, -13], [0.8, -16], [1, -10]]);
      const rx = key(p, [[0.16, 2], [0.31, 13], [0.43, 8], [0.55, 4], [0.8, 6], [1, 4]]);
      const rz = key(p, [[0.16, -2.5], [0.31, 4.5], [0.43, 2], [0.53, 0]]);
      doc.style.transform = `rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) rotateZ(${rz.toFixed(2)}deg)`;

      // ---------- which picture of the report is on screen (never two at once, beyond a short handover) ----------
      // The macro plate and the report never share the frame: each handover is a short cut through shadow.
      const macroIn = wide ? ramp(p, 0.312, 0.33) : 0;
      const macroOut = wide ? 1 - ramp(p, 0.4, 0.415) : 0;
      const macroO = Math.min(macroIn, macroOut);
      macroEl.style.opacity = macroO.toFixed(3);
      macroEl.style.transform = `scale(${(1.1 - 0.06 * ease(ramp(p, 0.292, 0.36)) + 0.05 * ramp(p, 0.36, 0.43)).toFixed(4)})`;
      const sep = ramp(p, 0.43, 0.57); // act III master progress
      const apart = sep > 0;
      // while the macro plate is fully up the rig is hidden; it returns underneath as the plate leaves
      const rigO = wide ? (p < 0.36 ? 1 - ramp(p, 0.296, 0.312) : ramp(p, 0.414, 0.43)) : 1;
      const bump = (a: number, m: number, b: number) => (p <= a || p >= b ? 0 : p < m ? (p - a) / (m - a) : (b - p) / (b - m));
      const cut = wide ? Math.max(bump(0.288, 0.312, 0.334), bump(0.396, 0.414, 0.432)) : 0;
      const arriveO = clamp(arrive * 1.5);
      cam.style.opacity = (rigO * arriveO).toFixed(3);
      whole.style.opacity = apart ? '0' : '1';
      piecesBox.style.opacity = apart ? '1' : '0';

      // ---------- act III–V: the rows ----------
      const mat = (i: number) => ease(ramp(p, 0.575 + i * 0.012, 0.645 + i * 0.012));
      const gather = ease(ramp(p, 0.71, 0.8));
      const settle = ease(ramp(p, 0.81, 0.96));
      const planeY = (k: number) => lerp(PLANE_Y[k], 0.615 + (PLANE_Y[k] - 0.615) * 0.86, settle);
      rows.forEach((el, i) => {
        const [dx, dy, z, rY, rZ, t0] = SEP[i];
        const s = ease(ramp(sep, t0, t0 + 0.65));
        const k = Math.floor(i / 2);
        // separated position → its plane's position
        const x = lerp(dx * spread * s, PLANE_X[k] * spread, gather) * W;
        const y = lerp(dy * s, planeY(k) - rowCentre(i), gather) * H;
        const zz = lerp(z * s, PLANE_Z[k], gather);
        el.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, ${zz.toFixed(1)}px) rotateY(${(rY * s * (1 - gather)).toFixed(2)}deg) rotateZ(${(rZ * s * (1 - gather)).toFixed(2)}deg)`;
        const m = mat(i);
        el.style.setProperty('--lift', s.toFixed(3));
        rowImg[i].style.opacity = (1 - m).toFixed(3);
        rowGlass[i].style.opacity = (m * (1 - ramp(gather, 0.55, 1))).toFixed(3);
        rowGlass[i].style.setProperty('--wipe', m.toFixed(3));
        rowText[i].style.opacity = (ramp(m, 0.55, 1) * (1 - ramp(gather, 0, 0.45))).toFixed(3);
      });
      // header and footer: stay with the sheet for a beat, then fall back into the dark
      const edgeO = 1 - ease(ramp(sep, 0.12, 0.7));
      edges.forEach((el, i) => {
        el.style.opacity = edgeO.toFixed(3);
        el.style.transform = `translate3d(0, ${((i ? 1 : -1) * 0.03 * H * ease(ramp(sep, 0, 0.7))).toFixed(1)}px, ${(-120 * ease(ramp(sep, 0, 0.7))).toFixed(1)}px)`;
      });
      // the three planes take over from the six
      planeEls.forEach((el, k) => {
        const o = ramp(gather, 0.5, 1);
        el.style.opacity = o.toFixed(3);
        el.style.transform = `translate3d(${(PLANE_X[k] * spread * W).toFixed(1)}px, ${((planeY(k) - 0.5) * H).toFixed(1)}px, ${lerp(PLANE_Z[k], PLANE_Z[k] * 0.6, settle).toFixed(1)}px) translate(-50%, -50%)`;
        el.style.setProperty('--words', ramp(gather, 0.75, 1).toFixed(3));
      });

      // ---------- light ----------
      dim.style.opacity = Math.max(cut * 0.86, key(p, [[0, 0], [0.2, 0.05], [0.31, 0.4], [0.43, 0.34], [0.56, 0.2], [0.8, 0.26], [1, 0.42]])).toFixed(3);
      const sh = arriveO * (1 - ramp(p, 0.17, 0.26)) + 0.5 * ramp(p, 0.84, 1);
      shadow.style.opacity = sh.toFixed(3);
      shadow.style.transform = `translate(-50%, 0) scaleX(${(0.92 + 0.12 * ease(arrive) - 0.1 * ramp(p, 0.84, 1)).toFixed(3)})`;
      scrim.style.opacity = Math.max(macroO, wide ? 0 : ramp(p, 0.24, 0.31) * (1 - ramp(p, 0.42, 0.47))).toFixed(3);
      floor.style.opacity = ramp(p, 0.9, 1).toFixed(3);

      // ---------- words: one statement at a time ----------
      const win = [
        [-1, -1, 0.12, 0.15],
        [0.322, 0.342, 0.4, 0.42],
        [0.46, 0.49, 0.55, 0.57],
        [0.58, 0.605, 0.68, 0.7],
        [0.715, 0.74, 0.8, 0.82],
        [0.85, 0.89, 2, 3],
      ];
      if (!wide) win[1] = [0.27, 0.31, 0.4, 0.42];
      lines.forEach((el, i) => {
        const [a, b, c, d] = win[i];
        const inn = i === 0 ? clamp((arrive - 0.6) / 0.3) : ramp(p, a, b);
        const out = ramp(p, c, d);
        el.style.opacity = (ease(inn) * (1 - ease(out))).toFixed(3);
        el.style.transform = `translate3d(0, ${((1 - ease(inn)) * 16 - ease(out) * 14).toFixed(1)}px, 0)`;
      });

      // ---------- controls exist only while they are visible ----------
      const state = p < 0.86 ? 'film' : 'end';
      if (state !== lastState) {
        lastState = state;
        sec.dataset.s5State = state;
        skip.hidden = state === 'end';
        go.inert = state !== 'end';
      }
      sec.dataset.s5Act = String(p < 0.17 ? 1 : p < 0.41 ? 2 : p < 0.56 ? 3 : p < 0.7 ? 4 : p < 0.8 ? 5 : 6);
    };

    // ---------- scroll: one rAF-throttled listener, only while the scene is near the viewport ----------
    let ticking = false;
    let on = false; // film mode (not reduced motion)
    const update = () => {
      ticking = false;
      if (!on) return;
      const span = track.offsetHeight - view.offsetHeight;
      const top = track.getBoundingClientRect().top;
      const p = span > 8 ? clamp(-top / span) : 0;
      const arrive = clamp(1 - top / (window.innerHeight * 0.85));
      sec.style.setProperty('--p', p.toFixed(4));
      render(p, arrive);
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    let listening = false;
    new IntersectionObserver(
      ([en]) => {
        if (en.isIntersecting && !listening) {
          window.addEventListener('scroll', request, { passive: true });
          listening = true;
        } else if (!en.isIntersecting && listening) {
          window.removeEventListener('scroll', request);
          listening = false;
        }
        request();
      },
      { rootMargin: '40% 0px 40% 0px' },
    ).observe(sec);
    new ResizeObserver(() => {
      measure();
      request();
    }).observe(view);

    const applyMotionPref = () => {
      on = !reduce.matches;
      sec.classList.toggle('is-film', on);
      if (on) {
        measure();
        update();
      }
    };
    reduce.addEventListener('change', applyMotionPref);
    applyMotionPref();

    // Skip: go straight to the closing shot (the page then scrolls on as normal).
    skip.addEventListener('click', () => {
      const span = track.offsetHeight - view.offsetHeight;
      window.scrollTo({ top: track.getBoundingClientRect().top + window.scrollY + span * 0.985, behavior: 'instant' });
      update(); // bring the closing shot (and its link) up now, so focus has somewhere to land
      go.focus({ preventScroll: true });
    });
    // if a picture fails to load, the film still runs on the others; the macro plate simply never shows
    macroEl.addEventListener('error', () => (macroEl.style.display = 'none'));
  }
</script>

<style>
  .s5 {
    --s5-ink: #0d0d0e;
    --s5-white: #f4efe6;
    --s5-champagne: #d9c39a;
    position: relative;
    background: var(--s5-ink);
    color: var(--s5-white);
  }
  .s5__env {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 22% 60%;
  }

  /* ---- the film (only when the script has confirmed motion is welcome) ---- */
  .s5__track {
    display: none;
  }
  .s5:global(.is-film) .s5__track {
    display: block;
    height: 520vh;
    height: 520svh;
  }
  .s5:global(.is-film) .s5__still {
    display: none;
