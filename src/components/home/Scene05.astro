---
// Scene 05 — GETTING TESTED IS ONLY THE BEGINNING. Signature 2: FROM NUMBERS TO CLARITY (V3-SIG-09..14).
// An illustrative report sheet (blank bars only — no values, names or ranges) quietens as you scroll (--p),
// leaving one question, which branches into three non-clinical questions. The three questions and their answers
// are always at full contrast: scroll only draws an amber accent line above each one. Nothing is dimmed.
const rows = [
  { w: 62, ox: -26 }, { w: 38, ox: 34, key: true }, { w: 80, ox: -14 }, { w: 46, ox: 22 }, { w: 70, ox: -38, key: true },
  { w: 30, ox: 18 }, { w: 56, ox: -22 }, { w: 74, ox: 40, key: true }, { w: 42, ox: -16 }, { w: 64, ox: 28 },
];
const questions = [
  { q: 'What matters?', a: 'Which parts of a report deserve attention first — and which are simply context.' },
  { q: 'What should I ask?', a: 'The questions worth taking to a qualified professional.' },
  { q: 'What happens next?', a: 'What following through could look like, and when it makes sense to look again.' },
];
---

<section class="section on-light on-ivory s5" id="scene-05" aria-labelledby="s5-title">
  <div class="wrap">
    <div class="s5__head">
      <p class="eyebrow" data-reveal><span class="num">05</span><span>After the report</span></p>
      <h2 class="display" id="s5-title" data-reveal="mask">
        <span class="mask"><span>Getting tested</span></span>
        <span class="mask" style="--i:1"><span><em>is only the beginning.</em></span></span>
      </h2>
      <div class="prose s5__intro" data-reveal style="--d:120ms">
        <p>
          You got your report. Looked through the numbers. Maybe searched a few things.
          <strong>But what happened next?</strong>
        </p>
        <p>
          Did you know which results mattered, where to start, how to follow through, or whether anything had
          changed when you checked again?
        </p>
      </div>
    </div>

    <!-- The transformation: a dense, value-free sheet settles, most of it recedes, and three lines of it
         resolve into three plain questions. Driven by --p; the final state is the default. -->
    <div class="s5__stage" data-progress>
      <figure class="s5__report">
        <div class="s5__sheet" aria-hidden="true">
          <div class="s5__sheet-head"><span></span><span></span></div>
          {
            rows.map((r, i) => (
              <div class={`s5__row ${r.key ? 'is-key' : ''}`} style={`--w:${r.w}%;--ox:${r.ox}px;--k:${(i % 5) / 5}`}>
                <span />
                <span />
                <span />
              </div>
            ))
          }
          <span class="s5__lens"><span>What does this mean <em>for me?</em></span></span>
        </div>
        <figcaption class="note">Concept illustration. It contains no values and is not a real report.</figcaption>
      </figure>

      <ol class="s5__qs">
        {
          questions.map((x, i) => (
            <li style={`--i:${i}`}>
              <span class="s5__thread" aria-hidden="true" />
              <span class="s5__qn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{x.q}</h3>
              <p>{x.a}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="s5__close" data-reveal>
      <p class="s5__close-line">
        Getting information is a start. <em>Understanding it and knowing what to do</em> makes it useful.
      </p>
      <a class="link" href="#scene-06">See how HUMAN is designed to help <span class="arr arr--down" aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<style>
  .s5 {
    --p: 1; /* static default: the resolved state */
  }
  .s5__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    align-items: end;
  }
  .s5__head > .eyebrow,
  .s5__head > h2 {
    grid-column: 1 / span 7;
  }
  .s5__head h2 {
    margin: var(--stack-label) 0 0;
  }
  .s5__intro {
    grid-column: 8 / span 5;
    grid-row: 2;
  }
  .s5__stage {
    --t: clamp(0, var(--p) * 2.2, 1); /* rows settle into alignment */
    --u: clamp(0, (var(--p) - 0.42) * 2.6, 1); /* noise recedes, questions resolve */
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: 40px;
    align-items: center;
    margin-top: clamp(48px, 6vw, 88px);
  }
  .s5__report {
    grid-column: 1 / span 5;
  }
  /* paper, not glass: the document is information, the lens on it is interface */
  .s5__sheet {
    position: relative;
    background: linear-gradient(180deg, #fdfcf8, #f6f3ec);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: clamp(20px, 2.4vw, 34px);
    aspect-ratio: 4 / 4.6;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin-bottom: 14px;
    box-shadow:
      0 1px 0 #fff inset,
      0 40px 70px -44px rgba(20, 25, 28, 0.45),
      0 2px 6px rgba(20, 25, 28, 0.06);
    transform: rotate(calc((1 - var(--t)) * -1.6deg)) translateY(calc((1 - var(--t)) * 18px));
  }
  .s5__sheet-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .s5__sheet-head span {
    height: 9px;
    width: 34%;
    background: var(--text);
    opacity: 0.8;
  }
  .s5__sheet-head span + span {
    width: 16%;
    opacity: 0.25;
  }
  .s5__row {
    display: grid;
    grid-template-columns: var(--w) 1fr 12%;
    gap: 10px;
    align-items: center;
    transform: translateX(calc(var(--ox) * (1 - var(--t))));
    opacity: calc(1 - var(--u) * (0.4 + var(--k) * 0.2));
  }
  .s5__row span {
    height: 6px;
    border-radius: 1px;
    background: var(--text);
    opacity: 0.55;
  }
  .s5__row span:nth-child(2) {
    opacity: 0;
  }
  .s5__row span:nth-child(3) {
    opacity: 0.22;
  }
  .s5__row.is-key {
    opacity: 1;
  }
  .s5__row.is-key span:first-child {
    opacity: 1;
    background: color-mix(in srgb, var(--accent) calc(var(--u) * 100%), var(--text));
    height: calc(6px + var(--u) * 2px);
  }
  /* the one glass element: a small lens that settles on the sheet as the noise recedes */
  .s5__lens {
    position: absolute;
    left: 50%;
    bottom: 13%;
    transform: translate(-50%, 0);
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    color: var(--text-on-dark);
    font-size: clamp(0.9375rem, 1.3vw, 1.125rem);
    font-weight: 600;
    background: var(--ink);
    box-shadow: 0 14px 30px -12px rgba(20, 20, 16, 0.45);
  }
  .s5__lens em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.12em;
    color: var(--amber-ui-hover);
  }
  .s5__qs {
    grid-column: 7 / span 6;
    display: grid;
    gap: clamp(18px, 2.2vw, 30px);
  }
  .s5__qs li {
    --q: clamp(0, (var(--p) - 0.5 - var(--i) * 0.1) * 5, 1);
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .s5__thread {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 1px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--q));
  }
  .s5__qn {
    grid-row: 1 / span 2;
    padding-top: 0.5em;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
  .s5__qs h3 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.75rem, 2.8vw, 2.625rem);
    line-height: 1.08;
    color: var(--text);
  }
  .s5__qs p {
    margin-top: 8px;
    max-width: 30em;
    color: var(--text);
  }
  .s5__close {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px 40px;
    margin-top: clamp(48px, 6vw, 88px);
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .s5__close-line {
    max-width: 26em;
    font-size: clamp(1.25rem, 1.9vw, 1.7rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .s5__close-line em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.1em;
  }
  @media (max-width: 899px) {
    .s5__head > .eyebrow,
    .s5__head > h2,
    .s5__intro,
    .s5__report,
    .s5__qs {
      grid-column: 1 / -1;
    }
    .s5__intro {
      grid-row: auto;
      margin-top: 26px;
    }
    .s5__report {
      max-width: 360px;
    }
    .s5__sheet {
      aspect-ratio: 4 / 3.4;
    }
    .s5__row:nth-child(n + 9) {
      display: none;
    }
    .s5__lens {
      white-space: normal;
      text-align: center;
      width: max-content;
      max-width: 86%;
    }
  }
</style>
