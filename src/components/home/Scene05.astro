---
// Scene 05 — GETTING TESTED IS ONLY THE BEGINNING. "A report, translated for a human being."
//
// One typeset, value-free document (real text, no image) on a small stack of paper. As the stage scrolls into
// view the stack arrives, the sheets part, the view leans toward the page and a reading lens settles on one
// region. A fragment of that region then lifts off the page and resolves into an interpretation note.
// Three questions choose which region is read; each has its own lens position, framing and note.
//
// Two separate sources of truth so they never fight:
//   intro progress (scroll)  — arrival, separation, approach. Stops mattering once the visitor chooses.
//   data-active              — matters | ask | next. Everything interactive derives from it.
//
// The document is a concept. It holds no values, flags or findings, and the lens marks the topic being
// discussed, never a result. Without JavaScript the report, the first note and all three questions are plain text.
const markers = [
  { area: 'Cardiovascular', marker: 'Lipid profile' },
  { area: 'Metabolic', marker: 'Blood glucose' },
  { area: 'Hormonal', marker: 'Thyroid function' },
  { area: 'Nutritional', marker: 'Iron status' },
];
const states = [
  {
    key: 'matters',
    n: '01',
    q: 'What matters?',
    a: 'Which parts of a report deserve attention first — and which are simply context.',
    short: 'Matters',
    region: 'markers',
    lift: 'Example health markers',
    eyebrow: '01 — Understanding',
    title: 'Understand the context.',
    body: 'Which findings are relevant to my health history?',
  },
  {
    key: 'ask',
    n: '02',
    q: 'What should I ask?',
    a: 'The questions worth taking to a qualified professional.',
    short: 'Ask',
    region: 'context',
    lift: 'Clinical context',
    eyebrow: '02 — Guidance',
    title: 'Start a conversation.',
    body: 'Is there anything I should discuss with my clinician?',
  },
  {
    key: 'next',
    n: '03',
    q: 'What happens next?',
    a: 'What following through could look like, and when it makes sense to look again.',
    short: 'Next',
    region: 'followup',
    lift: 'Follow-up',
    eyebrow: '03 — Follow-through',
    title: 'Know the next step.',
    body: 'Would follow-up or further assessment be appropriate?',
  },
];
const path = ['Information', 'Context', 'Conversation', 'Follow-through'];
---

<section class="section on-light on-ivory s5" id="scene-05" aria-labelledby="s5-title" data-s5 data-active="matters">
  <div class="wrap">
    <div class="s5__head">
      <p class="eyebrow" data-reveal><span class="num">05</span><span>After the report</span></p>
      <h2 class="display" id="s5-title" data-reveal="mask">
        <span class="mask"><span>Getting tested</span></span>
        <span class="mask" style="--i:1"><span><em>is only the beginning.</em></span></span>
      </h2>
      <div class="prose s5__intro" data-reveal style="--d:120ms">
        <p>
          You got your report. Looked through the numbers. Maybe searched a few things.
          <strong>But what happened next?</strong>
        </p>
        <p>
          Did you know which results mattered, where to start, how to follow through, or whether anything had
          changed when you checked again?
        </p>
      </div>
    </div>

    <div class="s5__stage" data-s5-stage>
      <!-- LAYERS 02–04: the paper stack, the report, the reading lens -->
      <figure class="s5__report">
        <div class="s5__stack" data-s5-stack>
          <span class="s5__under s5__under--b" aria-hidden="true"></span>
          <span class="s5__under s5__under--a" aria-hidden="true"></span>
          <div class="s5__sheet" data-s5-sheet>
            <span class="s5__lens" data-s5-lens aria-hidden="true"></span>
            <header class="s5__doc-head">
              <p class="s5__doc-mark">HUMAN</p>
              <p class="s5__doc-tag">Illustrative document</p>
            </header>
            <p class="s5__doc-title">Health assessment</p>
            <p class="s5__doc-sub">An introduction to understanding your health information.</p>

            <div class="s5__region" data-s5-region="markers">
              <p class="s5__doc-label"><span>Example health markers</span><span>Result</span></p>
              <dl class="s5__rows">
                {
                  markers.map((m) => (
                    <div>
                      <dt>{m.area}</dt>
                      <dd>{m.marker}</dd>
                      <dd class="s5__dash"><span aria-hidden="true">—</span><span class="vh">not shown</span></dd>
                    </div>
                  ))
                }
              </dl>
            </div>
            <div class="s5__region" data-s5-region="context">
              <p class="s5__doc-label"><span>Clinical context</span></p>
              <p class="s5__doc-body">Medical history, symptoms and relevant assessments.</p>
            </div>
            <div class="s5__region" data-s5-region="followup">
              <p class="s5__doc-label"><span>Follow-up</span></p>
              <p class="s5__doc-body">Discuss appropriate next steps with a qualified professional.</p>
            </div>
            <span class="s5__sweep" aria-hidden="true"></span>
          </div>
        </div>
        <figcaption class="note s5__cap">Concept illustration. It contains no values and is not a real report.</figcaption>
      </figure>

      <!-- small screens: the same three states, right under the page, so the report answers without scrolling -->
      <div class="s5__tabs" role="group" aria-label="Choose a question">
        {
          states.map((s) => (
            <button type="button" data-s5-pick={s.key} aria-pressed={s.key === 'matters' ? 'true' : 'false'}>
              <span aria-hidden="true">{s.n}</span>
              {s.short}
            </button>
          ))
        }
      </div>

      <!-- LAYER 06: the interpretation note. One object; its words follow the chosen question. -->
      <aside class="s5__note" data-s5-note aria-live="polite" aria-label="Interpretation">
        <p class="s5__note-thought">What does this mean <em>for me?</em></p>
        <p class="s5__note-eyebrow" data-f="eyebrow">{states[0].eyebrow}</p>
        <p class="s5__note-title" data-f="title">{states[0].title}</p>
        <p class="s5__note-body" data-f="body">{states[0].body}</p>
        <ol class="s5__path" aria-label="From information to follow-through">
          {path.map((s) => <li>{s}</li>)}
        </ol>
      </aside>

      <!-- LAYER 07: the three questions are the controls -->
      <ol class="s5__qs">
        {
          states.map((s) => (
            <li data-s5-q={s.key}>
              <span class="s5__thread" aria-hidden="true" />
              <h3>
                <button type="button" data-s5-pick={s.key} aria-pressed={s.key === 'matters' ? 'true' : 'false'}>
                  <span class="s5__qn" aria-hidden="true">{s.n}</span>
                  <span class="s5__qt">{s.q}</span>
                  <span class="s5__qi" aria-hidden="true" />
                </button>
              </h3>
              <p>{s.a}</p>
            </li>
          ))
        }
      </ol>

      <!-- LAYER 05: decorative only. The lifting fragment and the thread from the page to the note. -->
      <svg class="s5__wire" data-s5-wire aria-hidden="true" focusable="false"><path /><circle r="3" /></svg>
      <span class="s5__frag" data-s5-frag aria-hidden="true"><span></span></span>
    </div>

    <div class="s5__close" data-reveal>
      <p class="s5__close-line">
        Getting information is a start. <em>Understanding it and knowing what to do</em> makes it useful.
      </p>
      <a class="link" href="#scene-06">See how HUMAN is designed to help <span class="arr arr--down" aria-hidden="true">↓</span></a>
    </div>
  </div>
  <script type="application/json" data-s5-data set:html={JSON.stringify(Object.fromEntries(states.map((s) => [s.key, { region: s.region, lift: s.lift, eyebrow: s.eyebrow, title: s.title, body: s.body }])))} />
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-s5]');
  if (sec) {
    type St = { region: string; lift: string; eyebrow: string; title: string; body: string };
    const data = JSON.parse(sec.querySelector('[data-s5-data]')!.textContent!) as Record<string, St>;
    const $ = <T extends Element = HTMLElement>(s: string) => sec.querySelector<T>(s)!;
    const stage = $('[data-s5-stage]');
    const stack = $('[data-s5-stack]');
    const sheet = $('[data-s5-sheet]');
    const lens = $('[data-s5-lens]');
    const note = $('[data-s5-note]');
    const frag = $('[data-s5-frag]');
    const fragText = frag.firstElementChild as HTMLElement;
    const wire = $<SVGSVGElement>('[data-s5-wire]');
    const wirePath = wire.querySelector('path')!;
    const wireDot = wire.querySelector('circle')!;
    const picks = Array.from(sec.querySelectorAll<HTMLButtonElement>('[data-s5-pick]'));
    const regions = Array.from(sec.querySelectorAll<HTMLElement>('[data-s5-region]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wide = window.matchMedia('(min-width: 1100px)');
    const EASE = 'cubic-bezier(.22, 1, .36, 1)';

    // ---------- state ----------
    let active = 'matters';
    let interacted = false; // a deliberate choice has been made: scroll no longer drives anything
    let resolved = false; // the note is out (the intro reached its end, or the visitor chose)
    let introP = 0;
    let version = 0; // latest transition wins
    let running: Animation[] = [];

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ramp = (v: number, a: number, b: number) => clamp((v - a) / (b - a));
    const ease = (t: number) => t * t * (3 - 2 * t);
    const regionOf = (key: string) => regions.find((r) => r.dataset.s5Region === data[key].region)!;

    // How closely each state reads the page. The third pulls back: the page is seen whole again.
    const camScale = (key: string) => (!wide.matches ? 1 : key === 'next' ? 1 : 1.05);

    // The region's box in the sheet's own, untransformed coordinates.
    const local = (key: string) => {
      const r = regionOf(key);
      return { x: 0, y: r.offsetTop, w: sheet.clientWidth, h: r.offsetHeight };
    };
    // The camera: scale the sheet about the middle of the region being read. `amount` 0..1 blends it in.
    const camera = (key: string, amount: number) => {
      const b = local(key);
      const s = 1 + (camScale(key) - 1) * amount;
      const cx = b.w / 2;
      const cy = b.y + b.h / 2;
      return { s, tx: (1 - s) * cx, ty: (1 - s) * cy };
    };
    const applyCamera = (key: string, amount: number, animate: boolean) => {
      const c = camera(key, amount);
      sheet.style.transition = animate && !reduce.matches ? `transform 480ms ${EASE}` : 'none';
      sheet.style.transform = c.s === 1 ? 'none' : `translate3d(${c.tx.toFixed(2)}px, ${c.ty.toFixed(2)}px, 0) scale(${c.s.toFixed(4)})`;
    };
    const placeLens = (key: string, animate: boolean) => {
      const b = local(key);
      lens.style.transition = animate && !reduce.matches ? `top 400ms ${EASE}, height 400ms ${EASE}, opacity 240ms ease` : 'opacity 240ms ease';
      lens.style.top = `${b.y - 9}px`;
      lens.style.height = `${b.h + 18}px`;
    };
    // Where the region will sit on the stage once the camera has settled (computed, so it is right mid-transition).
    const sourceBox = (key: string) => {
      const st = stage.getBoundingClientRect();
      // the stack carries no transform once the page has arrived, so its box is the sheet's resting box
      const sk = stack.getBoundingClientRect();
      const b = local(key);
      const c = camera(key, 1);
      const inset = 14;
      return { x: sk.left - st.left + c.tx + inset * c.s, y: sk.top - st.top + c.ty + (b.y - 9) * c.s, w: (b.w - inset * 2) * c.s, h: (b.h + 18) * c.s };
    };
    const noteBox = () => {
      const st = stage.getBoundingClientRect();
      const n = note.getBoundingClientRect();
      return { x: n.left - st.left, y: n.top - st.top, w: n.width, h: n.height };
    };

    const stop = () => {
      running.forEach((a) => a.cancel());
      running = [];
      frag.style.opacity = '0';
    };
    const setNote = (key: string) => {
      const d = data[key];
      note.querySelector('[data-f="eyebrow"]')!.textContent = d.eyebrow;
      note.querySelector('[data-f="title"]')!.textContent = d.title;
      note.querySelector('[data-f="body"]')!.textContent = d.body;
      note.dataset.for = key;
    };
    const drawWire = (key: string, animate: boolean) => {
      if (!wide.matches) {
        wire.style.opacity = '0';
        return;
      }
      const s = sourceBox(key);
      const n = noteBox();
      const x1 = s.x + s.w;
      const y1 = s.y + s.h / 2;
      const x2 = n.x;
      const y2 = clamp(y1, n.y + 28, n.y + n.h - 28);
      const dx = Math.max(24, (x2 - x1) * 0.5);
      wirePath.setAttribute('d', `M${x1.toFixed(1)} ${y1.toFixed(1)} C${(x1 + dx).toFixed(1)} ${y1.toFixed(1)}, ${(x2 - dx).toFixed(1)} ${y2.toFixed(1)}, ${x2.toFixed(1)} ${y2.toFixed(1)}`);
      wireDot.setAttribute('cx', x1.toFixed(1));
      wireDot.setAttribute('cy', y1.toFixed(1));
      wire.style.opacity = '1';
      const len = wirePath.getTotalLength();
      wirePath.style.strokeDasharray = String(len);
      if (animate && !reduce.matches) running.push(wirePath.animate([{ strokeDashoffset: len }, { strokeDashoffset: 0 }], { duration: 460, delay: 260, easing: EASE, fill: 'backwards' }));
      wirePath.style.strokeDashoffset = '0';
    };

    // The extraction: a strip the size of the lens leaves the page, crosses to the note's place, darkens into it.
    const extract = (key: string, label: string) => {
      const mine = ++version;
      stop();
      const instant = reduce.matches;
      sec.classList.add('is-resolved');
      if (instant) {
        setNote(key);
        note.style.opacity = '1';
        drawWire(key, false);
        return;
      }
      const from = sourceBox(key);
      const to = noteBox();
      fragText.textContent = label;
      note.style.transition = 'opacity 130ms ease';
      note.style.opacity = '0';
      wire.style.opacity = '0';
      const px = (b: { x: number; y: number; w: number; h: number }) => ({ left: `${b.x}px`, top: `${b.y}px`, width: `${b.w}px`, height: `${b.h}px` });
      frag.style.opacity = '1';
      // lift off the page, cross as a strip of paper, and only then darken into the note
      const mid = { x: from.x + (to.x - from.x) * 0.6, y: from.y + (to.y - from.y) * 0.6 - 8, w: from.w + (to.w - from.w) * 0.6, h: from.h + (to.h - from.h) * 0.6 };
      const paper = { backgroundColor: '#fdfbf5', color: '#292d29' };
      const travel = frag.animate(
        [
          { ...px(from), ...paper, boxShadow: '0 1px 2px rgba(41,45,41,.10), 0 0 0 1px rgba(191,150,76,.45)', offset: 0 },
          { ...px({ x: from.x + 6, y: from.y - 10, w: from.w, h: from.h }), ...paper, boxShadow: '0 18px 30px -14px rgba(41,45,41,.38), 0 0 0 1px rgba(191,150,76,.5)', offset: 0.28 },
          { ...px(mid), ...paper, boxShadow: '0 24px 40px -18px rgba(41,45,41,.42), 0 0 0 1px rgba(191,150,76,.4)', offset: 0.68 },
          { ...px(to), backgroundColor: '#292d29', color: '#292d29', boxShadow: '0 26px 44px -22px rgba(41,45,41,.55), 0 0 0 1px rgba(41,45,41,0)', offset: 1 },
        ],
        { duration: 660, easing: 'cubic-bezier(.3, .7, .3, 1)', fill: 'forwards' },
      );
      const words = fragText.animate([{ opacity: 1 }, { opacity: 1, offset: 0.6 }, { opacity: 0, offset: 0.82 }, { opacity: 0 }], { duration: 660, fill: 'forwards' });
      running.push(travel, words);
      travel.finished
        .then(() => {
          if (mine !== version) return; // a newer choice took over
          setNote(key);
          note.style.transition = 'opacity 200ms ease';
          note.style.opacity = '1';
          frag.style.opacity = '0';
          travel.cancel();
          words.cancel();
          drawWire(key, true);
        })
        .catch(() => {});
    };

    const syncControls = () => {
      sec.dataset.active = active;
      picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.s5Pick === active)));
    };

    // Put the page in its interactive resting state for the active question.
    const settle = (animate: boolean) => {
      sec.style.setProperty('--arrive', '1');
      sec.style.setProperty('--part', '1');
      sec.style.setProperty('--lens', '1');
      sec.style.setProperty('--sweep', '2');
      placeLens(active, animate);
      applyCamera(active, 1, animate);
    };
    // A deliberate choice. From here on the visitor, not the scroll position, decides what is shown.
    const choose = (key: string) => {
      const first = !interacted;
      interacted = true;
      resolved = true;
      if (key === active && !first && note.dataset.for === key && note.style.opacity !== '0') return;
      active = key;
      syncControls();
      settle(true);
      extract(key, data[key].lift);
    };

    // ---------- the intro: a short scroll passage, no pin, no added height ----------
    let ticking = false;
    const update = () => {
      ticking = false;
      if (interacted || reduce.matches) return;
      const top = stage.getBoundingClientRect().top;
      const vh = window.innerHeight;
      introP = clamp((vh * 0.94 - top) / (vh * 0.66)); // 0 as the stage enters, 1 once its top is about a quarter down
      sec.style.setProperty('--arrive', ease(ramp(introP, 0, 0.26)).toFixed(4));
      sec.style.setProperty('--part', ease(ramp(introP, 0.2, 0.5)).toFixed(4));
      sec.style.setProperty('--sweep', (ramp(introP, 0.3, 0.62) * 2).toFixed(4));
      sec.style.setProperty('--lens', ramp(introP, 0.62, 0.8).toFixed(4));
      placeLens('matters', false);
      applyCamera('matters', ease(ramp(introP, 0.42, 0.74)), false);
      if (introP >= 0.86 && !resolved) {
        resolved = true;
        extract('matters', 'What does this mean for me?');
      } else if (introP < 0.7 && resolved) {
        // scrolled back before choosing anything: let the passage run in reverse
        resolved = false;
        version++;
        stop();
        sec.classList.remove('is-resolved');
        note.style.transition = 'opacity 160ms ease';
        note.style.opacity = '0';
        wire.style.opacity = '0';
      }
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    let listening = false;
    new IntersectionObserver(
      ([en]) => {
        if (en.isIntersecting && !listening) {
          window.addEventListener('scroll', request, { passive: true });
          listening = true;
        } else if (!en.isIntersecting && listening) {
          window.removeEventListener('scroll', request);
          listening = false;
        }
        request();
      },
      { rootMargin: '30% 0px 30% 0px' },
    ).observe(sec);

    // ---------- layout changes: re-measure, never keep a stale coordinate ----------
    let lastW = 0;
    const relayout = () => {
      const w = stage.clientWidth;
      if (w === lastW) return;
      lastW = w;
      version++;
      stop();
      if (interacted || reduce.matches || resolved) {
        settle(false);
        setNote(active);
        note.style.opacity = '1';
        sec.classList.add('is-resolved');
        drawWire(active, false);
      } else update();
    };
    new ResizeObserver(relayout).observe(stage);
    wide.addEventListener('change', relayout);

    const applyMotionPref = () => {
      sec.classList.add('is-live');
      if (reduce.matches) {
        // no arrival, parting, approach or travelling fragment: the page, the lens and the note are simply there
        resolved = true;
        settle(false);
        setNote(active);
        note.style.opacity = '1';
        sec.classList.add('is-resolved');
        drawWire(active, false);
      } else if (!interacted) {
        note.style.opacity = '0';
        update();
      }
    };
    reduce.addEventListener('change', applyMotionPref);
    applyMotionPref();

    picks.forEach((b) => b.addEventListener('click', () => choose(b.dataset.s5Pick!)));
  }
</script>

<style>
  .s5 {
    /* local materials: paper, ink and one warm accent */
    --s5-paper: #fdfbf5;
    --s5-paper-2: #f4f0e6;
    --s5-ink: #292d29;
    --s5-soft: #6a665d;
    --s5-rule: #d5cec0;
    --s5-amber: #bf964c;
    --s5-champagne: #e2c58b;
    --arrive: 1; /* 0..1 the stack has arrived */
    --part: 1; /* 0..1 the sheets have parted */
    --lens: 1; /* 0..1 the reading lens is present */
    --sweep: 2; /* 0..2 one pass of light across the page */
    --calm: 1; /* how far apart the sheets rest; the third state draws them together */
    overflow: clip;
  }
  .s5[data-active='next'] {
    --calm: 0.45;
  }
  .s5__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    align-items: end;
  }
  .s5__head > .eyebrow,
  .s5__head > h2 {
    grid-column: 1 / span 7;
  }
  .s5__head h2 {
    margin: var(--stack-label) 0 0;
  }
  .s5__intro {
    grid-column: 8 / span 5;
    grid-row: 2;
  }

  /* ---- the stage: page · note · questions ---- */
  .s5__stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: 32px;
    align-items: center;
    margin-top: clamp(56px, 7vw, 104px);
    isolation: isolate;
  }
  /* LAYER 01: a patch of warm studio light behind the page */
  .s5__stage::before {
    content: '';
    position: absolute;
    left: -6%;
    top: -8%;
    width: 58%;
    height: 116%;
    background: radial-gradient(60% 55% at 42% 40%, rgba(255, 252, 244, 0.85), rgba(255, 252, 244, 0) 72%);
    opacity: calc(0.35 + var(--arrive) * 0.65);
    pointer-events: none;
    z-index: -1; /* light falls behind the page and the controls, never over them */
  }
  .s5__report {
    grid-column: 1 / span 5;
    position: relative;
    perspective: 1400px;
  }
  /* LAYER 02: the stack arrives as one object, then its sheets part */
  .s5__stack {
    position: relative;
    transform: translate3d(0, calc((1 - var(--arrive)) * 38px), 0) rotateX(calc((1 - var(--arrive)) * 7deg)) rotate(calc((1 - var(--arrive)) * -1.6deg)) scale(calc(0.955 + var(--arrive) * 0.045));
    transform-origin: 50% 70%;
    opacity: calc(0.25 + var(--arrive) * 0.75);
  }
  .s5__under {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background:
      repeating-linear-gradient(180deg, transparent 0 34px, rgba(41, 45, 41, 0.045) 34px 35px),
      linear-gradient(180deg, #f8f5ec, var(--s5-paper-2));
    border: 1px solid rgba(41, 45, 41, 0.07);
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .s5__under--a {
    transform: translate3d(calc(var(--part) * var(--calm) * 22px), calc(var(--part) * var(--calm) * 16px), 0) rotate(calc(var(--part) * var(--calm) * 2.3deg));
    box-shadow: 0 10px 22px -14px rgba(41, 45, 41, 0.3);
  }
  .s5__under--b {
