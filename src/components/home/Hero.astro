---
import { getImage } from 'astro:assets';
import d1672 from '../../assets/hero/hero-desktop-1672.webp';
import d1100 from '../../assets/hero/hero-desktop-1100.webp';
import m800 from '../../assets/hero/hero-mobile-800.webp';
const big = await getImage({ src: d1672, format: 'webp', quality: 84 });
const mid = await getImage({ src: d1100, format: 'webp', quality: 80 });
const mob = await getImage({ src: m800, format: 'webp', quality: 82 });
---

<link rel="preload" as="image" href={mob.src} media="(max-width: 599px)" slot="head" />
<section class="hero on-dark" id="top" aria-labelledby="hero-title" data-progress data-reveal-eager>
  <!-- HERO-DESKTOP-POSTER / HERO-MOBILE-POSTER: candidate still, text-free. Alt is empty: the image is atmosphere, not information. -->
  <picture class="hero__media">
    <source media="(max-width: 599px)" srcset={mob.src} width="800" height="941" />
    <source srcset={`${mid.src} 1100w, ${big.src} 1672w`} sizes="100vw" />
    <img src={big.src} width="1672" height="941" alt="" fetchpriority="high" decoding="async" />
  </picture>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow no-rule hero__eyebrow" data-reveal style="--d:120ms">
        <span>The invisible side of your health</span>
      </p>
      <h1 class="hero__title" id="hero-title" data-reveal="mask" style="--d:200ms">
        <span class="mask"><span class="hero__l1">How well do you</span></span>
        <span class="mask" style="--i:1"><span class="hero__l2">know your health?</span></span>
      </h1>
      <p class="hero__support" data-reveal style="--d:520ms">
        There’s more to your health than what you can see. We’re building a more connected way to understand it.
      </p>
      <div class="hero__actions" data-reveal="fade" style="--d:620ms">
        <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
        <a class="link" href="#scene-01">Explore the story <span class="arr" aria-hidden="true">↓</span></a>
      </div>
      <span class="hero__thread" aria-hidden="true" data-reveal="rule" style="--d:820ms"></span>
      <div class="hero__meta" data-reveal="fade" style="--d:760ms">
        <span class="status-pill">In development</span>
        <p class="note">
          Not available yet. First pilot planned for Delhi NCR.
          <a class="text-link" href="#scene-06">What is HUMAN? Skip to how it works</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    padding-top: var(--header-h);
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% 22%;
  }
  /* H-09: the still recedes very slightly as the hero scrolls away (transform only). */
  :global(.js-motion) .hero__media img {
    transform: scale(calc(1.03 - var(--p, 0) * 0.03));
    transform-origin: 75% 30%;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(11, 13, 15, 0.96) 0%, rgba(11, 13, 15, 0.86) 30%, rgba(11, 13, 15, 0.25) 56%, rgba(11, 13, 15, 0) 72%),
      linear-gradient(0deg, rgba(11, 13, 15, 1) 0%, rgba(11, 13, 15, 0) 22%);
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    padding-block: 48px 72px;
  }
  .hero__copy {
    max-width: min(46%, 660px);
  }
  .hero__title {
    margin: 22px 0 26px;
    line-height: 0.95;
    width: max-content;
    max-width: none;
  }
  .hero__l1 {
    font-weight: 700;
    font-size: clamp(2.3rem, 4.45vw, 5.2rem);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .hero__l2 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.7rem, 5.3vw, 6.1rem);
    letter-spacing: -0.015em;
    line-height: 1;
    white-space: nowrap;
  }
  .hero__support {
    font-size: clamp(1.0625rem, 1.35vw, 1.3rem);
    line-height: 1.5;
    max-width: 27em;
    color: var(--text-on-dark);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 30px;
    margin-top: 34px;
  }
  .hero__thread {
    display: block;
    width: 64px;
    height: 1px;
    background: var(--amber);
    margin-top: 36px;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 18px;
  }
  .hero__meta .note {
    max-width: 30em;
  }
  .hero__meta .text-link {
    display: inline-block;
    padding-block: 4px;
    color: var(--text-on-dark);
  }

  /* Compact desktop: push the subjects right so the copy keeps a clean dark zone. */
  @media (max-width: 1279px) {
    .hero__copy {
      max-width: 46%;
    }
    .hero__media img {
      object-position: 72% 22%;
    }
    .hero__l1 {
      font-size: 4.1vw;
    }
    .hero__l2 {
      font-size: 4.9vw;
    }
    .hero__support {
      max-width: 21em;
    }
  }

  /* Tablet and mobile: recomposed, not shrunk (C07). Image band on top, copy below on solid carbon,
     so text never sits on a face. Phones get the dedicated portrait crop; tablets the full 16:9 still. */
  @media (max-width: 1023px) {
    .hero {
      display: block;
      min-height: 0;
      padding-top: 0;
    }
    .hero__media {
      position: relative;
      inset: auto;
      display: block;
      height: min(40svh, 100vw);
    }
    .hero__media img {
      object-position: 50% 10%;
    }
    .hero__copy,
    .hero__support {
      max-width: 34em;
    }
    :global(.js-motion) .hero__media img {
      transform: none;
    }
    .hero__scrim {
      inset: 0 0 auto 0;
      height: min(40svh, 100vw);
      background:
        linear-gradient(0deg, rgba(11, 13, 15, 1) 0%, rgba(11, 13, 15, 0) 42%),
        linear-gradient(180deg, rgba(11, 13, 15, 0.7) 0%, rgba(11, 13, 15, 0) 26%);
    }
    .hero__inner {
      margin-top: -64px;
      padding-block: 0 44px;
    }
    .hero__copy {
      max-width: none;
    }
    .hero__title {
      margin: 14px 0 16px;
    }
    .hero__l1 {
      font-size: min(9.6vw, 3.2rem); /* vw-led so the locked one-line break survives 200% text size */
    }
    .hero__l2 {
      font-size: min(11.2vw, 3.7rem);
    }
    .hero__actions {
      margin-top: 22px;
    }
    .hero__actions .btn {
      flex: 1 1 100%;
    }
    .hero__thread {
      display: none;
    }
    .hero__meta {
      margin-top: 20px;
    }
    .hero__title {
      width: auto;
    }
  }
  @media (min-width: 600px) and (max-width: 1023px) {
    .hero__media,
    .hero__scrim {
      height: min(52svh, 62vw);
    }
    .hero__media img {
      object-position: 80% 20%;
    }
    .hero__l1 {
      font-size: min(7.4vw, 4.2rem);
    }
    .hero__l2 {
      font-size: min(8.6vw, 4.9rem);
    }
    .hero__actions .btn {
      flex: 0 0 auto;
    }
  }
</style>
