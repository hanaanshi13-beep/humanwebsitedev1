---
// INSIDE HUMAN — the homepage opening.
// The word HUMAN is five photographic windows (custom SVG letterforms, one still photograph each). Scrolling
// moves the photographs inside their letters, then carries the camera through the M into its eye photograph,
// toward the pupil, and out into the dark ground of the next section.
//
// How it is built, and why:
//   • One SVG holds everything. The "camera" is the SVG's viewBox, recomputed from scroll progress, so the
//     artwork is always drawn sharp at its current size and every letter, clip and photograph shares one
//     coordinate system. There is no second copy of the eye: the same <image> that sits inside the M becomes
//     the full-screen picture. The M's clip is the letter plus a circle centred on the pupil; the circle only
//     opens once the camera is deep inside the solid part of the letter, so nothing jumps.
//   • Everything is a pure function of scroll progress: reversible, repeatable, no timers, no scroll hijacking.
//   • Photographs only. Nothing inside any photograph is animated; the movement is framing.
//   • Without JavaScript, or with reduced motion, the hero is simply the still composition in normal page flow.
//
// The people shown are models in a brand campaign, not HUMAN members, and the eye is a picture, not a scan.
import { getImage } from 'astro:assets';
import pH from '../../assets/inside-human/inside-human-01-h-run-club.webp';
import pU from '../../assets/inside-human/inside-human-02-u-female.webp';
import pM from '../../assets/inside-human/inside-human-03-m-eye.webp';
import pA from '../../assets/inside-human/inside-human-04-a-couple.webp';
import pN from '../../assets/inside-human/inside-human-05-n-mature-man.jpg';

const opt = (src: ImageMetadata, width: number, quality = 84) => getImage({ src, width: Math.min(width, src.width), format: 'webp', quality });
// Letter geometry and photo placement from the approved composition (each letter is 100 × 150 units).
// `focus` is the point the photograph's own slow move is centred on, in the letter's units.
const letters = [
  { k: 'h', x: 0, d: 'M0 0H34V58H66V0H100V150H66V91H34V150H0Z', img: await opt(pH, 1122), box: [-10, 0, 120, 150], focus: [50, 62] },
  { k: 'u', x: 107.5, d: 'M0 0H36V103Q36 117 50 117Q64 117 64 103V0H100V104Q100 150 50 150Q0 150 0 104Z', img: await opt(pU, 1122), box: [-24, -8, 128, 160], focus: [20, 44] },
  { k: 'm', x: 215, d: 'M0 0H36L50 45L64 0H100V150H69V85L50 122L31 85V150H0Z', img: await opt(pM, 1122, 88), box: [-15, -4, 130, 162.5], focus: [55.6, 66.4] },
  { k: 'a', x: 322.5, d: 'M28 0H72L100 150H66L60 115H40L34 150H0Z M50 52L42 87H58Z', img: await opt(pA, 1122), box: [-11, 0, 122, 152.5], focus: [50, 55] },
  { k: 'n', x: 430, d: 'M0 0H32L67 71V0H100V150H68L33 79V150H0Z', img: await opt(pN, 1200), box: [-1, -11, 148, 184], focus: [84, 46] },
];
---

{letters.map((l) => <link rel="preload" as="image" href={l.img.src} slot="head" />)}
<section class="hero ih" id="top" aria-labelledby="hero-title" data-ih data-reveal-eager>
  <div class="ih__track" data-ih-track>
    <div class="ih__stage" data-ih-stage>
      <div class="ih__flow">
        <p class="eyebrow no-rule ih__eyebrow" data-ih-fade>
          <span>The invisible side of your health</span>
        </p>

        <!-- the slot reserves the wordmark's place in the layout; in the film the artwork fills the whole stage -->
        <div class="ih__slot" data-ih-slot>
          <svg
            class="ih__art"
            data-ih-art
            viewBox="0 0 530 150"
            preserveAspectRatio="xMidYMid slice"
            role="img"
            aria-label="The word HUMAN in very large letters. Each letter is a window onto a photograph: runners sharing a high-five, a young woman, a close-up of an eye, a couple laughing, and an older man at home."
          >
            <defs>
              {
                letters.map((l) => (
                  <clipPath id={`ih-clip-${l.k}`}>
                    <path d={l.d} clip-rule="evenodd" />
                    {l.k === 'm' && <circle data-ih-open cx={l.focus[0]} cy={l.focus[1]} r="0" />}
                  </clipPath>
                ))
              }
            </defs>
            {
              letters.map((l) => (
                <g transform={`translate(${l.x} 0)`} clip-path={`url(#ih-clip-${l.k})`} data-ih-letter={l.k}>
                  <rect x={l.box[0]} y={l.box[1]} width={l.box[2]} height={l.box[3]} fill="#2b2622" />
                  <g data-ih-photo={l.k} data-fx={l.focus[0]} data-fy={l.focus[1]}>
                    <image href={l.img.src} x={l.box[0]} y={l.box[1]} width={l.box[2]} height={l.box[3]} preserveAspectRatio="xMidYMid slice" />
                  </g>
                </g>
              ))
            }
          </svg>
        </div>

        <div class="ih__below" data-ih-fade>
          <h1 class="hero__title" id="hero-title">
            <span class="hero__l1">How well do you</span>
            <span class="hero__l2">know your health?</span>
          </h1>
          <div class="ih__side">
            <p class="hero__support">
              There’s more to your health than what you can see. We’re building a more connected way to understand it.
            </p>
            <div class="hero__actions">
              <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
              <a class="link" href="#scene-01">Explore the story <span class="arr arr--down" aria-hidden="true">↓</span></a>
            </div>
            <div class="hero__meta">
              <span class="status-pill">In development</span>
              <p class="note">
                A preventive-health membership being built in India. Not available yet.
                <a class="text-link" href="#scene-06">How it works</a>
              </p>
            </div>
          </div>
        </div>
      </div>

      <span class="ih__dark" data-ih-dark aria-hidden="true"></span>
      <button type="button" class="ih__skip" data-ih-skip>Skip intro</button>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-ih]');
  const track = sec?.querySelector<HTMLElement>('[data-ih-track]');
  const stage = sec?.querySelector<HTMLElement>('[data-ih-stage]');
  if (sec && track && stage) {
    const art = sec.querySelector<SVGSVGElement>('[data-ih-art]')!;
    const slot = sec.querySelector<HTMLElement>('[data-ih-slot]')!;
    const open = sec.querySelector<SVGCircleElement>('[data-ih-open]')!;
    const dark = sec.querySelector<HTMLElement>('[data-ih-dark]')!;
    const skip = sec.querySelector<HTMLButtonElement>('[data-ih-skip]')!;
    const fades = Array.from(sec.querySelectorAll<HTMLElement>('[data-ih-fade]'));
    const photo = Object.fromEntries(Array.from(sec.querySelectorAll<SVGGElement>('[data-ih-photo]')).map((g) => [g.dataset.ihPhoto!, g]));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ramp = (v: number, a: number, b: number) => clamp((v - a) / (b - a));
    const ease = (t: number) => t * t * (3 - 2 * t);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const key = (p: number, ks: number[][]) => {
      if (p <= ks[0][0]) return ks[0][1];
      for (let i = 1; i < ks.length; i++) if (p <= ks[i][0]) return lerp(ks[i - 1][1], ks[i][1], ease((p - ks[i - 1][0]) / (ks[i][0] - ks[i - 1][0])));
      return ks[ks.length - 1][1];
    };

    // The pupil, in artwork units: M sits at x = 215; the pupil is at (55.6, 66.4) inside it (measured on the photograph).
    const PX = 215 + 55.6;
    const PY = 66.4;
    const PUPIL_R = 6; // pupil radius in artwork units
    // From the pupil, the nearest edges of the M are its top notch and its lower V, both about 22 units away,
    // so a circle of up to 20 units around the pupil lies wholly inside the letter and can open unseen.
    const SAFE_R = 20;

    // geometry of the still composition, measured once per layout
    let vw = 0;
    let vh = 0;
    let u0 = 1; // px per artwork unit at rest
    let cx0 = 265;
    let cy0 = 75;
    const measure = () => {
      const st = stage.getBoundingClientRect();
      const sl = slot.getBoundingClientRect();
      vw = st.width;
      vh = st.height;
      u0 = sl.width / 530;
      cx0 = 265 + (vw / 2 - (sl.left - st.left + sl.width / 2)) / u0;
      cy0 = (vh / 2 - (sl.top - st.top)) / u0;
    };

    // one still photograph, reframed: scale about a point of interest, plus a small drift
    const frame = (k: string, scale: number, tx = 0, ty = 0) => {
      const g = photo[k];
      const fx = Number(g.dataset.fx);
      const fy = Number(g.dataset.fy);
      g.setAttribute('transform', `translate(${(fx + tx).toFixed(3)} ${(fy + ty).toFixed(3)}) scale(${scale.toFixed(4)}) translate(${-fx} ${-fy})`);
    };

    let lastHidden = false;
    const render = (p: number) => {
      // ---- ACT II: five living photographs (each with its own timing, direction and amount) ----
      frame('h', 1 + 0.05 * ease(ramp(p, 0.1, 0.3)), -1.6 * ease(ramp(p, 0.12, 0.32)));
      frame('u', 1 + 0.07 * ease(ramp(p, 0.13, 0.33)));
      frame('m', 1 + 0.1 * ease(ramp(p, 0.14, 0.4)));
      frame('a', 1 + 0.035 * ease(ramp(p, 0.11, 0.31)), 2.2 * ease(ramp(p, 0.11, 0.32)));
      frame('n', 1 + 0.045 * ease(ramp(p, 0.15, 0.34)));

      // ---- the camera: how many pixels one artwork unit takes, and what it is centred on ----
      // deep inside the M the screen shows about 52 units of height: the solid band of the letter around the pupil
      // (on a tall phone that would crop to the iris alone, so there the eye is framed by its width instead)
      const sIn = vw > vh ? Math.max(vh / 52, vw / 96) : vw / 42;
      const s = key(p, [[0, u0], [0.32, u0], [0.48, u0 * 1.9], [0.64, sIn], [0.74, sIn * 1.06], [0.94, sIn * 1.7]]);
      const toPupil = key(p, [[0.32, 0], [0.5, 0.6], [0.6, 1]]);
      const cx = lerp(cx0, PX, toPupil);
      const cy = lerp(cy0, PY, toPupil);
      const w = vw / s;
      const h = vh / s;
      art.setAttribute('viewBox', `${(cx - w / 2).toFixed(3)} ${(cy - h / 2).toFixed(3)} ${w.toFixed(3)} ${h.toFixed(3)}`);

      // ---- ACT IV: the letter lets go of the photograph ----
      // The opening starts inside the solid letter (invisible), and only grows past the letter's edges once the
      // camera is close enough that what is left of them is a sliver at the top and bottom of the frame.
      const opening = ease(ramp(p, 0.55, 0.67));
      const cover = Math.hypot(w, h) / 2 + 6;
      open.setAttribute('r', p < 0.5 ? '0' : lerp(SAFE_R, Math.max(SAFE_R, cover), opening).toFixed(2));

      // ---- ACT V–VI: the pupil widens into the dark ground of the next section ----
      // The dark starts as the pupil's own size and shape, with a soft edge like the pupil's, and the rest of the
      // picture dims with it, so it reads as the eye's own darkness spreading rather than a disc laid on top.
      const dk = ease(ramp(p, 0.78, 0.97));
      const r0 = PUPIL_R * 1.1 * s;
      const r = lerp(r0, Math.hypot(vw, vh) * 0.75, dk * dk);
      const around = Math.min(1, dk * 1.25);
      dark.style.opacity = ramp(p, 0.76, 0.8).toFixed(3);
      dark.style.background = `radial-gradient(circle at 50% 50%, #0b0d0f 0, #0b0d0f ${(r * 0.72).toFixed(1)}px, rgba(11,13,15,${(0.55 + 0.45 * around).toFixed(3)}) ${(r * 1.05).toFixed(1)}px, rgba(11,13,15,${(around * 0.9).toFixed(3)}) ${(r * 1.7 + 40).toFixed(1)}px, rgba(11,13,15,${around.toFixed(3)}) 100%)`;

      // ---- ACT III: the editorial layer leaves as the camera passes it ----
      const out = ease(ramp(p, 0.22, 0.335));
      fades.forEach((el) => {
        el.style.opacity = (1 - out).toFixed(3);
        el.style.transform = out ? `translate3d(0, ${(-out * 36).toFixed(1)}px, 0)` : '';
      });
      const hidden = out > 0.95;
      if (hidden !== lastHidden) {
        lastHidden = hidden;
        fades.forEach((el) => (el.inert = hidden)); // nothing invisible stays in the tab order
      }
      skip.style.opacity = (1 - ramp(p, 0.9, 0.97)).toFixed(3);
      skip.inert = p > 0.95;
      sec.dataset.ihAct = String(p < 0.12 ? 1 : p < 0.32 ? 2 : p < 0.48 ? 3 : p < 0.7 ? 4 : p < 0.9 ? 5 : 6);
    };

    let film = false;
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!film) return;
      const span = track.offsetHeight - stage.offsetHeight;
      const p = span > 8 ? clamp(-track.getBoundingClientRect().top / span) : 0;
      sec.style.setProperty('--p', p.toFixed(4));
      render(p);
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    let listening = false;
    new IntersectionObserver(
      ([en]) => {
        if (en.isIntersecting && !listening) {
          window.addEventListener('scroll', request, { passive: true });
          listening = true;
        } else if (!en.isIntersecting && listening) {
          window.removeEventListener('scroll', request);
          listening = false;
        }
        request();
      },
      { rootMargin: '20% 0px 20% 0px' },
    ).observe(sec);

    const still = () => {
      // put the artwork back exactly as authored
      art.setAttribute('viewBox', '0 0 530 150');
      open.setAttribute('r', '0');
      Object.values(photo).forEach((g) => g.removeAttribute('transform'));
      dark.style.opacity = '0';
      fades.forEach((el) => {
        el.style.opacity = '';
        el.style.transform = '';
        el.inert = false;
      });
    };
    const start = () => {
      film = !reduce.matches;
      if (!film) {
        sec.classList.remove('is-film');
        still();
        return;
      }
      // measure the still layout first (the slot is where the wordmark rests), then let the artwork fill the stage
      sec.classList.remove('is-film');
      art.setAttribute('viewBox', '0 0 530 150');
      sec.classList.add('is-measuring');
      measure();
      sec.classList.remove('is-measuring');
      sec.classList.add('is-film');
      update();
    };
    let lastW = 0;
    let lastH = 0;
    new ResizeObserver(() => {
      // ignore the small height changes of a phone's collapsing address bar; re-measure on real layout changes
      const w = window.innerWidth;
      const h = window.innerHeight;
      if (w === lastW && Math.abs(h - lastH) < 120) return;
      lastW = w;
      lastH = h;
      start();
    }).observe(document.documentElement);
    reduce.addEventListener('change', start);
    document.fonts?.ready.then(start);
    start();

    // Skip: straight to the next real section, focus placed there.
    skip.addEventListener('click', () => {
      const next = document.querySelector<HTMLElement>('[data-ih] ~ section');
      window.scrollTo({ top: track.getBoundingClientRect().top + window.scrollY + track.offsetHeight, behavior: 'instant' });
      if (next) {
        next.setAttribute('tabindex', '-1');
        next.focus({ preventScroll: true });
      }
    });
  }
</script>

<style>
  .ih {
    --ih-ivory: #f2eee6;
    --ih-ink: #252923;
    position: relative;
    background: var(--ih-ivory);
    color: var(--ih-ink);
    --text: var(--ih-ink);
    --muted: #55584f;
    --rule: rgba(37, 41, 35, 0.18);
    --accent: var(--amber-deep);
  }
  .ih__stage {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + 10px) clamp(14px, 3vw, 44px) 26px;
  }
  .ih__flow {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1550px;
    margin-inline: auto;
    display: grid;
    gap: clamp(14px, 2.2vh, 26px);
  }
  .ih__eyebrow {
    color: var(--ih-ink);
  }
  /* the wordmark: almost the full width of the screen, limited only so the headline still fits beneath it */
  .ih__slot {
    position: relative;
    width: min(100%, calc((100svh - var(--header-h) - 300px) * 530 / 150));
    aspect-ratio: 530 / 150;
    margin-inline: auto;
  }
  .ih__art {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .ih__below {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 16px clamp(24px, 5vw, 88px);
    align-items: end;
  }
  .hero__title {
    display: grid;
    line-height: 0.96;
  }
  .hero__l1 {
    font-weight: 700;
    font-size: clamp(2rem, 4.5vw, 4.5rem);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .hero__l2 {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.35rem, 5.2vw, 5.2rem);
    letter-spacing: -0.015em;
    line-height: 1;
  }
  .ih__side {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding-bottom: 0.4rem;
  }
  .hero__support {
    max-width: 30em;
    font-size: clamp(1rem, 1.25vw, 1.1875rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 28px;
  }
  .ih .btn {
    --btn-border: #a9781f; /* the amber button's edge on a light ground */
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .hero__meta .note {
    max-width: 34em;
    color: var(--muted);
  }
  .hero__meta .text-link {
    margin-left: 4px;
    padding-block: 10px;
    color: var(--ih-ink);
    font-weight: 600;
    white-space: nowrap;
  }
  .ih__dark,
  .ih__skip {
    display: none;
  }

  /* ---- the film: a bounded scroll track with one sticky stage. Applied only once the script is running. ---- */
  .ih:global(.is-film) .ih__track {
    height: 380vh;
    height: 380svh;
  }
  .ih:global(.is-film) .ih__stage,
  .ih:global(.is-measuring) .ih__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  /* in the film the artwork leaves its slot and fills the stage; the slot keeps its place in the layout */
  .ih:global(.is-film) .ih__slot {
    position: static;
  }
  .ih:global(.is-film) .ih__flow {
    position: static;
  }
  .ih:global(.is-film) .ih__art {
    z-index: 0;
  }
  .ih:global(.is-film) [data-ih-fade] {
    position: relative;
    z-index: 2;
    will-change: opacity, transform;
  }
  .ih:global(.is-film) .ih__dark {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 3;
    opacity: 0;
    pointer-events: none;
  }
  .ih:global(.is-film) .ih__skip {
    display: inline-flex;
    align-items: center;
    position: absolute;
    right: clamp(14px, 3vw, 44px);
    bottom: 4px;
    z-index: 4;
    min-height: 44px;
    padding: 0 6px;
    border: 0;
    background: none;
    color: inherit;
    font-size: var(--fs-note);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    mix-blend-mode: difference;
    color: #d9d5cc;
  }
  .ih__skip:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  /* ---- the site header over the ivory opening: dark type until its own dark shell appears on scroll ---- */
  :global(body:has(.ih) .site-header:not(.is-solid)) {
    color: #252923;
  }
  :global(body:has(.ih) .site-header:not(.is-solid) .nav a:not(.btn)) {
    color: rgba(37, 41, 35, 0.78);
  }
  :global(body:has(.ih) .site-header:not(.is-solid) .nav a:not(.btn):hover) {
    color: #252923;
  }
  :global(body:has(.ih) .site-header:not(.is-solid) .menu-btn) {
    color: #252923;
    border-color: rgba(37, 41, 35, 0.3);
    background: rgba(37, 41, 35, 0.04);
  }

  /* ---- phones and narrow screens: the whole word still spans the screen; the text stacks beneath it ---- */
  @media (max-width: 899px) {
    .ih__stage {
      padding-top: calc(var(--header-h) + 6px);
    }
    .ih__flow {
      gap: 26px;
    }
    .ih__slot {
      width: 100%;
    }
    .ih__below {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .hero__l1 {
      font-size: min(9.4vw, 3.2rem);
    }
    .hero__l2 {
      font-size: min(11vw, 3.7rem);
    }
    .hero__actions .btn {
      flex: 1 1 100%;
    }
    .ih:global(.is-film) .ih__track {
      height: 300vh;
      height: 300svh;
    }
  }
</style>
