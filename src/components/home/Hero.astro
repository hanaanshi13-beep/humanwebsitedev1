---
// INSIDE HUMAN — the homepage opening.
// The word HUMAN is five photographic windows (custom SVG letterforms, one still photograph each). Scrolling
// moves the photographs inside their letters, then carries the camera through the M into its eye photograph,
// toward the pupil, and out into the dark ground of the next section.
//
// How it is built, and why:
//   • One SVG holds everything. The "camera" is the SVG's viewBox, recomputed from scroll progress, so the
//     artwork is always drawn sharp at its current size and every letter, clip and photograph shares one
//     coordinate system. There is no second copy of the eye: the same <image> that sits inside the M becomes
//     the full-screen picture. The M's clip is the letter plus a circle centred on the pupil; the circle only
//     opens once the camera is deep inside the solid part of the letter, so nothing jumps.
//   • Everything is a pure function of scroll progress: reversible, repeatable, no timers, no scroll hijacking.
//   • Photographs only. Nothing inside any photograph is animated; the movement is framing.
//   • Without JavaScript, or with reduced motion, the hero is simply the still composition in normal page flow.
//
// The people shown are models in a brand campaign, not HUMAN members, and the eye is a picture, not a scan.
import { getImage } from 'astro:assets';
import pH from '../../assets/portal/originals/A01-blood-tube.webp'; // the HUMAN blood tube: bloodwork from the first letter
import pU from '../../assets/inside-human/inside-human-02-u-female.webp';
import pM from '../../assets/inside-human/inside-human-03-m-eye.webp';
import pA from '../../assets/inside-human/inside-human-04-a-couple.webp';
import pN from '../../assets/inside-human/inside-human-05-n-mature-man.jpg';

const opt = (src: ImageMetadata, width: number, quality = 84) => getImage({ src, width: Math.min(width, src.width), format: 'webp', quality });
// Letter geometry and photo placement from the approved composition (each letter is 100 × 150 units).
// `focus` is the point the photograph's own slow move is centred on, in the letter's units.
// `rot` (optional) turns the photograph inside its letter: [degrees, centre x, centre y].
// H: the tube runs corner to corner — cap in the upper-left stem, label across the crossbar, blood in the lower-right.
// `back` is the colour behind the photograph; `grade` warms and deepens a pale photo; `feather` softens the edges
// of a turned photograph into `back` (H: turned so the whole word HUMAN on the label lies along the crossbar).
type Letter = { k: string; x: number; d: string; img: Awaited<ReturnType<typeof opt>>; box: number[]; focus: number[]; rot?: number[]; back?: string; grade?: boolean; feather?: boolean };
const letters: Letter[] = [
  { k: 'h', x: 0, d: 'M0 0H34V58H66V0H100V150H66V91H34V150H0Z', img: await opt(pH, 1086, 86), box: [-14.25, -10.5, 135.75, 181], focus: [54, 74.5], rot: [-52, 54, 74.5], back: '#c9ae89', grade: true, feather: true },
  { k: 'u', x: 107.5, d: 'M0 0H36V103Q36 117 50 117Q64 117 64 103V0H100V104Q100 150 50 150Q0 150 0 104Z', img: await opt(pU, 1122), box: [-24, -8, 128, 160], focus: [20, 44] },
  { k: 'm', x: 215, d: 'M0 0H36L50 45L64 0H100V150H69V85L50 122L31 85V150H0Z', img: await opt(pM, 1122, 88), box: [-15, -4, 130, 162.5], focus: [55.6, 66.4] },
  { k: 'a', x: 322.5, d: 'M28 0H72L100 150H66L60 115H40L34 150H0Z M50 52L42 87H58Z', img: await opt(pA, 1122), box: [-11, 0, 122, 152.5], focus: [50, 55] },
  { k: 'n', x: 430, d: 'M0 0H32L67 71V0H100V150H68L33 79V150H0Z', img: await opt(pN, 1200), box: [-1, -11, 148, 184], focus: [84, 46] },
];
---

{letters.map((l) => <link rel="preload" as="image" href={l.img.src} slot="head" />)}
<section class="hero ih" id="top" aria-labelledby="hero-title" data-ih data-reveal-eager>
  <div class="ih__track" data-ih-track>
    <div class="ih__stage" data-ih-stage>
      <div class="ih__flow">
        <p class="eyebrow no-rule ih__eyebrow" data-ih-fade>
          <span>The invisible side of your health</span>
        </p>

        <!-- the slot reserves the wordmark's place in the layout; in the film the artwork fills the whole stage -->
        <div class="ih__slot" data-ih-slot>
          <svg
            class="ih__art"
            data-ih-art
            viewBox="0 0 530 150"
            preserveAspectRatio="xMidYMid slice"
            role="img"
            aria-label="The word HUMAN in very large letters. Each letter is a window onto a photograph: a HUMAN blood collection tube with a burgundy cap, a young woman, a close-up of an eye, a couple laughing, and an older man at home."
          >
            <defs>
              {/* the tube's cream studio backdrop is far paler than the other four photographs: a gentle warm grade
                  brings the H into the same tonal family without touching its reds */}
              <filter id="ih-grade" color-interpolation-filters="sRGB">
                <feColorMatrix type="matrix" values="0.86 0 0 0 0  0 0.8 0 0 0  0 0 0.7 0 0  0 0 0 1 0" />
              </filter>
              {
                letters
                  .filter((l) => l.feather)
                  .map((l) => (
                    <mask id={`ih-feather-${l.k}`} maskUnits="userSpaceOnUse" x={l.box[0] - 20} y={l.box[1] - 20} width={l.box[2] + 40} height={l.box[3] + 40}>
                      <filter id={`ih-soft-${l.k}`} x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="5" />
                      </filter>
                      <rect x={l.box[0] + 8} y={l.box[1] + 8} width={l.box[2] - 16} height={l.box[3] - 16} fill="#fff" filter={`url(#ih-soft-${l.k})`} />
                    </mask>
                  ))
              }
              {
                letters.map((l) => (
                  <clipPath id={`ih-clip-${l.k}`}>
                    <path d={l.d} clip-rule="evenodd" />
                    {l.k === 'm' && <circle data-ih-open cx={l.focus[0]} cy={l.focus[1]} r="0" />}
                  </clipPath>
                ))
              }
            </defs>
            {
              letters.map((l) => (
                <g transform={`translate(${l.x} 0)`} clip-path={`url(#ih-clip-${l.k})`} data-ih-letter={l.k}>
                  <rect x={l.box[0]} y={l.box[1]} width={l.box[2]} height={l.box[3]} fill={l.back ?? '#2b2622'} />
                  <g data-ih-photo={l.k} data-fx={l.focus[0]} data-fy={l.focus[1]}>
                    <image href={l.img.src} x={l.box[0]} y={l.box[1]} width={l.box[2]} height={l.box[3]} preserveAspectRatio="xMidYMid slice" transform={l.rot ? `rotate(${l.rot.join(' ')})` : undefined} filter={l.grade ? 'url(#ih-grade)' : undefined} mask={l.feather ? `url(#ih-feather-${l.k})` : undefined} />
                  </g>
                </g>
              ))
            }
          </svg>
        </div>

        <h1 class="hero__title" id="hero-title" data-ih-fade>
          <span class="hero__l1">How well do you</span>
          <span class="hero__l2">know your health?</span>
        </h1>
      </div>

      <span class="ih__dark" data-ih-dark aria-hidden="true"></span>
      <!-- the one control on the opening screen; its own layer, never inside the camera -->
      <div class="ih__next" data-ih-next>
        <a class="ih__arrow" href="#what-is-human" data-ih-go aria-label="Continue to the next section">
          <span class="ih__halo" aria-hidden="true"></span>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M12 4.5v14.2M6.4 13.3 12 18.9l5.6-5.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-ih]');
  const track = sec?.querySelector<HTMLElement>('[data-ih-track]');
  const stage = sec?.querySelector<HTMLElement>('[data-ih-stage]');
  if (sec && track && stage) {
    const art = sec.querySelector<SVGSVGElement>('[data-ih-art]')!;
    const slot = sec.querySelector<HTMLElement>('[data-ih-slot]')!;
    const open = sec.querySelector<SVGCircleElement>('[data-ih-open]')!;
    const dark = sec.querySelector<HTMLElement>('[data-ih-dark]')!;
    const nextUi = sec.querySelector<HTMLElement>('[data-ih-next]')!;
    const go = sec.querySelector<HTMLAnchorElement>('[data-ih-go]')!;
    const header = document.querySelector<HTMLElement>('[data-header]');
    const nextSection = document.querySelector<HTMLElement>('[data-ih] ~ section');
    const fades = Array.from(sec.querySelectorAll<HTMLElement>('[data-ih-fade]'));
    const photo = Object.fromEntries(Array.from(sec.querySelectorAll<SVGGElement>('[data-ih-photo]')).map((g) => [g.dataset.ihPhoto!, g]));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ramp = (v: number, a: number, b: number) => clamp((v - a) / (b - a));
    const ease = (t: number) => t * t * (3 - 2 * t);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const key = (p: number, ks: number[][]) => {
      if (p <= ks[0][0]) return ks[0][1];
      for (let i = 1; i < ks.length; i++) if (p <= ks[i][0]) return lerp(ks[i - 1][1], ks[i][1], ease((p - ks[i - 1][0]) / (ks[i][0] - ks[i - 1][0])));
      return ks[ks.length - 1][1];
    };

    // The pupil, in artwork units: M sits at x = 215; the pupil is at (55.6, 66.4) inside it (measured on the photograph).
    const PX = 215 + 55.6;
    const PY = 66.4;
    const PUPIL_R = 6; // pupil radius in artwork units
    // From the pupil, the nearest edges of the M are its top notch and its lower V, both about 22 units away,
    // so a circle of up to 20 units around the pupil lies wholly inside the letter and can open unseen.
    const SAFE_R = 20;

    // geometry of the still composition, measured once per layout
    let vw = 0;
    let vh = 0;
    let u0 = 1; // px per artwork unit at rest
    let cx0 = 265;
    let cy0 = 75;
    const measure = () => {
      const st = stage.getBoundingClientRect();
      const sl = slot.getBoundingClientRect();
      vw = st.width;
      vh = st.height;
      u0 = sl.width / 530;
      cx0 = 265 + (vw / 2 - (sl.left - st.left + sl.width / 2)) / u0;
      cy0 = (vh / 2 - (sl.top - st.top)) / u0;
    };

    // one still photograph, reframed: scale about a point of interest, plus a small drift
    const frame = (k: string, scale: number, tx = 0, ty = 0) => {
      const g = photo[k];
      const fx = Number(g.dataset.fx);
      const fy = Number(g.dataset.fy);
      g.setAttribute('transform', `translate(${(fx + tx).toFixed(3)} ${(fy + ty).toFixed(3)}) scale(${scale.toFixed(4)}) translate(${-fx} ${-fy})`);
    };

    let lastHidden = false;
    const render = (p: number) => {
      // ---- ACT II: five living photographs (each with its own timing, direction and amount) ----
      frame('h', 1 + 0.05 * ease(ramp(p, 0.05, 0.3)), -1.6 * ease(ramp(p, 0.06, 0.32)));
      frame('u', 1 + 0.07 * ease(ramp(p, 0.07, 0.33)));
      frame('m', 1 + 0.1 * ease(ramp(p, 0.08, 0.4)));
      frame('a', 1 + 0.035 * ease(ramp(p, 0.06, 0.31)), 2.2 * ease(ramp(p, 0.06, 0.32)));
      frame('n', 1 + 0.045 * ease(ramp(p, 0.09, 0.34)));

      // ---- the camera: how many pixels one artwork unit takes, and what it is centred on ----
      // deep inside the M the screen shows about 52 units of height: the solid band of the letter around the pupil
      // (on a tall phone that would crop to the iris alone, so there the eye is framed by its width instead)
      const sIn = vw > vh ? Math.max(vh / 52, vw / 96) : vw / 42;
      const s = key(p, [[0, u0], [0.3, u0], [0.46, u0 * 1.9], [0.6, sIn], [0.7, sIn * 1.06], [0.9, sIn * 1.7]]);
      const toPupil = key(p, [[0.3, 0], [0.48, 0.6], [0.58, 1]]);
      const cx = lerp(cx0, PX, toPupil);
      const cy = lerp(cy0, PY, toPupil);
      const w = vw / s;
      const h = vh / s;
      art.setAttribute('viewBox', `${(cx - w / 2).toFixed(3)} ${(cy - h / 2).toFixed(3)} ${w.toFixed(3)} ${h.toFixed(3)}`);

      // ---- ACT IV: the letter lets go of the photograph ----
      // The opening starts inside the solid letter (invisible), and only grows past the letter's edges once the
      // camera is close enough that what is left of them is a sliver at the top and bottom of the frame.
      const opening = ease(ramp(p, 0.52, 0.66));
      const cover = Math.hypot(w, h) / 2 + 6;
      open.setAttribute('r', p < 0.48 ? '0' : lerp(SAFE_R, Math.max(SAFE_R, cover), opening).toFixed(2));

      // ---- ACT V–VI: the pupil widens into the dark ground of the next section ----
      // The dark starts as the pupil's own size and shape, with a soft edge like the pupil's, and the rest of the
      // picture dims with it, so it reads as the eye's own darkness spreading rather than a disc laid on top.
      const dk = ease(ramp(p, 0.75, 0.985));
      const r0 = PUPIL_R * 1.1 * s;
      const r = lerp(r0, Math.hypot(vw, vh) * 0.75, dk * dk);
      const around = Math.min(1, dk * 1.25);
      dark.style.opacity = ramp(p, 0.71, 0.79).toFixed(3);
      dark.style.background = `radial-gradient(circle at 50% 50%, #0b0d0f 0, #0b0d0f ${(r * 0.72).toFixed(1)}px, rgba(11,13,15,${(0.55 + 0.45 * around).toFixed(3)}) ${(r * 1.05).toFixed(1)}px, rgba(11,13,15,${(around * 0.9).toFixed(3)}) ${(r * 1.7 + 40).toFixed(1)}px, rgba(11,13,15,${around.toFixed(3)}) 100%)`;

      // ---- ACT III: the editorial layer leaves as the camera passes it ----
      const out = ease(ramp(p, 0.18, 0.36));
      fades.forEach((el) => {
        el.style.opacity = (1 - out).toFixed(3);
        el.style.transform = out ? `translate3d(0, ${(-out * 36).toFixed(1)}px, 0)` : '';
      });
      const hidden = out > 0.95;
      if (hidden !== lastHidden) {
        lastHidden = hidden;
        fades.forEach((el) => (el.inert = hidden)); // nothing invisible stays in the tab order
      }
      // the arrow belongs to the opening screen only: it recedes as soon as the film begins and stops pulsing
      const away = ease(ramp(p, 0.02, 0.1));
      nextUi.style.opacity = (1 - away).toFixed(3);
      nextUi.style.transform = away ? `translate3d(0, ${(away * 10).toFixed(1)}px, 0)` : '';
      nextUi.inert = away > 0.95;
      nextUi.classList.toggle('is-quiet', p > 0.015);
      sec.dataset.ihAct = String(p < 0.1 ? 1 : p < 0.3 ? 2 : p < 0.46 ? 3 : p < 0.66 ? 4 : p < 0.86 ? 5 : 6);
    };

    let film = false;
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!film) return;
      const span = track.offsetHeight - stage.offsetHeight;
      const p = span > 8 ? clamp(-track.getBoundingClientRect().top / span) : 0;
      sec.style.setProperty('--p', p.toFixed(4));
      render(p);
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    let listening = false;
    new IntersectionObserver(
      ([en]) => {
        if (en.isIntersecting && !listening) {
          window.addEventListener('scroll', request, { passive: true });
          listening = true;
        } else if (!en.isIntersecting && listening) {
          window.removeEventListener('scroll', request);
          listening = false;
        }
        request();
      },
      { rootMargin: '20% 0px 20% 0px' },
    ).observe(sec);

    const still = () => {
      // put the artwork back exactly as authored
      art.setAttribute('viewBox', '0 0 530 150');
      open.setAttribute('r', '0');
      Object.values(photo).forEach((g) => g.removeAttribute('transform'));
      dark.style.opacity = '0';
      fades.forEach((el) => {
        el.style.opacity = '';
        el.style.transform = '';
        el.inert = false;
      });
      nextUi.style.opacity = '';
      nextUi.style.transform = '';
      nextUi.inert = false;
    };
    const start = () => {
      film = !reduce.matches;
      sec.classList.toggle('is-static', !film);
      if (!film) {
        sec.classList.remove('is-film');
        still();
        return;
      }
      // measure the still layout first (the slot is where the wordmark rests), then let the artwork fill the stage
      sec.classList.remove('is-film');
      art.setAttribute('viewBox', '0 0 530 150');
      sec.classList.add('is-measuring');
      measure();
      sec.classList.remove('is-measuring');
      sec.classList.add('is-film');
      update();
    };
    let lastW = 0;
    let lastH = 0;
    new ResizeObserver(() => {
      // ignore the small height changes of a phone's collapsing address bar; re-measure on real layout changes
      const w = window.innerWidth;
      const h = window.innerHeight;
      if (w === lastW && Math.abs(h - lastH) < 120) return;
      lastW = w;
      lastH = h;
      start();
    }).observe(document.documentElement);
    reduce.addEventListener('change', start);
    document.fonts?.ready.then(start);
    start();

    // ---- the site navigation stays out of the opening and returns with the next section ----
    // Two thresholds (show below 55% of the viewport, hide above 70%) so it cannot flicker at the boundary.
    let navShown = false;
    const nav = () => {
      if (!header || !nextSection) return;
      const top = nextSection.getBoundingClientRect().top;
      const h = window.innerHeight;
      const want = navShown ? top < h * 0.7 : top < h * 0.55;
      if (want === navShown && header.dataset.ihNav) return;
      navShown = want;
      header.dataset.ihNav = want ? 'shown' : 'hidden';
      header.inert = !want; // hidden navigation takes no pointer or keyboard focus
    };
    nav();
    window.addEventListener('scroll', nav, { passive: true });
    window.addEventListener('resize', nav);

    // ---- the arrow: travel to the next section, playing the film on the way (about three seconds) ----
    let travel = 0;
    const stop = () => {
      if (travel) cancelAnimationFrame(travel);
      travel = 0;
    };
    // any scroll gesture of the visitor's own takes over at once
    ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((t) => window.addEventListener(t, (e) => {
      if (travel && !(t === 'pointerdown' && go.contains(e.target as Node))) stop();
    }, { passive: true }));
    const arrive = () => {
      if (!nextSection) return;
      nextSection.setAttribute('tabindex', '-1');
      nextSection.focus({ preventScroll: true });
    };
    go.addEventListener('click', (e) => {
      if (!nextSection) return;
      e.preventDefault();
      if (travel) return; // a second click while travelling changes nothing
      // Land exactly on the introduction, the same place a link to it lands: its own top padding clears the header.
      const target = () => Math.round(nextSection.getBoundingClientRect().top + window.scrollY);
      const from = window.scrollY;
      if (!film || target() - from < window.innerHeight * 1.2) {
        window.scrollTo({ top: target(), behavior: 'instant' });
        arrive();
        return;
      }
      // A sine curve, with the duration chosen so the peak speed stays near 1500 px/s: the film still plays,
      // and the travel slows well before it settles on the introduction.
      const dur = Math.min(4600, Math.max(3200, ((Math.PI / 2) * Math.abs(target() - from)) / 1.5));
      let elapsed = 0;
      let prev = performance.now();
      const step = (now: number) => {
        elapsed += Math.min(40, Math.max(0, now - prev));
        prev = now;
        const t = clamp(elapsed / dur);
        const k = (1 - Math.cos(Math.PI * t)) / 2;
        window.scrollTo({ top: lerp(from, target(), k), behavior: 'instant' });
        if (t < 1) travel = requestAnimationFrame(step);
        else {
          travel = 0;
          arrive();
        }
      };
      travel = requestAnimationFrame(step);
    });
    // the pulse rests whenever the opening screen is not on show
    new IntersectionObserver(([en]) => nextUi.classList.toggle('is-off', !en.isIntersecting)).observe(stage);

    // ---- keep the reader's place when the window is resized or a phone is rotated ----
    // The film and the pinned scenes are measured in viewport heights, so after a resize the same pixel position
    // would point somewhere else (rotating a phone mid-film used to land past the introduction). Remember which
    // section is at the middle of the screen and how far through it, and return there after a real resize.
    const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section'));
    let anchor: { el: HTMLElement; f: number } | null = null;
    let anchorQueued = false;
    const remember = () => {
      anchorQueued = false;
      const mid = window.innerHeight / 2;
      for (const el of sections) {
        const r = el.getBoundingClientRect();
        if (r.top <= mid && r.bottom > mid) {
          anchor = { el, f: (mid - r.top) / r.height };
          return;
        }
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!anchorQueued) {
          anchorQueued = true;
          requestAnimationFrame(remember);
        }
      },
      { passive: true },
    );
    remember();
    let seenW = window.innerWidth;
    let seenH = window.innerHeight;
    window.addEventListener('resize', () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      // a phone's collapsing address bar changes the height a little: that is not a real resize
      const real = w !== seenW || Math.abs(h - seenH) >= 120;
      seenW = w;
      seenH = h;
      const a = anchor;
      if (!real || !a || travel) return;
      requestAnimationFrame(() => {
        const r = a.el.getBoundingClientRect();
        window.scrollTo({ top: window.scrollY + r.top + a.f * r.height - window.innerHeight / 2, behavior: 'instant' });
      });
    });
  }
</script>

<style>
  .ih {
    --ih-ivory: #f2eee6;
    --ih-ink: #252923;
    position: relative;
    background: var(--ih-ivory);
    color: var(--ih-ink);
    --text: var(--ih-ink);
    --muted: #55584f;
    --rule: rgba(37, 41, 35, 0.18);
    --accent: var(--amber-deep);
    /* the opening is composed on the viewport itself: these four lengths set its whole rhythm */
    --ih-arrow: 54px;
    --ih-foot: calc(clamp(22px, 4.4vh, 46px) + env(safe-area-inset-bottom, 0px));
    --ih-pad-x: clamp(18px, 6vw, 120px);
    --ih-l1: clamp(1.9rem, min(4.3vw, 7.4vh), 5rem);
  }
  .ih__stage {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* the composition is centred in the space above the arrow, nudged a little high so it sits optically centred */
    padding: clamp(28px, 5vh, 60px) var(--ih-pad-x) calc(var(--ih-foot) + var(--ih-arrow) + clamp(26px, 5.4vh, 60px));
  }
  .ih__flow {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .ih__eyebrow {
    margin: 0;
    color: var(--ih-ink);
    font-size: clamp(0.75rem, 0.52rem + 0.42vw, 0.9375rem);
    font-weight: 600;
    letter-spacing: 0.2em;
    padding-left: 0.2em; /* balances the trailing letter-space so the line is truly centred */
    line-height: 1.3;
  }
  /* the wordmark: as wide as the screen allows, limited only by the height the rest of the composition needs */
