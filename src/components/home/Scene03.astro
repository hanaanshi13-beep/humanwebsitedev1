    transform-origin: 56% 44%; /* the heart on the overview */
  }
  .s3__veil {
    background: var(--s3-pale);
    opacity: 0;
    pointer-events: none;
  }
  /* the photograph keeps its own 4:5 shape, centred in the window; it scales about the chest of the figure on screen */
  .s3__phone {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    aspect-ratio: 1122 / 1402;
    margin-top: calc(-0.5 * 100% * 1402 / 1122);
    transform-origin: 52.6% 51.4%;
    will-change: transform, opacity;
    display: none;
  }
  .s3__phone img {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* the phone's display, measured on the photograph: overlays are placed in its coordinates and clipped to it */
  .s3__screen {
