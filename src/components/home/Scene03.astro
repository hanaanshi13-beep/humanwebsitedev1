---
// Scene 03 — THE SIDE YOU CAN'T SEE.
// A guided passage (phone → into the screen → luminous overview → the heart) that hands over to an explorer of
// eight body systems. Built from eleven approved two-dimensional illustrations: nothing is 3D, morphed,
// regenerated or redrawn. The sense of a camera comes from scale, translation, short masked blends and light.
//
// Two separate sources of truth, so they never fight:
//   --p  / data-state   where the visitor is in the guided scroll (phone · enter · overview · heart · explore)
//   data-sel            which system the visitor has chosen (remembered; only shown in the explore state)
//
// The artwork is illustrative. It is not a scan, shows nobody's results, and carries no values or scores.
import { getImage } from 'astro:assets';
import aPhone from '../../assets/scene03/human-s3-01-phone.webp';
import aOverview from '../../assets/scene03/human-s3-02-overview.webp';
import aHeartLum from '../../assets/scene03/human-s3-03-heart-luminous.webp';
import aHeart from '../../assets/scene03/human-s3-04-heart-focus.webp';
import aLungs from '../../assets/scene03/human-s3-05-lungs.webp';
import aDigestive from '../../assets/scene03/human-s3-06-digestive.webp';
import aThyroid from '../../assets/scene03/human-s3-07-thyroid.webp';
import aNervous from '../../assets/scene03/human-s3-08-nervous.webp';
import aCirculation from '../../assets/scene03/human-s3-09-circulation.webp';
import aReproductive from '../../assets/scene03/human-s3-10-reproductive.webp';
import aMetabolic from '../../assets/scene03/human-s3-11-metabolic.webp';

const SIZES = '(max-width: 1023px) 92vw, 44vw';
const pic = async (src: ImageMetadata) => {
  const small = await getImage({ src, width: 640, format: 'webp', quality: 84 });
  const full = await getImage({ src, width: src.width, format: 'webp', quality: 88 });
  return { src: full.src, srcset: `${small.src} 640w, ${full.src} ${src.width}w`, w: src.width, h: src.height };
};

// ---- the asset manifest: one place for every image, label, line of copy and framing value ----
// `shift` is the direction (px) the new view settles from, a small cue for where on the body it sits.
// `spot` values are fractions of the overview illustration, read off the artwork.
const overview = {
  key: 'overview',
  label: 'Overview',
  eyebrow: 'The invisible side',
  title: 'One body. Many connected systems.',
  body: 'Your health is shaped by many interconnected processes. A visual illustration can introduce those systems, but understanding your health requires context beyond what a picture can show.',
  alt: 'Illustration of a translucent human torso in coral pink, showing the thyroid, heart, lungs, liver, stomach and intestines.',
  img: await pic(aOverview),
  dark: 0,
  shift: [0, 0],
  rear: false,
};
const systems = [
  {
    key: 'heart',
    label: 'Heart',
    eyebrow: 'Cardiovascular health',
    title: 'More than a heartbeat.',
    body: 'How you feel during the day does not necessarily tell you what your cholesterol levels or blood pressure are. Understanding cardiovascular health can involve looking beyond visible fitness.',
    alt: 'Illustration: the heart, lit in coral red, with the surrounding chest in subdued rose.',
    img: await pic(aHeart),
    shift: [0, 0],
    spot: [56, 44],
    icon: '<path d="M12 20s-7-4.4-7-9.6A4 4 0 0 1 12 8a4 4 0 0 1 7 2.4C19 15.6 12 20 12 20z"/>',
  },
  {
    key: 'lungs',
    label: 'Lungs',
    eyebrow: 'Respiratory health',
    title: 'Every breath has a story.',
    body: 'Your lungs exchange oxygen and carbon dioxide with every breath. Breathing, physical activity and everyday wellbeing are connected, but respiratory health cannot be fully understood from appearance alone.',
    alt: 'Illustration: both lungs, the trachea and their branching airways, lit against a dark rose chest.',
    img: await pic(aLungs),
    shift: [0, 0],
    spot: [30.5, 41.5],
    icon: '<path d="M12 3.5v7"/><path d="M11 9.5C8 9.5 5.5 12 4.6 15.5l-.5 2.6c-.2 1 .6 1.9 1.6 1.9H8c1.7 0 3-1.3 3-3V9.5z"/><path d="M13 9.5c3 0 5.5 2.5 6.4 6l.5 2.6c.2 1-.6 1.9-1.6 1.9H16c-1.7 0-3-1.3-3-3V9.5z"/>',
  },
  {
    key: 'metabolic',
    label: 'Metabolic',
    eyebrow: 'Metabolic health',
    title: 'Energy has an invisible story.',
    body: 'Your liver and pancreas play important roles in how your body processes nutrients and regulates energy. Relevant markers, such as blood glucose, may provide information that appearance alone cannot reveal.',
    alt: 'Illustration: a torso with the liver and pancreas lit in warm coral, the other organs subdued.',
    img: await pic(aMetabolic),
    shift: [0, -10],
    spot: [37, 57.5],
    icon: '<path d="M3.6 10.6C5 7.6 9 6 13 6h4.4a3.1 3.1 0 0 1 3.1 3.1c0 2-1.6 3.3-3.6 3.5-2.6.3-4.4 1.6-5.9 3.4-1.2 1.4-2.6 2.5-4.5 2.5-2.2 0-3.6-1.6-3.6-3.8 0-1.5.2-2.8.7-4.1z"/><path d="M12.6 6.2v6.6"/>',
  },
  {
    key: 'digestion',
    label: 'Digestion',
    eyebrow: 'Digestive health',
    title: 'What happens after you eat?',
    body: 'From breaking down food to absorbing nutrients, your digestive system supports everyday health. Symptoms, dietary history and appropriate assessments can help provide context when digestive concerns arise.',
    alt: 'Illustration: the stomach and intestines, lit in coral, within a darker abdomen.',
    img: await pic(aDigestive),
    shift: [0, -14],
    spot: [49, 78],
    icon: '<path d="M7 4h10a2.5 2.5 0 0 1 0 5H9a2.5 2.5 0 0 0 0 5h6a2.5 2.5 0 0 1 0 5h-3v2"/>',
  },
  {
    key: 'thyroid',
    label: 'Thyroid',
    eyebrow: 'Hormonal health',
    title: 'Small gland. Far-reaching influence.',
    body: 'Thyroid hormones help regulate metabolism and influence many functions throughout the body. Understanding thyroid function may require appropriate testing and clinical interpretation.',
    alt: 'Illustration: the neck and trachea, with the butterfly-shaped thyroid gland lit in coral.',
    img: await pic(aThyroid),
    shift: [0, 14],
    spot: [51.2, 15.5],
    icon: '<path d="M8 5C6 5 4.5 7.5 4.5 11S6 18 8.2 18c1.6 0 2.4-1.4 3.8-1.4s2.2 1.4 3.8 1.4c2.2 0 3.7-3.5 3.7-7S18 5 16 5c-1.6 0-2.2 2.6-2.6 4.6-.2 1-.7 1.4-1.4 1.4s-1.2-.4-1.4-1.4C10.2 7.6 9.6 5 8 5z"/>',
  },
  {
    key: 'nervous',
    label: 'Nervous system',
    eyebrow: 'Brain and nervous system',
    title: 'A remarkable network.',
    body: 'Your nervous system helps coordinate movement, sensation and communication throughout the body. Its complexity extends far beyond what you can observe from the outside.',
    alt: 'Illustration, seen from behind: the brain, spinal cord and branching nerves lit in warm coral.',
    img: await pic(aNervous),
    shift: [0, 0],
    rear: true,
    icon: '<path d="M12 5.5A3 3 0 0 0 6.5 6 3 3 0 0 0 4 10.5a3 3 0 0 0 .8 4.6A3 3 0 0 0 9 19a3 3 0 0 0 3-2V5.5z"/><path d="M12 5.5A3 3 0 0 1 17.5 6 3 3 0 0 1 20 10.5a3 3 0 0 1-.8 4.6A3 3 0 0 1 15 19a3 3 0 0 1-3-2"/>',
  },
  {
    key: 'circulation',
    label: 'Circulation',
    eyebrow: 'Blood and circulation',
    title: 'A connection within everything.',
    body: 'Blood carries oxygen, nutrients and other substances throughout the body. Relevant blood tests may help provide information about aspects of health that cannot be determined by looking at someone.',
    alt: 'Illustration: an upper body with the heart and a network of blood vessels lit through the neck, chest and arms.',
    img: await pic(aCirculation),
    shift: [0, 0],
    icon: '<path d="M12 3.5s6 6.2 6 10.5a6 6 0 0 1-12 0c0-4.3 6-10.5 6-10.5z"/>',
  },
  {
    key: 'reproductive',
    label: 'Reproductive health',
    eyebrow: 'Reproductive health',
    title: 'Health changes through life.',
    body: 'Reproductive health is connected with hormones, menstrual health and different stages of life. Understanding it depends on individual circumstances, symptoms, history and appropriate clinical guidance.',
    alt: 'Illustration: a pelvis with the uterus, ovaries and fallopian tubes lit in coral pink.',
    img: await pic(aReproductive),
    shift: [0, -16],
    icon: '<path d="M5.8 6.4C8 6.4 8.8 7.2 9.4 8h5.2c.6-.8 1.4-1.6 3.6-1.6"/><path d="M9.4 8c0 3.6 1.3 5.4 1.3 8.2V20h2.6v-3.8c0-2.8 1.3-4.6 1.3-8.2"/><circle cx="4.2" cy="8.6" r="1.7"/><circle cx="19.8" cy="8.6" r="1.7"/>',
  },
];
const phone = await pic(aPhone);
const heartLum = await pic(aHeartLum);
const all = [overview, ...systems];
// what the script needs: no markup, no icons
const manifest = Object.fromEntries(
  all.map((s) => [s.key, { label: s.label, eyebrow: s.eyebrow, title: s.title, body: s.body, alt: s.alt, src: s.img.src, srcset: s.img.srcset, dark: s.key === 'overview' ? 0 : 1, shift: s.shift, rear: !!(s as { rear?: boolean }).rear }]),
);
const order = systems.map((s) => s.key);
---

<section class="s3" id="scene-03" aria-labelledby="s3-title" data-s3 data-state="phone" data-sel="heart">
  <div class="wrap s3__grid">
    <div class="s3__copy">
      <p class="eyebrow" data-reveal><span class="num">03</span><span>The invisible side of your health</span></p>
      <h2 class="display" id="s3-title" data-reveal="mask">
        <span class="mask"><span>The side</span></span>
        <span class="mask" style="--i:1"><span><em>you can’t see.</em></span></span>
      </h2>
      <div class="prose" data-reveal style="--d:120ms">
        <p>One you can’t see in the mirror or track on a fitness watch.</p>
        <p>
          <strong>What’s happening inside your body?</strong> How are your blood sugar and cholesterol levels? What
          about iron, thyroid and other relevant health markers?
        </p>
        <p>
          You might not know. Most of us were never taught to look beyond how we feel or what we see.
        </p>
      </div>
      <!-- the selected system's explanation (wide screens). A twin sits under the artwork on small screens. -->
      <div class="s3__info s3__info--side" data-s3-info aria-live="polite">
        <p class="s3__info-eyebrow" data-f="eyebrow">{overview.eyebrow}</p>
        <h3 data-f="title">{overview.title}</h3>
        <p class="s3__info-body" data-f="body">{overview.body}</p>
      </div>
    </div>

    <div class="s3__pin">
      <div class="s3__stage">
        <div class="s3__view">
          <!-- eight real systems; on wide screens a vertical glass capsule, on phones a labelled scrolling row -->
          <nav class="s3__nav" aria-label="Body systems" data-s3-ui>
            <ul>
              {
                systems.map((s) => (
                  <li>
                    <button type="button" class="s3__sys" data-s3-sys={s.key} aria-label={s.label} aria-pressed="false">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={s.icon} />
                      <span class="s3__sys-label" aria-hidden="true">{s.label}</span>
                    </button>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="s3__art">
            <div class="s3__frame">
              <div class="s3__layers" data-s3-layers>
                <!-- State B/C: the photograph of the phone. Its overlays live in the phone's own coordinates. -->
                <div class="s3__phone" data-s3-phone>
                  <img src={phone.src} srcset={phone.srcset} sizes={SIZES} width={phone.w} height={phone.h} alt="A hand holding a phone. On its screen is an illustration of a translucent human body." loading="lazy" decoding="async" />
                  <div class="s3__screen" data-s3-screen>
                    <span class="s3__dot" style="left:51%;top:56%" aria-hidden="true"></span>
                    <span class="s3__dot" style="left:28%;top:53%" aria-hidden="true"></span>
                    <button type="button" class="s3__enter" data-s3-enter>
                      Explore
                      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" /></svg>
                    </button>
                  </div>
                </div>
                <!-- State D/E: three stills of the guided approach. Only the first is announced. -->
                <img class="s3__l s3__l--overview" data-s3-l="overview" src={overview.img.src} srcset={overview.img.srcset} sizes={SIZES} width={overview.img.w} height={overview.img.h} alt={overview.alt} loading="lazy" decoding="async" />
                <img class="s3__l" data-s3-l="heartlum" src={heartLum.src} srcset={heartLum.srcset} sizes={SIZES} width={heartLum.w} height={heartLum.h} alt="" loading="lazy" decoding="async" />
                <img class="s3__l" data-s3-l="heart" src={systems[0].img.src} srcset={systems[0].img.srcset} sizes={SIZES} width={systems[0].img.w} height={systems[0].img.h} alt="" loading="lazy" decoding="async" />
                <span class="s3__veil" data-s3-veil aria-hidden="true"></span>
                <!-- State F: the explorer's own pair of image slots (current and incoming) -->
                <div class="s3__ex" data-s3-ex>
                  <img data-s3-slot alt="" decoding="async" />
                  <img data-s3-slot alt="" decoding="async" />
                </div>
              </div>
              <!-- markers on the overview illustration: each one opens that system -->
              <div class="s3__spots" data-s3-spots>
                {
                  systems
                    .filter((s) => s.spot)
                    .map((s) => (
                      <button type="button" class="s3__spot" style={`left:${s.spot![0]}%;top:${s.spot![1]}%`} data-s3-spot={s.key} aria-label={`${s.label}: open this system`}>
                        <span aria-hidden="true" />
                      </button>
                    ))
                }
              </div>
            </div>
          </div>
        </div>

        <!-- previous · eight markers · next · overview. Every control changes the view; none is a gauge. -->
        <div class="s3__strip" role="group" aria-label="Move between systems" data-s3-ui>
          <button type="button" class="s3__step" data-s3-prev aria-label="Previous system">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" /></svg>
          </button>
          <div class="s3__ticks">
            {
              systems.map((s) => (
                <button type="button" class="s3__tick" data-s3-tick={s.key} aria-label={s.label} aria-pressed="false">
                  <span aria-hidden="true" />
                </button>
              ))
            }
          </div>
          <p class="s3__count" aria-hidden="true"><span data-s3-count>Heart</span></p>
          <button type="button" class="s3__step" data-s3-next aria-label="Next system">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m6 3 5 5-5 5" /></svg>
          </button>
          <button type="button" class="s3__over" data-s3-over aria-pressed="false">Overview</button>
        </div>

        <div class="s3__info s3__info--stage" data-s3-info>
          <p class="s3__info-eyebrow" data-f="eyebrow">{overview.eyebrow}</p>
          <h3 data-f="title">{overview.title}</h3>
          <p class="s3__info-body" data-f="body">{overview.body}</p>
        </div>

        <p class="note s3__cap">An illustration, not a scan. It does not show anyone’s results.</p>
        <p class="vh" role="status" data-s3-status></p>
      </div>
    </div>
  </div>

  <!-- Without JavaScript the scene is a still of the overview, and every system is written out here. -->
  <div class="wrap s3__plain">
    {
      systems.map((s) => (
        <article>
          <p class="s3__info-eyebrow">{s.eyebrow}</p>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))
    }
  </div>

  <div class="s3__after">
    <div class="wrap">
      <p class="s3__after-line" data-reveal>
        A picture of the body can show structure. <em>It can’t tell you everything about your health.</em>
      </p>
      <p class="s3__after-note" data-reveal style="--d:100ms">
        Many health questions depend on personal history, symptoms, appropriate testing and clinical interpretation.
        Not everyone needs every test.
      </p>
    </div>
  </div>

  <script type="application/json" data-s3-manifest set:html={JSON.stringify({ items: manifest, order })} />
</section>

<script>
  const sec = document.querySelector<HTMLElement>('[data-s3]');
  const pin = sec?.querySelector<HTMLElement>('.s3__pin');
  const stage = sec?.querySelector<HTMLElement>('.s3__stage');
  if (sec && pin && stage) {
    type Item = { label: string; eyebrow: string; title: string; body: string; alt: string; src: string; srcset: string; dark: number; shift: [number, number]; rear: boolean };
    const data = JSON.parse(sec.querySelector('[data-s3-manifest]')!.textContent!) as { items: Record<string, Item>; order: string[] };
    const { items, order } = data;
    const $ = <T extends HTMLElement>(s: string) => sec.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement>(s: string) => Array.from(sec.querySelectorAll<T>(s));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const phone = $('[data-s3-phone]');
    const screenUi = $('[data-s3-screen]');
    const lOverview = $('[data-s3-l="overview"]');
    const lHeartLum = $('[data-s3-l="heartlum"]');
    const lHeart = $('[data-s3-l="heart"]');
    const veil = $('[data-s3-veil]');
    const slots = $$<HTMLImageElement>('[data-s3-slot]');
    const spots = $('[data-s3-spots]');
    const uis = $$('[data-s3-ui]');
    const sysBtns = $$<HTMLButtonElement>('[data-s3-sys]');
    const ticks = $$<HTMLButtonElement>('[data-s3-tick]');
    const overBtn = $<HTMLButtonElement>('[data-s3-over]');
    const infos = $$('[data-s3-info]');
    const status = $('[data-s3-status]');
    const count = $('[data-s3-count]');

    // ---------- state ----------
    let p = 0; // guided scroll progress, 0..1
    let state = ''; // phone | enter | overview | heart | explore
    let sel = 'heart'; // the visitor's chosen system (or 'overview'); only displayed in the explore state
    let shown = ''; // what the explorer slots currently display
    let live = 0; // index of the visible slot
    let token = 0; // latest selection wins
    let staticMode = false; // reduced motion: no pinned sequence, explorer shown directly

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    const ramp = (v: number, a: number, b: number) => clamp((v - a) / (b - a));
    const ease = (t: number) => t * t * (3 - 2 * t);

    // ---------- guided sequence: every layer's transform and opacity is a pure function of p ----------
    const render = (approach: number) => {
      // B. the photograph arrives (before the pin engages), then holds
      const arrive = ease(approach);
      // C. approach and pass into the screen: scale about the chest of the figure on the phone
      const zoom = ease(ramp(p, 0.12, 0.4));
      const ps = (0.94 + 0.06 * arrive) * (1 + zoom * 1.55);
      phone.style.transform = `translate3d(${zoom * 3.4}%, ${(1 - arrive) * 6 - zoom * 8}%, 0) scale(${ps.toFixed(4)})`;
      phone.style.opacity = p >= 0.415 ? '0' : String(clamp(arrive * 1.4));
      const ui = 1 - ramp(p, 0.04, 0.12);
      screenUi.style.opacity = ui.toFixed(3);
      screenUi.inert = ui < 0.5 || state === 'explore';

      // D. the luminous overview takes over, then E. leans toward the heart
      const oIn = ramp(p, 0.35, 0.43);
      const lean = ease(ramp(p, 0.56, 0.68));
      const os = (1.06 - 0.06 * ease(ramp(p, 0.35, 0.47))) * (1 + lean * 0.56);
      lOverview.style.opacity = p >= 0.705 ? '0' : oIn.toFixed(3);
      lOverview.style.transform = `translate3d(${-12 * lean}%, 0, 0) scale(${os.toFixed(4)})`;
      // a brief blush veil softens the two handovers where the stills differ
      const bump = (a: number, m: number, b: number) => (p <= a || p >= b ? 0 : p < m ? (p - a) / (m - a) : (b - p) / (b - m));
      veil.style.opacity = (0.42 * bump(0.34, 0.38, 0.43) + 0.3 * bump(0.61, 0.65, 0.69)).toFixed(3);

      const hIn = ramp(p, 0.62, 0.7);
      lHeartLum.style.opacity = hIn.toFixed(3);
      lHeartLum.style.transform = `scale(${(1.05 - 0.05 * ease(ramp(p, 0.62, 0.74))).toFixed(4)})`;
      lHeart.style.opacity = ramp(p, 0.72, 0.82).toFixed(3);

      sec.style.setProperty('--s3-blush', ramp(p, 0.22, 0.4).toFixed(3));
    };

    const setInfo = (key: string) => {
      const it = items[key];
      infos.forEach((box) => {
        if (box.dataset.key === key) return;
        box.dataset.key = key;
        box.querySelector('[data-f="eyebrow"]')!.textContent = it.eyebrow;
        box.querySelector('[data-f="title"]')!.textContent = it.title;
        box.querySelector('[data-f="body"]')!.textContent = it.body;
      });
    };

    // ---------- explorer: swap the artwork, keep the interface still ----------
    const loadInto = (img: HTMLImageElement, it: Item) =>
      new Promise<void>((res, rej) => {
        const probe = new Image();
        probe.sizes = '(max-width: 1023px) 92vw, 44vw';
        probe.srcset = it.srcset;
        probe.src = it.src;
        const done = () => {
          img.sizes = probe.sizes;
          img.srcset = it.srcset;
          img.src = it.src;
          res();
        };
        probe.decode ? probe.decode().then(done, () => (probe.complete && probe.naturalWidth ? done() : rej())) : ((probe.onload = done), (probe.onerror = () => rej()));
      });

    const show = async (key: string, instant = false) => {
      if (shown === key) return;
      const mine = ++token;
      const it = items[key];
      const prev = shown;
      const next = slots[1 - live];
      try {
        await loadInto(next, it);
      } catch {
        if (mine !== token) return;
        // keep the last good view and say so; the interface returns to it
        status.textContent = `The ${it.label.toLowerCase()} view could not be loaded.`;
        if (prev) choose(prev, { silent: true });
        return;
      }
      if (mine !== token) return; // a newer choice arrived while this one was loading
      const cur = slots[live];
      const quick = instant || reduce.matches;
      // a rear view (the nervous system) is a change of viewing mode: pass through the dark instead of blending
      const through = !quick && (it.rear || !!items[prev]?.rear);
      next.alt = it.alt;
      cur.alt = '';
      next.style.transition = 'none';
      next.style.transform = quick ? 'none' : `translate3d(${it.shift[0]}px, ${it.shift[1]}px, 0) scale(1.025)`;
      next.style.opacity = '0';
      next.style.zIndex = '2';
      cur.style.zIndex = '1';
      void next.offsetWidth;
      const d = through ? 170 : 0;
      next.style.transition = quick ? 'none' : `opacity 380ms cubic-bezier(.22,1,.36,1) ${d}ms, transform 560ms cubic-bezier(.22,1,.36,1) ${d}ms`;
      next.style.opacity = '1';
      next.style.transform = 'none';
      cur.style.transition = quick ? 'none' : `opacity ${through ? 170 : 420}ms ease ${through ? 0 : 120}ms`;
      cur.style.opacity = '0';
      live = 1 - live;
      shown = key;
    };

    const syncUi = () => {
      const active = state === 'explore' ? sel : '';
      sysBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.s3Sys === active)));
      ticks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.s3Tick === active)));
      overBtn.setAttribute('aria-pressed', String(active === 'overview'));
      count.textContent = state === 'explore' ? (sel === 'overview' ? 'Overview' : `${order.indexOf(sel) + 1} of ${order.length}`) : 'Choose a system';
      // on small screens the list scrolls sideways: keep the chosen system in view without moving the page
      const on = sysBtns.find((b) => b.dataset.s3Sys === active);
      const rail = on?.closest('ul');
      if (on && rail && rail.scrollWidth > rail.clientWidth + 4 && rail.dataset.at !== active) {
        rail.dataset.at = active;
        const li = on.parentElement!;
        rail.scrollTo({ left: li.offsetLeft - (rail.clientWidth - li.offsetWidth) / 2, behavior: reduce.matches ? 'instant' : 'smooth' });
      }
      sec.dataset.sel = sel;
      // the overview markers are live whenever the overview illustration is the settled view
      const overviewUp = (state === 'overview' && p > 0.44 && p < 0.56) || (state === 'explore' && sel === 'overview');
      spots.classList.toggle('is-on', overviewUp);
      spots.inert = !overviewUp;
      const dark = state === 'explore' ? items[sel].dark : ramp(p, 0.72, 0.82);
      sec.style.setProperty('--s3-dark', dark.toFixed(3));
      setInfo(state === 'explore' ? sel : state === 'heart' && p >= 0.6 ? 'heart' : 'overview');
    };

    // Choosing a system. From inside the guided sequence it also carries the visitor to the explorer.
    function choose(key: string, opt: { silent?: boolean } = {}) {
      sel = key;
      if (state !== 'explore') {
        const span = pin!.offsetHeight - stage!.offsetHeight;
        const y = pin!.getBoundingClientRect().top + window.scrollY + span * 0.97;
        window.scrollTo({ top: y, behavior: reduce.matches ? 'instant' : 'smooth' });
        syncUi();
        return;
      }
      syncUi();
      show(key);
      if (!opt.silent) status.textContent = '';
    }
    const stepBy = (n: number) => {
      const i = order.indexOf(sel);
      choose(order[(i < 0 ? (n > 0 ? 0 : order.length - 1) : i + n + order.length) % order.length]);
    };

    const setState = (next: string) => {
      if (next === state) return;
      const was = state;
      state = next;
      sec.dataset.state = next;
      const controls = next === 'overview' || next === 'heart' || next === 'explore';
      uis.forEach((u) => (u.inert = !controls));
      if (next === 'explore') {
        // hand over: the explorer starts on the remembered system (the heart on a first visit)
        show(sel, shown === '' && sel === 'heart');
        if (was !== '') warm();
      }
    };

    // fetch the remaining artwork quietly once the visitor is exploring, so later choices are immediate
    let warmed = false;
    const warm = () => {
      if (warmed) return;
      warmed = true;
      const rest = order.filter((k) => k !== sel);
      const next = () => {
        const k = rest.shift();
        if (!k) return;
        const im = new Image();
        im.sizes = '(max-width: 1023px) 92vw, 44vw';
        im.srcset = items[k].srcset;
        im.onload = im.onerror = () => setTimeout(next, 120);
        im.src = items[k].src;
      };
      ('requestIdleCallback' in window ? requestIdleCallback : setTimeout)(next as () => void);
    };

    // ---------- scroll: one rAF-throttled listener, attached only while the scene is near the viewport ----------
    let ticking = false;
    const update = () => {
      ticking = false;
      if (staticMode) return;
      const span = pin.offsetHeight - stage.offsetHeight;
      const top = pin.getBoundingClientRect().top;
      p = span > 8 ? clamp(-top / span) : 0;
      const approach = clamp(1 - top / (window.innerHeight * 0.9));
      setState(p < 0.1 ? 'phone' : p < 0.42 ? 'enter' : p < 0.56 ? 'overview' : p < 0.84 ? 'heart' : 'explore');
      render(approach);
      sec.style.setProperty('--p', p.toFixed(4));
      syncUi();
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    let listening = false;
    new IntersectionObserver(
      ([en]) => {
        if (en.isIntersecting && !listening) {
          window.addEventListener('scroll', request, { passive: true });
          window.addEventListener('resize', request);
          listening = true;
        } else if (!en.isIntersecting && listening) {
          window.removeEventListener('scroll', request);
          window.removeEventListener('resize', request);
          listening = false;
        }
        request();
      },
      { rootMargin: '40% 0px 40% 0px' },
    ).observe(sec);

    // Reduced motion: no pinned sequence and no zoom. The overview and the explorer are simply there.
    const applyMotionPref = () => {
      staticMode = reduce.matches;
      sec.classList.toggle('is-static', staticMode);
      if (staticMode) {
        p = 1;
        sel = shown || 'overview';
        sec.style.setProperty('--s3-blush', '1');
        [phone, lOverview, lHeartLum, lHeart, veil].forEach((el) => (el.style.opacity = '0'));
        screenUi.inert = true;
        state = '';
        setState('explore');
        syncUi();
      } else {
        state = '';
        update();
      }
    };
    reduce.addEventListener('change', applyMotionPref);
    applyMotionPref();

    // ---------- controls ----------
    sysBtns.forEach((b) => b.addEventListener('click', () => choose(b.dataset.s3Sys!)));
    ticks.forEach((b) => b.addEventListener('click', () => choose(b.dataset.s3Tick!)));
    $$<HTMLButtonElement>('[data-s3-spot]').forEach((b) => b.addEventListener('click', () => choose(b.dataset.s3Spot!)));
    overBtn.addEventListener('click', () => choose('overview'));
    $('[data-s3-prev]').addEventListener('click', () => stepBy(-1));
    $('[data-s3-next]').addEventListener('click', () => stepBy(1));
    $('[data-s3-enter]').addEventListener('click', () => choose(sel));
    // arrow keys step through the systems while focus is on the system list or the strip
    sec.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (!t.closest('.s3__nav, .s3__ticks')) return;
      const fwd = e.key === 'ArrowDown' || e.key === 'ArrowRight';
      const back = e.key === 'ArrowUp' || e.key === 'ArrowLeft';
      if (!fwd && !back) return;
      e.preventDefault();
      const list = t.closest('.s3__nav') ? sysBtns : ticks;
      const i = list.indexOf(t.closest('button') as HTMLButtonElement);
      list[(i + (fwd ? 1 : -1) + list.length) % list.length]?.focus();
    });
  }
</script>

<style>
  @property --s3-dark {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  .s3 {
    /* palette sampled from the approved artwork */
    --s3-ivory: #f0e7e5;
    --s3-pale: #e8c5c9;
    --s3-coral: #f38286;
    --s3-rose: #99616c;
    --s3-deep: #3a1c23;
    --p: 0;
    --s3-blush: 0; /* 0..1 ivory → blush as the visitor enters the screen */
    --s3-dark: 0; /* 0..1 blush → deep rose as the heart comes into focus, and per chosen system */
    --ink: clamp(0, (var(--s3-dark) - 0.4) / 0.2, 1);
    --s3-room: color-mix(in srgb, var(--s3-deep) calc(var(--s3-dark) * 100%), color-mix(in srgb, var(--s3-pale) calc(var(--s3-blush) * 100%), var(--s3-ivory)));
    position: relative;
    background: var(--s3-room);
    color: color-mix(in srgb, var(--text-on-dark) calc(var(--ink) * 100%), var(--text-on-light));
    --text: color-mix(in srgb, var(--text-on-dark) calc(var(--ink) * 100%), var(--text-on-light));
    --muted: color-mix(in srgb, #d9c9cc calc(var(--ink) * 100%), #5a4a4d);
    --rule: color-mix(in srgb, rgba(243, 239, 230, 0.2) calc(var(--ink) * 100%), rgba(58, 28, 35, 0.2));
    --accent: color-mix(in srgb, #f6b3b6 calc(var(--ink) * 100%), #8e3f52);
    /* glass: one material for the system list, the strip and the markers */
    --glass: color-mix(in srgb, rgba(74, 40, 49, 0.5) calc(var(--ink) * 100%), rgba(255, 255, 255, 0.46));
    --glass-edge: color-mix(in srgb, rgba(255, 226, 230, 0.26) calc(var(--ink) * 100%), rgba(110, 60, 72, 0.22));
  }
  /* in the explorer the room follows the chosen view, so let it ease rather than snap */
  .s3[data-state='explore'] {
    transition: --s3-dark 420ms var(--ease-human);
  }
  /* Scene 02's ivory hands over to the scene's own ivory without a seam */
  .s3::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(120px, 18vw, 240px);
    background: linear-gradient(180deg, var(--ivory), rgba(236, 232, 223, 0));
    opacity: calc((1 - var(--s3-blush)) * (1 - var(--s3-dark)));
    pointer-events: none;
  }
  .s3__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
  }
  .s3__copy {
    grid-column: 1 / span 5;
    padding-block: var(--section-y) 48px;
  }
  .s3__copy h2 {
    margin: var(--stack-label) 0 var(--stack-head);
  }
  .s3__pin {
    grid-column: 6 / span 7;
  }
  .s3__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-block: 24px 40px;
  }
  .s3__view {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 1.6vw, 22px);
    min-height: 0;
  }
  .s3__art {
    display: flex;
    justify-content: center;
    width: min(100%, 520px);
    min-width: 0;
    min-height: 0;
  }

  /* ---- the frame: a 3:4 window. Layers move inside it; the interface never does. ---- */
  .s3__frame {
    position: relative;
    aspect-ratio: 3 / 4;
    width: min(100%, 520px);
  }
  .s3__layers {
    position: absolute;
    inset: 0;
    overflow: hidden;
    isolation: isolate;
    /* the four edges dissolve into the room, so no still ever shows a rectangle */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%), linear-gradient(180deg, transparent 0, #000 6%, #000 93%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%), linear-gradient(180deg, transparent 0, #000 6%, #000 93%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .s3__l,
  .s3__ex,
  .s3__ex img,
  .s3__veil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .s3__l,
  .s3__ex img {
    object-fit: cover;
  }
  /* artwork never takes the pointer: only the phone's own button and the markers do */
  .s3__l,
  .s3__ex,
