---
// Scene 03 — THE SIDE YOU CAN'T SEE. Signature 1: THE REVEAL LENS (V3-SIG-01..08).
// Two code-drawn layers: an opaque matte "surface" and a warm refractive "underlayer".
// A single elliptical clip-path on the surface opens with scroll (--p). No WebGL, no blur animation, no video.
// Default (no JS / reduced motion / mobile): a fixed half-open aperture — a still before/after comparison.
import Material from '../Material.astro';
---

<section class="s3 on-dark" id="scene-03" aria-labelledby="s3-title" data-progress="through">
  <div class="s3__sticky">
    <div class="wrap s3__grid">
      <div class="s3__copy">
        <p class="eyebrow" data-reveal><span class="num">03</span><span>The invisible side of your health</span></p>
        <h2 class="display" id="s3-title" data-reveal="mask">
          <span class="mask"><span>The side</span></span>
          <span class="mask" style="--i:1"><span><em>you can’t see.</em></span></span>
        </h2>
        <div class="prose" data-reveal style="--d:120ms">
          <p>One you can’t see in the mirror or track on a fitness watch.</p>
          <p>
            <strong>What’s happening inside your body?</strong> How are your blood sugar and cholesterol levels? What
            about iron, thyroid and other relevant health markers?
          </p>
          <p>
            You might not know. Most of us were never taught to look beyond how we feel or what we see.
          </p>
        </div>
      </div>

      <figure class="s3__lens" data-reveal="fade" data-lens>
        <div class="s3__stage" aria-hidden="true">
          <div class="s3__under">
            <div class="s3__art">
              <Material tone="amber" shape="a" />
              <Material tone="amber" shape="c" opacity={0.7} />
              <Material tone="ivory" shape="b" opacity={0.35} />
              <svg class="s3__fil" viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" focusable="false">
                <g fill="none" stroke="#f6dfae" stroke-width="0.5" stroke-linecap="round">
                  <path d="M40 520 C 120 380, 60 250, 190 170 S 330 60, 300 -20" opacity="0.55"></path>
                  <path d="M70 520 C 150 390, 100 260, 215 185 S 350 80, 330 -20" opacity="0.4"></path>
                  <path d="M110 520 C 180 400, 140 280, 240 205 S 372 100, 362 -20" opacity="0.3"></path>
                  <path d="M-20 300 C 90 280, 150 330, 230 260 S 360 190, 420 220" opacity="0.35"></path>
                  <path d="M-20 340 C 100 320, 160 370, 245 300 S 365 235, 420 262" opacity="0.22"></path>
                  <ellipse cx="224" cy="230" rx="118" ry="150" transform="rotate(-12 224 230)" opacity="0.3"></ellipse>
                  <ellipse cx="224" cy="230" rx="74" ry="96" transform="rotate(-12 224 230)" opacity="0.2"></ellipse>
                </g>
              </svg>
            </div>
          </div>
          <div class="s3__surface"></div>
          <span class="s3__ring"></span>
          <span class="s3__tag s3__tag--a">Surface</span>
          <span class="s3__tag s3__tag--b">Beneath</span>
        </div>
        <div class="s3__control">
          <label class="s3__control-label" for="s3-range">Explore beneath the surface</label>
          <input class="s3__range" id="s3-range" type="range" min="0" max="100" value="50" step="1" data-lens-range aria-describedby="s3-cap" />
        </div>
        <figcaption class="s3__labels">
          <span class="s3__label s3__label--a">What we can notice</span>
          <span class="s3__label s3__label--b">What we may need to understand</span>
        </figcaption>
        <p class="note s3__cap" id="s3-cap">An abstract illustration — not a scan, and not anyone’s results.</p>
      </figure>
    </div>
  </div>
</section>

<script>
  // The slider is the keyboard / touch / reduced-motion way to open the lens. On desktop, scroll drives it
  // until the visitor takes the slider; their choice then holds until the scene leaves the viewport.
  const fig = document.querySelector<HTMLElement>('[data-lens]');
  const range = fig?.querySelector<HTMLInputElement>('[data-lens-range]');
  const section = fig?.closest<HTMLElement>('.s3');
  if (fig && range && section) {
    let manual = false;
    const say = () => range.setAttribute('aria-valuetext', `${range.value}% revealed`);
    say();
    range.addEventListener('input', () => {
      manual = true;
      fig.style.setProperty('--a', String(Number(range.value) / 100));
      say();
    });
    section.addEventListener('scrollprogress', (e) => {
      if (manual) return;
      range.value = String(Math.round((e as CustomEvent<number>).detail * 100));
      say();
    });
    new IntersectionObserver(([en]) => {
      if (!en.isIntersecting && manual) {
        manual = false;
        fig.style.removeProperty('--a');
      }
    }).observe(section);
    // Fine pointers can steer the aperture a little once it is open. Purely decorative.
    const stage = fig.querySelector<HTMLElement>('.s3__stage')!;
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      stage.addEventListener('pointermove', (e) => {
        const r = stage.getBoundingClientRect();
        stage.style.setProperty('--cx', `${(56 + ((e.clientX - r.left) / r.width - 0.5) * 16).toFixed(1)}%`);
        stage.style.setProperty('--cy', `${(46 + ((e.clientY - r.top) / r.height - 0.5) * 12).toFixed(1)}%`);
      });
      stage.addEventListener('pointerleave', () => {
        stage.style.removeProperty('--cx');
        stage.style.removeProperty('--cy');
      });
    }
  }
</script>

<style>
  .s3 {
    position: relative;
    --p: 0.5; /* static default: half-open aperture */
  }
  .s3__sticky {
    padding-block: clamp(88px, 12vw, 160px);
  }
  .s3__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(20px, 3vw, 48px);
    row-gap: 48px;
    align-items: center;
  }
  .s3__copy {
    grid-column: 1 / span 5;
  }
  .s3__copy h2 {
    margin: 22px 0 30px;
  }
  .s3__lens {
    grid-column: 7 / span 6;
  }
  .s3__lens {
    --a: var(--p); /* aperture amount: scroll by default, the slider when the visitor takes it */
  }
  .s3__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 60svh;
    width: 100%;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 6px;
    background: #060708;
    isolation: isolate;
    --r: calc(9% + var(--a) * 78%);
    --cx: 56%;
    --cy: 46%;
  }
  .s3__under {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 60% 40%, rgba(232, 165, 35, 0.22), transparent 62%),
      linear-gradient(160deg, #1d1508 0%, #0b0d0f 70%);
  }
  /* only the inner artwork drifts as the lens opens; the page never moves */
  .s3__art {
    position: absolute;
    inset: -6%;
    transform: translate3d(0, calc((0.5 - var(--a)) * 5%), 0) scale(calc(1.06 - var(--a) * 0.06));
  }
  .s3__fil {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The surface is an opaque matte plane; the aperture is a hole cut in it by a radial mask. */
  .s3__surface {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.06) 0%, transparent 36%),
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.016) 0 1px, transparent 1px 7px),
      linear-gradient(180deg, #181c1f, #121518);
    -webkit-mask-image: radial-gradient(ellipse calc(var(--r) * 0.86) var(--r) at var(--cx) var(--cy), transparent 98.5%, #000 100%);
    mask-image: radial-gradient(ellipse calc(var(--r) * 0.86) var(--r) at var(--cx) var(--cy), transparent 98.5%, #000 100%);
  }
  /* a thin glass rim on the aperture: bright upper edge, faint amber, soft inner bevel */
  .s3__ring {
    position: absolute;
    left: var(--cx);
    top: var(--cy);
    width: calc(var(--r) * 1.72);
    height: calc(var(--r) * 2);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-bottom-color: rgba(232, 165, 35, 0.5);
    box-shadow:
      0 0 0 5px rgba(255, 255, 255, 0.035),
      inset 0 10px 26px -12px rgba(255, 255, 255, 0.28),
      inset 0 -14px 30px -16px rgba(232, 165, 35, 0.4),
      0 18px 50px rgba(0, 0, 0, 0.45);
    opacity: calc(1.25 - var(--a));
    pointer-events: none;
  }
  .s3__tag {
    position: absolute;
    bottom: 14px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--glass-dark-edge);
    background: var(--glass-dark-fill-strong);
    box-shadow: var(--glass-inner-line);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .s3__tag--a {
    left: 14px;
    opacity: calc(1.2 - var(--a));
  }
  .s3__tag--b {
    right: 14px;
    color: var(--amber);
    opacity: calc(0.25 + var(--a) * 1.4);
  }
  .s3__control {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    margin-top: 14px;
    padding: 8px 18px;
    border-radius: var(--radius-control);
    border: 1px solid var(--glass-dark-edge);
    background: var(--glass-dark-fill);
    box-shadow: var(--glass-inner-line);
  }
  .s3__control-label {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .s3__range {
    flex: 1 1 160px;
    height: 44px;
    margin: 0;
    background: none;
    accent-color: var(--amber);
    cursor: pointer;
  }
  .s3__labels {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 14px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .s3__label--a {
    color: var(--muted);
  }
  .s3__label--b {
    color: var(--amber);
    text-align: right;
  }
  .s3__cap {
    margin-top: 8px;
  }

  /* Desktop with motion: one sticky stage, one extra viewport of travel (the first of two allowed pins). */
  @media (min-width: 1024px) and (min-height: 640px) {
    :global(.js-motion) .s3 {
      height: 170vh;
      --p: 0;
    }
    :global(.js-motion) .s3__sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      padding-block: var(--header-h) 24px;
    }
  }
  @media (max-width: 1023px) {
    .s3__copy,
    .s3__lens {
      grid-column: 1 / -1;
    }
    .s3__stage {
      aspect-ratio: 4 / 4.2;
    }
  }
</style>
