---
// Scene 03 — THE SIDE YOU CAN'T SEE. A light-to-dark passage built from two approved anatomical illustrations.
//
// The two renders are similar but not pixel-identical, so they are never shown together: the luminous figure
// fades out as the room darkens, the stage rests in a quiet dark midpoint, and only then does the dark figure
// emerge. Nothing is warped, morphed or animated inside either image.
//
// One number drives everything: --p (0..1), written by the script below while the stage is pinned. CSS derives
// the room colour, the two image opacities and the text colour from it. Once the dark figure is established the
// scene is "immersive" and three topics can be opened. Two of them also have a marker on the artwork; the third
// is conceptual and deliberately has none.
//
// Without JavaScript the scene is a still: the luminous figure, the copy, and all three topics written out.
// The artwork is illustrative. It is not a scan, and nothing here is anyone's result.
import { Image } from 'astro:assets';
import light from '../../assets/scene03/HUMAN_S03_LIGHT.webp';
import dark from '../../assets/scene03/HUMAN_S03_DARK.webp';

// Marker positions are fractions of the dark illustration's own frame (1122 × 1402), read off the artwork.
const topics = [
  {
    key: 'heart',
    chip: 'Heart and circulation',
    short: 'Heart',
    label: 'Circulation',
    title: 'More than a heartbeat.',
    body: 'How you feel during the day doesn’t necessarily tell you what your cholesterol levels or blood pressure are. Understanding cardiovascular health can involve looking beyond visible fitness.',
    spot: { x: 59.5, y: 44 },
  },
  {
    key: 'lungs',
    chip: 'Lungs and breathing',
    short: 'Lungs',
    label: 'Breathing',
    title: 'Every breath has a story.',
    body: 'Your lungs exchange oxygen and carbon dioxide with every breath. It’s a remarkable process happening constantly, usually without your attention.',
    spot: { x: 33.5, y: 43 },
  },
  {
    key: 'beyond',
    chip: 'Beyond the visible',
    short: 'Beyond the visible',
    label: 'The invisible',
    title: 'Some answers aren’t visible.',
    body: 'Blood sugar, cholesterol, iron status and thyroid function cannot be determined by looking at someone’s appearance. Understanding these markers, when relevant, requires appropriate assessment and context.',
    spot: null,
  },
];
const widths = (w: number) => [480, 800].filter((x) => x < w).concat([w]);
---

<section class="s3" id="scene-03" aria-labelledby="s3-title" data-s3 data-state="luminous">
  <div class="wrap s3__grid">
    <div class="s3__copy">
      <p class="eyebrow" data-reveal><span class="num">03</span><span>The invisible side of your health</span></p>
      <h2 class="display" id="s3-title" data-reveal="mask">
        <span class="mask"><span>The side</span></span>
        <span class="mask" style="--i:1"><span><em>you can’t see.</em></span></span>
      </h2>
      <div class="prose" data-reveal style="--d:120ms">
        <p>One you can’t see in the mirror or track on a fitness watch.</p>
        <p>
          <strong>What’s happening inside your body?</strong> How are your blood sugar and cholesterol levels? What
          about iron, thyroid and other relevant health markers?
        </p>
        <p>
          You might not know. Most of us were never taught to look beyond how we feel or what we see.
        </p>
      </div>
    </div>

    <div class="s3__pin">
      <div class="s3__stage">
        <figure class="s3__art" aria-describedby="s3-cap">
          <div class="s3__frame">
            <div class="s3__light">
            <Image
              class="s3__img s3__img--light"
              src={light}
              widths={widths(light.width)}
              sizes="(max-width: 1023px) 92vw, 46vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
              alt="Illustration of a translucent human upper body in soft rose tones, showing the ribcage, lungs and heart."
            />
            </div>
            <Image
              class="s3__img s3__img--dark"
              src={dark}
              widths={widths(dark.width)}
              sizes="(max-width: 1023px) 92vw, 46vw"
              format="webp"
              quality={86}
              loading="lazy"
              decoding="async"
              alt=""
            />
            {
              topics
                .filter((t) => t.spot)
                .map((t) => (
                  <button type="button" class="s3__spot" style={`left:${t.spot!.x}%;top:${t.spot!.y}%`} data-s3-spot={t.key} tabindex="-1" aria-hidden="true">
                    <span class="s3__spot-dot" />
                  </button>
                ))
            }
          </div>
        </figure>

        <div class="s3__explore">
          <p class="s3__hint" id="s3-hint">Explore what lies beneath</p>
          <div class="s3__topics" role="group" aria-labelledby="s3-hint">
            {
              topics.map((t, i) => (
                <button type="button" class="s3__chip" data-s3-topic={t.key} aria-label={t.chip} aria-expanded="false" aria-controls={`s3-panel-${t.key}`}>
                  <span class="s3__chip-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="s3__chip-full">{t.chip}</span>
                  <span class="s3__chip-short">{t.short}</span>
                </button>
              ))
            }
          </div>
          <div class="s3__panels">
            {
              topics.map((t) => (
                <article class="s3__panel" id={`s3-panel-${t.key}`} data-s3-panel={t.key} aria-labelledby={`s3-pt-${t.key}`}>
                  <p class="s3__panel-label">{t.label}</p>
                  <h3 id={`s3-pt-${t.key}`}>{t.title}</h3>
                  <p class="s3__panel-body">{t.body}</p>
                  <button type="button" class="s3__close" data-s3-close>
                    <span aria-hidden="true"></span><span class="vh">Close {t.label.toLowerCase()}</span>
                  </button>
                </article>
              ))
            }
          </div>
        </div>
        <p class="note s3__cap" id="s3-cap">An illustration, not a scan. It does not show anyone’s results.</p>
      </div>
    </div>
  </div>

  <div class="s3__after">
    <div class="wrap">
      <p class="s3__after-line" data-reveal>
        A picture of the body can show structure. <em>It can’t tell you everything about your health.</em>
      </p>
      <p class="s3__after-note" data-reveal style="--d:100ms">
        Many health questions depend on personal history, symptoms, appropriate testing and clinical interpretation.
        Not everyone needs every test.
      </p>
    </div>
  </div>
</section>

<script>
  // Progress for the pinned stage, the three scene states, and the topic disclosure. One rAF-throttled scroll
  // listener that only runs while the scene is near the viewport; no per-frame loop, no scroll hijacking.
  const sec = document.querySelector<HTMLElement>('[data-s3]');
  const pin = sec?.querySelector<HTMLElement>('.s3__pin');
  const stage = sec?.querySelector<HTMLElement>('.s3__stage');
  if (sec && pin && stage) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const chips = Array.from(sec.querySelectorAll<HTMLButtonElement>('[data-s3-topic]'));
    const spots = Array.from(sec.querySelectorAll<HTMLButtonElement>('[data-s3-spot]'));
    const panels = Array.from(sec.querySelectorAll<HTMLElement>('[data-s3-panel]'));
    const explore = sec.querySelector<HTMLElement>('.s3__explore')!;
    let open: string | null = null;
    let state = '';

    const select = (key: string | null, returnFocus = false) => {
      const last = open;
      open = key;
      if (key) sec.dataset.topic = key;
      else delete sec.dataset.topic;
      chips.forEach((c) => c.setAttribute('aria-expanded', String(c.dataset.s3Topic === key)));
      spots.forEach((s) => s.classList.toggle('is-on', s.dataset.s3Spot === key));
      panels.forEach((p) => (p.hidden = p.dataset.s3Panel !== key));
      if (!key && returnFocus && last) chips.find((c) => c.dataset.s3Topic === last)?.focus();
    };
    select(null);

    const setState = (next: string) => {
      if (next === state) return;
      state = next;
      sec.dataset.state = next;
      // The controls exist only in the dark world. Outside it they are inert, and any open topic is put away.
      const ready = next === 'immersive';
      explore.inert = !ready;
      spots.forEach((s) => (s.disabled = !ready));
      if (!ready && open) select(null);
    };

    let ticking = false;
    const update = () => {
      ticking = false;
      const span = pin.offsetHeight - stage.offsetHeight;
      const top = pin.getBoundingClientRect().top;
      let p = span > 8 ? -top / span : top < window.innerHeight * 0.5 ? 1 : 0;
      p = Math.min(1, Math.max(0, p));
      // Reduced motion: the same three states, but stepped rather than scrubbed.
      if (reduce.matches) p = p < 0.3 ? 0 : 1;
      sec.style.setProperty('--p', p.toFixed(4));
      setState(p < 0.1 ? 'luminous' : p < 0.64 ? 'passage' : 'immersive');
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    let listening = false;
    new IntersectionObserver(
      ([en]) => {
        if (en.isIntersecting && !listening) {
          window.addEventListener('scroll', request, { passive: true });
          window.addEventListener('resize', request);
          listening = true;
        } else if (!en.isIntersecting && listening) {
          window.removeEventListener('scroll', request);
          window.removeEventListener('resize', request);
          listening = false;
        }
        request();
      },
      { rootMargin: '25% 0px 25% 0px' },
    ).observe(sec);
    reduce.addEventListener('change', request);
    update();

    chips.forEach((c) => c.addEventListener('click', () => select(open === c.dataset.s3Topic ? null : c.dataset.s3Topic!)));
    spots.forEach((s) => s.addEventListener('click', () => select(open === s.dataset.s3Spot ? null : s.dataset.s3Spot!)));
    sec.querySelectorAll('[data-s3-close]').forEach((b) => b.addEventListener('click', () => select(null, true)));
    sec.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && open) {
        e.preventDefault();
        select(null, true);
      }
    });
  }
</script>

<style>
  .s3 {
    /* scene palette (directional values from the approved artwork) */
    --s3-lum: #f2e6e1;
    --s3-blush: #e9c5cf;
    --s3-rose: #c77991;
    --s3-garnet: #89445f;
    --p: 0;
    /* derived ramps, all 0..1 */
    --room: clamp(0, (var(--p) - 0.1) / 0.24, 1); /* the room darkens: 0.10 → 0.34 */
    --lo: calc(1 - var(--room)); /* the luminous figure leaves with the light */
    --dk: clamp(0, (var(--p) - 0.42) / 0.2, 1); /* the dark figure arrives: 0.42 → 0.62, after a quiet gap */
    --ink: clamp(0, (var(--p) - 0.2) / 0.04, 1); /* text flips from ink to warm white as the room passes mid-tone */
    position: relative;
    background: color-mix(in srgb, var(--carbon) calc(var(--room) * 100%), var(--s3-lum));
    color: color-mix(in srgb, var(--text-on-dark) calc(var(--ink) * 100%), var(--text-on-light));
    --text: color-mix(in srgb, var(--text-on-dark) calc(var(--ink) * 100%), var(--text-on-light));
    --muted: color-mix(in srgb, var(--muted-on-dark) calc(var(--ink) * 100%), var(--muted-on-light));
    --rule: color-mix(in srgb, var(--rule-on-dark) calc(var(--ink) * 100%), var(--rule-on-light));
    --accent: color-mix(in srgb, var(--amber) calc(var(--ink) * 100%), var(--amber-deep));
  }
  .s3__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
  }
  .s3__copy {
    grid-column: 1 / span 5;
    padding-block: var(--section-y) 48px;
  }
  .s3__copy h2 {
    margin: var(--stack-label) 0 var(--stack-head);
  }
  .s3__pin {
    grid-column: 6 / span 7;
  }
  .s3__stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 24px 40px;
  }

  /* ---- the artwork: one frame, two stills, never visible together ---- */
  .s3__art {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 0;
  }
  .s3__frame {
    position: relative;
    aspect-ratio: 1122 / 1402;
    width: min(100%, 560px);
  }
  /* edges dissolve into the room, so neither still shows a rectangle */
  .s3__light,
  .s3__frame :global(.s3__img--dark) {
    /* feather the four edges only, so the shoulders and ribcage stay whole */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 11%, #000 89%, transparent 100%), linear-gradient(180deg, transparent 0, #000 8%, #000 86%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 11%, #000 89%, transparent 100%), linear-gradient(180deg, transparent 0, #000 8%, #000 86%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  /* The luminous still keeps its own proportions (it is a slightly squarer render) and sits on the same chest
     line as the dark one. Behind it is a backing that darkens with the room, so as the still fades it sinks
     into the darkness instead of glowing against it. */
  .s3__light {
    position: absolute;
    left: 0;
    right: 0;
    top: 6%;
    aspect-ratio: 1199 / 1312;
    background: rgb(11 13 15 / clamp(0, var(--room) * 3, 1));
    opacity: clamp(0, (0.37 - var(--p)) / 0.03, 1); /* fully gone by 0.37; the dark still starts at 0.42 */
  }
  .s3__frame :global(.s3__img--light) {
    display: block;
    width: 100%;
    height: 100%;
    opacity: var(--lo);
  }
  .s3__frame :global(.s3__img--dark) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: var(--dk);
  }
  .s3[data-topic='beyond'] .s3__frame :global(.s3__img--dark) {
    opacity: calc(var(--dk) * 0.5);
  }
  .s3__frame :global(.s3__img--dark) {
    transition: opacity 420ms var(--ease-human);
  }
  .s3:not([data-state='immersive']) .s3__frame :global(.s3__img--dark) {
    transition: none; /* scroll owns the opacity during the passage */
  }
  .s3__cap {
    margin-top: 14px;
    text-align: center;
  }
  /* Scene 02's ivory hands over to the blush room without a seam */
  .s3::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(120px, 18vw, 240px);
    background: linear-gradient(180deg, var(--ivory), rgba(236, 232, 223, 0));
    opacity: var(--lo);
    pointer-events: none;
  }

  /* ---- markers on the artwork (pointer conveniences; the labelled buttons below are the real controls) ---- */
  .s3__spot {
    position: absolute;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 500ms var(--ease-human) 200ms,
      visibility 0s linear 700ms;
  }
  .s3[data-state='immersive'] .s3__spot {
    opacity: 1;
    visibility: visible;
    transition-delay: 500ms, 0s;
  }
  .s3__spot-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--s3-blush);
  }
  .s3__spot-dot::before,
  .s3__spot-dot::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(233, 197, 207, 0.55);
    inset: -8px;
    transition:
      inset var(--motion-control) var(--ease-human),
      border-color var(--motion-control) var(--ease-human),
      opacity var(--motion-control) var(--ease-human);
  }
  .s3__spot-dot::after {
    inset: -14px;
    opacity: 0.4;
  }
  @media (hover: hover) {
    .s3__spot:hover .s3__spot-dot::before {
      inset: -10px;
      border-color: var(--s3-blush);
    }
  }
  .s3__spot:global(.is-on) .s3__spot-dot {
    background: #fff;
  }
  .s3__spot:global(.is-on) .s3__spot-dot::before {
    inset: -9px;
    border-width: 2px;
    border-color: var(--s3-blush);
  }
  .s3__spot:global(.is-on) .s3__spot-dot::after {
    opacity: 0.8;
  }

  /* ---- explore: a hint, three labelled topics, one panel at a time ---- */
  .s3__explore {
    position: relative;
    width: 100%;
    display: grid;
    justify-items: center;
    gap: 12px;
    margin-top: 16px;
  }
  .s3__hint {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--text-on-dark);
  }
  .s3__topics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .s3__chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(243, 239, 230, 0.28);
    background: rgba(11, 13, 15, 0.4);
    color: var(--text-on-dark);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition:
      background var(--motion-micro) var(--ease-human),
      border-color var(--motion-micro) var(--ease-human);
  }
  .s3__chip-short {
    display: none;
  }
  .s3__chip-n {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--s3-blush);
    font-variant-numeric: tabular-nums;
  }
  @media (hover: hover) {
    .s3__chip:hover {
      border-color: rgba(243, 239, 230, 0.6);
    }
  }
  /* selected: a filled surface, a heavier edge and a leading mark — not colour alone */
  .s3__chip[aria-expanded='true'] {
    background: rgba(243, 239, 230, 0.12);
    border-color: var(--text-on-dark);
    font-weight: 600;
  }
  .s3__chip[aria-expanded='true'] .s3__chip-n::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--s3-blush);
    vertical-align: 1px;
  }
  .s3__chip:focus-visible,
  .s3__close:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
    border-radius: var(--radius-pill);
  }
  .s3__panel {
    position: relative;
    padding: 22px 60px 24px 24px;
    border-radius: var(--radius-control);
    border: 1px solid rgba(243, 239, 230, 0.16);
    background: rgba(16, 18, 21, 0.86);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.36);
    color: var(--text-on-dark);
    text-align: left;
  }
  .s3__panel-label {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--s3-blush);
  }
  .s3__panel h3 {
    margin-top: 10px;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.625rem, 2.2vw, 2rem);
    line-height: 1.1;
  }
  .s3__panel-body {
    margin-top: 10px;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: #dcd7cc;
  }
  .s3__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--text-on-dark);
    cursor: pointer;
  }
  .s3__close > span:first-child {
    position: relative;
    width: 14px;
    height: 14px;
  }
  .s3__close > span:first-child::before,
  .s3__close > span:first-child::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 6.5px;
    height: 1.5px;
    background: currentColor;
    transform: rotate(45deg);
  }
  .s3__close > span:first-child::after {
    transform: rotate(-45deg);
  }
  @media (hover: hover) {
    .s3__close:hover {
      background: rgba(243, 239, 230, 0.1);
    }
  }

  /* ---- after the stage: what a picture can't tell you ---- */
  .s3__after {
    background: var(--carbon);
    color: var(--text-on-dark);
    padding-block: clamp(56px, 7vw, 104px) var(--section-y);
  }
  .s3__after-line {
    max-width: 20em;
    font-size: clamp(1.5rem, 2.9vw, 2.625rem);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .s3__after-line em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.08em;
    letter-spacing: -0.01em;
  }
  .s3__after-note {
    margin-top: 24px;
    max-width: var(--measure);
    color: var(--muted-on-dark);
    text-wrap: pretty;
  }

  /* ---- with JavaScript: a pinned stage, a bounded stretch of scroll, and the interactive controls ---- */
  :global(.js) .s3__pin {
    height: 300vh;
    height: 300svh;
  }
  :global(.js) .s3__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    justify-content: center;
    padding-block: calc(var(--header-h) + 8px) 20px;
  }
  :global(.js) .s3__copy {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--header-h) 24px;
  }
  :global(.js) .s3__art {
    flex: 1 1 auto;
    justify-content: center;
  }
  /* the frame takes whatever height the viewport leaves and keeps the artwork's own proportions */
  :global(.js) .s3__frame {
    width: auto;
    height: min(100%, 78vh);
    max-width: 100%;
    flex: 0 1 auto;
    min-height: 0;
  }
  :global(.js) .s3__art {
    min-height: 0;
    height: 0; /* flex item: grow into the free space, never push the controls off the stage */
  }
  :global(.js) .s3__cap {
    flex: none;
    color: color-mix(in srgb, var(--muted-on-dark) calc(var(--ink) * 100%), var(--muted-on-light));
  }
  :global(.js) .s3__explore {
    flex: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 500ms var(--ease-human),
      visibility 0s linear 500ms;
  }
  :global(.js) .s3[data-state='immersive'] .s3__explore {
    opacity: 1;
    visibility: visible;
    transition-delay: 350ms, 0s;
