      background: rgba(255, 255, 255, 0.5);
    }
  }
  .s3__ex {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 320ms var(--ease-human),
      visibility 0s linear 320ms;
  }
  .s3[data-state='explore'] .s3__ex {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .s3__ex img {
    opacity: 0;
  }
  .s3__ex img:not([src]) {
    visibility: hidden;
  }

  /* ---- markers on the overview ---- */
  .s3__spots {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 300ms var(--ease-human),
      visibility 0s linear 300ms;
  }
  .s3__spots:global(.is-on) {
    opacity: 1;
    visibility: visible;
    transition-delay: 120ms, 0s;
  }
  .s3__spot {
    position: absolute;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .s3__spot span {
    position: relative;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.7);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: transform var(--motion-control) var(--ease-human);
  }
  .s3__spot span::after {
    content: '';
    position: absolute;
    inset: 7px;
    border-radius: 50%;
    background: #fff;
  }
  @media (hover: hover) {
    .s3__spot:hover span {
      transform: scale(1.18);
    }
  }
  .s3__spot:focus-visible {
    outline: 3px solid #3a1c23;
    outline-offset: 0;
  }

  /* ---- the system list ---- */
  .s3__nav {
    position: relative;
    z-index: 3;
  }
  .s3__nav ul {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px;
    border-radius: 34px;
    background: var(--glass);
    border: 1px solid var(--glass-edge);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
  }
  .s3__sys {
    position: relative;
    display: grid;
