  }
  .s3__info-eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .s3__info h3,
  .s3__plain h3 {
    margin-top: 10px;
    font-family: var(--serif);
    font-style: italic;
