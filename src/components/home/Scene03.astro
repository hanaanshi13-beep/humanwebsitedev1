    color: inherit;
    cursor: pointer;
    transition:
      background var(--motion-micro) var(--ease-human),
      border-color var(--motion-micro) var(--ease-human),
      color var(--motion-micro) var(--ease-human);
  }
  .s3__sys svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
