  }
  .s3__info--stage {
    display: none;
  }
  .s3__cap {
    text-align: center;
    color: var(--muted);
  }

  /* ---- after the stage: what a picture can't tell you, then back to the page ---- */
  .s3__after {
    position: relative;
    background: linear-gradient(180deg, rgba(58, 28, 35, 0) 0, var(--s3-deep) 140px);
    color: var(--text-on-dark);
