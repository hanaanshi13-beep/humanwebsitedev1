---
// Scene "04" — THROUGH HER EYES. Our approach to women's health.
// A scroll-driven passage between "The side you can't see" and "Feeling fine doesn't tell you everything":
//   01 Through her eyes   a close portrait; the camera pulls back and the headline arrives beside her
//   02 Her world          three lives in one triptych, then the first thought of the message
//   03 HUMAN's commitment an ivory editorial page rises over the film like a curtain (native scroll, no script)
//
// One DOM serves every mode, so the copy cannot drift between versions:
//   - film     wide screens with motion: the stage is pinned and driven by src/scripts/through-her-eyes.ts
//   - flow     phones, short screens, reduced motion, or no JavaScript: the same blocks in normal order
// Only the editorial page carries the readable copy for assistive technology; the headline and first paragraph
// repeated on the film are marked aria-hidden. The copy below is founder-approved (2026-11): do not edit it here
// without a decision.
import { getImage } from 'astro:assets';
import hero from '../../assets/through-her-eyes/through-her-eyes-01-hero.webp';
import window_ from '../../assets/through-her-eyes/through-her-eyes-02-window.webp';
import walkway from '../../assets/through-her-eyes/through-her-eyes-03-walkway.webp';
import garden from '../../assets/through-her-eyes/through-her-eyes-04-garden.webp';
import together from '../../assets/through-her-eyes/through-her-eyes-05-together.webp';

const COPY = {
  num: '04',
  eyebrow: 'Our approach to women’s health',
  head: ['Women’s health', 'should never be', 'an afterthought.'],
  p1lead: 'Being a woman comes with its own set of health challenges.',
  p1rest: 'And understanding what’s happening inside your body shouldn’t be this difficult.',
  p2: 'Whether it’s irregular periods, hormonal changes, unexplained fatigue, PCOS or navigating menopause, your concerns deserve attention.',
  p3: 'At HUMAN, we’re putting a dedicated focus on women’s health. We’re developing female-specific blood tests, personalised health insights and health plans that take your body’s unique needs into account.',
};

// The master portrait is served at its full supplied size: the camera needs every pixel it has.
const heroImg = await getImage({ src: hero, width: hero.width, format: 'webp', quality: 86 });
const sized = async (src: ImageMetadata, small: number) => {
  const s = await getImage({ src, width: small, format: 'webp', quality: 80 });
  const f = await getImage({ src, width: src.width, format: 'webp', quality: 84 });
  return { src: f.src, srcset: `${s.src} ${small}w, ${f.src} ${src.width}w`, w: src.width, h: src.height };
};
// Panel order is fixed by the brief: left, centre, right. `pos` keeps each face inside its narrow slice.
const panels = [
  { img: await sized(window_, 560), pos: '50% 30%', alt: 'A young woman sitting by a window with an open book, looking out, in soft morning light.' },
  { img: await sized(walkway, 560), pos: '44% 30%', alt: 'A woman in a burgundy kurta walking through a sunlit terracotta passageway, a leather bag on her shoulder.' },
  { img: await sized(garden, 560), pos: '56% 28%', alt: 'An older woman with silver hair smiling as she tends the leaves of a plant in a garden.' },
];
const group = await sized(together, 760);
---

<section class="the" id="through-her-eyes" aria-labelledby="the-title" data-the>
  <div class="the__film" data-the-film>
    <div class="the__stage on-dark" data-the-stage>
      <figure class="the__hero" data-nav-tone="dark">
        <img
          class="the__hero-img"
          data-the-hero
          src={heroImg.src}
          width={hero.width}
          height={hero.height}
          alt="A young woman with dark hair, in a linen shirt, looking directly at the camera against a deep burgundy background."
          loading="lazy"
          decoding="async"
          draggable="false"
        />
        <span class="the__hero-shade" data-the-shade aria-hidden="true"></span>
        <span class="the__veil" data-the-veil aria-hidden="true"></span>
      </figure>

      <!-- the headline as it arrives beside the portrait (a repeat of the editorial heading below) -->
      <div class="wrap the__lead" aria-hidden="true">
        <p class="eyebrow the__lead-eyebrow the__in" data-the-line="0"><span class="num">{COPY.num}</span><span>{COPY.eyebrow}</span></p>
        <p class="display the__lead-head">
          <span class="mask"><span class="the__in" data-the-line="1">{COPY.head[0]}</span></span>
          <span class="mask"><span class="the__in" data-the-line="2">{COPY.head[1]}</span></span>
          <span class="mask"><em class="the__in" data-the-line="3">{COPY.head[2]}</em></span>
        </p>
      </div>

      <div class="the__montage" data-the-montage data-nav-tone="dark">
        {
          panels.map((p) => (
            <figure class="the__panel" data-the-panel>
              <img
                src={p.img.src}
                srcset={p.img.srcset}
                sizes="(min-width: 1024px) 75vh, 34vw"
                width={p.img.w}
                height={p.img.h}
                alt={p.alt}
                style={`object-position:${p.pos}`}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </figure>
          ))
        }
        <span class="the__montage-shade" aria-hidden="true"></span>
        <!-- the first paragraph over the triptych (a repeat of the editorial copy below) -->
        <div class="wrap the__para" data-the-para aria-hidden="true">
          <p class="the__para-lead">{COPY.p1lead}</p>
          <p class="the__para-rest">{COPY.p1rest}</p>
        </div>
      </div>

      <div class="wrap the__hud">
        <span class="the__hud-label" data-the-label aria-hidden="true">01 / Through her eyes</span>
        <span class="the__hud-line" aria-hidden="true"><b data-the-bar></b></span>
        <a class="the__skip" href="#the-message">Skip to the message <span class="arr arr--down" aria-hidden="true"></span></a>
      </div>
    </div>

    <!-- scroll distance for the film; the editorial page then rises over the pinned stage -->
    <div class="the__travel" data-the-travel aria-hidden="true"></div>

    <div class="the__final on-light" id="the-message" tabindex="-1" data-nav-tone="light">
      <div class="wrap the__grid">
        <figure class="the__group" data-reveal="fade">
          <img
            src={group.src}
            srcset={group.srcset}
            sizes="(max-width: 899px) 92vw, 46vw"
            width={group.w}
            height={group.h}
            alt="Three women of different ages together in warm sunlight: a young woman and an older woman with silver hair sitting, a woman in a burgundy kurta standing between them."
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="the__copy">
          <p class="eyebrow" data-reveal><span class="num">{COPY.num}</span><span>{COPY.eyebrow}</span></p>
          <h2 class="display the__title" id="the-title" data-reveal="mask">
            <span class="mask"><span>{COPY.head[0]}</span></span>{' '}
            <span class="mask" style="--i:1"><span>{COPY.head[1]}</span></span>{' '}
            <span class="mask" style="--i:2"><span><em>{COPY.head[2]}</em></span></span>
          </h2>
          <div class="the__prose" data-reveal style="--d:140ms">
            <p>{COPY.p1lead} {COPY.p1rest}</p>
            <p>{COPY.p2}</p>
            <hr class="rule the__rule" />
            <p class="the__commit">{COPY.p3}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/through-her-eyes.ts';
</script>

<style>
  /* Palette. The two darks are sampled from the supplied portrait so its edges dissolve into the room; the ivory
     is the site's own paper, so the editorial page flows straight into the next section. */
  .the {
    --the-night: #1b0908; /* the portrait's outer band */
    --the-wine: #281719; /* the room around the triptych (approved reference) */
    --the-from: #3a1c23; /* the colour "The side you can't see" ends on (its --s3-deep) */
    --the-lead-in: clamp(96px, 12vw, 180px); /* = that section's hand-back band, which this one replaces */
    position: relative;
    z-index: 1;
    /* Begin exactly where the previous section's deep band ends, over the band it keeps for a light successor,
       so the body-systems story runs straight into a real person without a pale gap. */
    margin-top: calc(-1 * var(--the-lead-in));
    padding-top: var(--the-lead-in);
    background: linear-gradient(180deg, var(--the-from) 0, var(--the-night) var(--the-lead-in));
    color: var(--text-on-dark);
  }
  .the__stage {
    position: relative;
    background: var(--the-night);
    overflow: hidden;
    isolation: isolate;
  }
  .the__hero {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .the__hero-img {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }
  .the__hero-shade,
  .the__montage-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* the photograph's top edge dissolves out of the room above it, so the section has no seam */
  .the__veil {
    position: absolute;
    inset: 0 0 auto 0;
    height: clamp(90px, 14vh, 160px);
    background: linear-gradient(180deg, var(--the-night) 0%, rgba(27, 9, 8, 0.6) 45%, rgba(27, 9, 8, 0) 100%);
    pointer-events: none;
  }
  .the__lead-eyebrow {
    color: rgba(243, 239, 230, 0.78);
  }
  .the__lead-eyebrow .num {
    color: #d8b27c;
  }
  .the__lead-head {
    margin-top: var(--stack-label);
    color: var(--text-on-dark);
  }
  .the__lead-head .mask {
    display: block;
  }
  .the__montage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    background: var(--the-wine);
  }
  .the__panel {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .the__panel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }
  .the__para,
  .the__hud,
  .the__travel {
    display: none;
  }
  .the__para-lead {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.875rem, 3.5vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.012em;
    max-width: 15em;
    text-wrap: balance;
  }
  .the__para-rest {
    margin-top: 18px;
    max-width: 34em;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    line-height: 1.5;
    color: rgba(243, 239, 230, 0.9);
    text-wrap: pretty;
  }

  /* ---- the editorial page: HUMAN's commitment ---- */
  .the__final {
    position: relative;
    z-index: 2;
    background: var(--paper);
    color: var(--text-on-light);
    scroll-margin-top: 0; /* land with the page, not under the header gap */
    outline: none;
  }
  .the__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: clamp(36px, 6vw, 56px);
    align-items: center;
  }
  .the__group {
    grid-column: 1 / span 6;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-image);
    background: #d6c6b1;
    aspect-ratio: 1122 / 1402;
  }
  .the__group img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .the__copy {
    grid-column: 7 / span 6;
  }
  .the__title {
    margin: var(--stack-label) 0 var(--stack-head);
    font-size: clamp(2.125rem, 3.7vw, 3.75rem);
  }
  .the__prose {
    max-width: 32em;
  }
  .the__prose p {
    font-size: clamp(1.0625rem, 1.2vw, 1.1875rem);
    line-height: 1.62;
    color: var(--muted);
    text-wrap: pretty;
  }
  .the__prose p + p {
    margin-top: 1em;
  }
  .the__rule {
    margin: clamp(20px, 2.2vw, 28px) 0;
  }
  .the__prose .the__commit {
    margin-top: 0;
    color: var(--text);
    font-weight: 500;
  }

  /* =========================================================================================================
     FLOW: phones, tablets in portrait, short screens, reduced motion, no JavaScript.
     The same three blocks in reading order. Nothing is pinned and nothing waits for the visitor.
     ========================================================================================================= */
  .the__hero {
    height: min(82svh, 760px);
    min-height: 460px;
  }
  .the__hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 54% 34%;
  }
  .the__hero-shade {
    background: linear-gradient(0deg, rgba(24, 9, 8, 0.94) 0%, rgba(24, 9, 8, 0.62) 30%, rgba(24, 9, 8, 0) 58%);
  }
  .the__lead {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * clamp(150px, 34vw, 260px));
    padding-bottom: clamp(28px, 6vw, 48px);
  }
  .the__lead-head {
    font-size: clamp(2.25rem, 9.6vw, 4.25rem);
  }
  .the__montage {
    margin-top: 3px;
  }
  .the__panel {
    aspect-ratio: 9 / 16;
  }
  .the__final {
    padding-block: clamp(56px, 10vw, 112px) var(--section-y);
  }
  @media (max-width: 899px) {
    .the__group,
    .the__copy {
      grid-column: 1 / -1;
    }
    .the__group {
      max-width: 620px;
      width: 100%;
      justify-self: center;
    }
  }
  @media (min-width: 600px) and (max-width: 1023px) {
    .the__panel {
      aspect-ratio: 3 / 4;
    }
  }

  /* =========================================================================================================
     FILM: wide screens with motion. The stage is pinned; the script writes transforms and opacity only.
     Thresholds match the site's other pinned scenes (min 1024 × 640).
     ========================================================================================================= */
  @media (min-width: 1024px) and (min-height: 640px) {
    :global(html.js-motion) .the__stage {
      position: sticky;
      top: 0;
      height: 100vh;
      height: 100svh;
    }
    /* 180 stage heights of travel for the portrait and the triptych (the prototype's 0–72 %), then the
       editorial page takes one more stage height to rise over it. */
    :global(html.js-motion) .the__travel {
      display: block;
      height: 180vh;
      height: 180svh;
    }
    :global(html.js-motion) .the__hero,
    :global(html.js-motion) .the__montage {
      position: absolute;
      inset: 0;
      height: auto;
      min-height: 0;
      margin: 0;
    }
    :global(html.js-motion) .the__hero-img {
      inset: 0 auto auto 0;
      width: auto;
      height: auto;
      max-width: none;
      object-fit: fill;
      transform-origin: 0 0;
      will-change: transform;
      /* the left edge dissolves into the room when the portrait moves right */
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 13%);
      mask-image: linear-gradient(90deg, transparent 0, #000 13%);
    }
    :global(html.js-motion) .the__hero-shade {
      background:
        linear-gradient(90deg, rgba(22, 8, 8, 0.94) 0%, rgba(26, 10, 9, 0.8) 24%, rgba(26, 10, 9, 0.32) 46%, rgba(26, 10, 9, 0) 64%),
        linear-gradient(0deg, rgba(22, 8, 8, 0.55) 0%, rgba(22, 8, 8, 0) 40%);
      will-change: opacity;
    }
    /* while the stage is still rising into view; the script fades this out as it pins */
    :global(html.js-motion) .the__veil {
      height: 42vh;
      background: linear-gradient(180deg, var(--the-night) 0%, rgba(27, 9, 8, 0.7) 30%, rgba(27, 9, 8, 0) 100%);
      will-change: opacity;
    }
    :global(html.js-motion) .the__lead {
      position: absolute;
      inset: 0;
      z-index: 2;
      margin: 0;
      padding-block: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      pointer-events: none;
    }
    :global(html.js-motion) .the__lead-head {
      font-size: var(--fs-display);
      max-width: 9.5em;
    }
    :global(html.js-motion) .the__in {
      will-change: transform, opacity;
    }
    :global(html.js-motion) .the__lead-head .the__in {
      display: block;
    }
    :global(html.js-motion) .the__montage {
      z-index: 3;
      opacity: 0;
      margin: 0;
    }
    :global(html.js-motion) .the__panel {
      aspect-ratio: auto;
      will-change: transform, clip-path;
    }
    :global(html.js-motion) .the__panel img {
      will-change: transform;
    }
    :global(html.js-motion) .the__montage-shade {
      background:
        linear-gradient(0deg, rgba(22, 14, 16, 0.9) 0%, rgba(27, 19, 19, 0.45) 28%, rgba(27, 19, 19, 0) 56%),
        linear-gradient(180deg, rgba(28, 19, 19, 0.3), rgba(28, 19, 19, 0) 20%);
    }
    :global(html.js-motion) .the__para {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: clamp(72px, 12vh, 120px);
      z-index: 2;
      text-shadow: 0 1px 20px rgba(0, 0, 0, 0.45);
      opacity: 0;
      will-change: transform, opacity;
    }
    :global(html.js-motion) .the__hud {
      display: grid;
      grid-template-columns: auto minmax(60px, 140px) 1fr;
      align-items: center;
      gap: 18px;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 18px;
      z-index: 4;
      color: rgba(243, 239, 230, 0.78);
    }
    .the__hud-label {
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .the__hud-line {
      position: relative;
      height: 1px;
      background: rgba(243, 239, 230, 0.26);
      overflow: hidden;
    }
    .the__hud-line b {
      position: absolute;
      inset: 0;
      background: #d8b27c;
      transform: scaleX(0);
      transform-origin: 0 50%;
    }
    .the__skip {
      justify-self: end;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      padding: 0 4px;
      color: rgba(243, 239, 230, 0.86);
      font-size: var(--fs-note);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: underline;
      text-underline-offset: 4px;
      text-decoration-thickness: 1px;
    }
    .the__skip:hover {
      color: #fff;
    }
    .the__skip .arr::before {
      width: 14px;
      height: 14px;
    }
    /* the editorial page: one full stage height, its content centred, never clipped (it simply grows) */
    :global(html.js-motion) .the__final {
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      align-items: center;
      padding-block: calc(var(--header-h) + clamp(16px, 3vh, 40px)) clamp(36px, 6vh, 72px);
    }
    :global(html.js-motion) .the__group {
      max-height: calc(100svh - var(--header-h) - clamp(72px, 12vh, 128px));
      aspect-ratio: auto;
      height: min(calc(100svh - var(--header-h) - clamp(72px, 12vh, 128px)), calc((100vw - 2 * var(--gutter)) * 0.5 * 1402 / 1122));
    }
  }
</style>
