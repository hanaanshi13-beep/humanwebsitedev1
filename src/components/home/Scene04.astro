---
// Scene 04 — FEELING FINE DOESN'T TELL YOU EVERYTHING. WORKING copy: needs medical review before public marketing.
// Four marker *categories* on one neutral line. No values, no status colours.
import Slot from '../Slot.astro';
const markers = ['Blood sugar', 'Cholesterol', 'Iron', 'Thyroid'];
---

<section class="section on-light s4" id="scene-04" aria-labelledby="s4-title">
  <div class="wrap">
    <div class="split">
      <div class="a">
        <p class="eyebrow" data-reveal><span class="num">04</span><span>Why it matters</span></p>
        <h2 class="display" id="s4-title" data-reveal="mask">
          <span class="mask"><span>Feeling fine</span></span>
          <span class="mask" style="--i:1"><span><em>doesn’t tell you everything.</em></span></span>
        </h2>
      </div>
      <div class="b prose s4__prose" data-reveal style="--d:120ms">
        <p>
          You can feel fine and still have health markers that deserve attention. Some changes happen gradually,
          without obvious signs.
        </p>
        <p>Understanding your health shouldn’t begin only when something feels wrong.</p>
        <p><strong>It’s not about assuming the worst. It’s about making more informed decisions.</strong></p>
      </div>
    </div>

    <figure class="s4__fig" data-reveal="fade">
      <div class="s4__photo">
        <Slot name="feeling-fine" ratio="3 / 2" tone="ivory" shape="a" position="30% 40%" sizes="(max-width: 899px) 100vw, 58vw" />
      </div>
      <div class="s4__side">
        <ul class="s4__line">
          {
            markers.map((m, i) => (
              <li style={`--i:${i}`}>
                <span class="s4__dot" aria-hidden="true" />
                {m}
              </li>
            ))
          }
        </ul>
        <figcaption class="note">
          Examples of health-marker categories only — testing needs vary by person and clinical context.
        </figcaption>
      </div>
    </figure>
  </div>
</section>

<style>
  .s4 h2 {
    margin: var(--stack-label) 0 0;
  }
  .s4__prose {
    padding-top: clamp(0px, 3.4vw, 46px);
  }
  .s4__fig {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: 36px;
    align-items: end;
    margin-top: clamp(48px, 6vw, 88px);
  }
  .s4__photo {
    grid-column: 1 / span 7;
    position: relative;
  }
  .s4__side {
    grid-column: 9 / span 4;
  }
  .s4__line {
    position: relative;
    display: grid;
    row-gap: clamp(16px, 2vw, 26px);
    padding-left: 34px;
    margin-bottom: 26px;
  }
  .s4__line::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 10px;
    bottom: 14px;
    width: 1px;
    background: var(--rule);
    transform-origin: top;
  }
  .s4__line li {
    position: relative;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-h3);
    line-height: 1.15;
  }
  .s4__dot {
    position: absolute;
    left: -34px;
    top: 0.32em;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid var(--accent);
  }
  :global(.js-motion) .s4__line::before {
    transform: scaleY(0);
    transition: transform 1000ms var(--ease-inout) 150ms;
  }
  :global(.js-motion) .s4__fig.is-in .s4__line::before {
    transform: none;
  }
  :global(.js-motion) .s4__line li {
    opacity: 0;
    transition: opacity 500ms var(--ease-out) calc(250ms + var(--i) * 220ms);
  }
  :global(.js-motion) .s4__fig.is-in .s4__line li {
    opacity: 1;
  }
  @media (max-width: 899px) {
    .s4__photo,
    .s4__side {
      grid-column: 1 / -1;
    }
  }
</style>
