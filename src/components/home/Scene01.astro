---
// Scene 01 — YOU TAKE CARE OF YOURSELF. Paper chapter: three everyday moments of care as an editorial triptych.
// Photographs load by filename (see docs/HUMAN-VISUAL-ASSET-BIBLE.md); until then the frames show abstract artwork.
import Slot from '../Slot.astro';
---

<section class="section on-light s1" id="scene-01" aria-labelledby="s1-title">
  <div class="wrap s1__grid">
    <div class="s1__copy">
      <p class="eyebrow" data-reveal><span class="num">01</span><span>Where it starts</span></p>
      <h2 class="display" id="s1-title" data-reveal="mask">
        <span class="mask"><span>You take care</span></span>
        <span class="mask" style="--i:1"><span><em>of yourself.</em></span></span>
      </h2>
      <div class="prose" data-reveal style="--d:120ms">
        <p>
          You try to eat well. You work out. You go for a run. You try to get enough sleep. Maybe you’re working
          towards a fitness goal. Maybe you just want to feel better, stay active and take care of yourself.
        </p>
        <p><strong>You put effort into becoming a healthier version of yourself.</strong></p>
      </div>
    </div>

    <ul class="s1__trip" aria-label="Everyday care">
      <li class="s1__f s1__f--a" data-reveal="clip">
        <Slot
          name="care-walk"
          ratio="3 / 2"
          tone="ivory"
          shape="d"
          position="50% 50%"
          sizes="(max-width: 899px) 100vw, 46vw"
          alt="A runner's view of his own legs in white socks, resting on an outdoor running track, with his neon-green running shoes and sports sunglasses beside him."
        />
        <p class="s1__tag"><span aria-hidden="true">01</span> Move, when you can</p>
      </li>
      <li class="s1__f s1__f--b" data-reveal="clip" style="--d:140ms">
        <Slot
          name="care-breakfast"
          ratio="4 / 5"
          tone="amber"
          shape="b"
          position="50% 40%"
          sizes="(max-width: 899px) 50vw, 22vw"
          alt="Looking down from a man's point of view: he holds a wooden board of scrambled eggs, a toasted bagel, avocado halves and grilled meat over a kitchen floor."
        />
        <p class="s1__tag"><span aria-hidden="true">02</span> Eat well</p>
      </li>
      <li class="s1__f s1__f--c" data-reveal="clip" style="--d:260ms">
        <Slot name="care-rest" ratio="4 / 5" tone="amber" shape="c" position="40% 45%" sizes="(max-width: 899px) 50vw, 22vw" />
        <p class="s1__tag"><span aria-hidden="true">03</span> Rest</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .s1__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: 48px;
    align-items: center;
  }
  .s1__copy {
    grid-column: 1 / span 5;
  }
  .s1__copy h2 {
    margin: var(--stack-label) 0 var(--stack-head);
  }
  .s1__trip {
    grid-column: 7 / span 6;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(20px, 2.2vw, 32px) clamp(12px, 1.6vw, 24px);
    align-items: start;
  }
  .s1__f--a {
    grid-column: 1 / -1;
  }
  .s1__f--b {
    grid-column: 1 / span 3;
  }
  .s1__f--c {
    grid-column: 4 / span 3;
    margin-top: clamp(24px, 3.4vw, 56px);
  }
  /* captions sit under the photographs, like a printed plate: nothing is laid over the image */
  .s1__tag {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-top: 12px;
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.005em;
  }
  .s1__tag span {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 899px) {
    .s1__copy,
    .s1__trip {
      grid-column: 1 / -1;
    }
    .s1__f--c {
      margin-top: 28px;
    }
  }
</style>
