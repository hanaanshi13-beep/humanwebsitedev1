---
// What HUMAN is, in one scan. Sits directly under the hero so a first-time visitor does not need to read
// eight chapters to learn what is being built. Uses only the approved description and the six stage names.
import { STAGES } from '../../data/site';
---

<section class="brief on-dark" id="what-is-human" aria-labelledby="brief-title">
  <div class="wrap brief__grid">
    <div class="brief__what">
      <p class="eyebrow no-rule" data-reveal><span>What HUMAN is</span></p>
      <h2 class="brief__title" id="brief-title" data-reveal style="--d:80ms">
        A preventive-health membership, <em>being built in India.</em>
      </h2>
    </div>
    <div class="brief__how" data-reveal style="--d:160ms">
      <p class="brief__lead">Designed to connect six stages that usually happen apart.</p>
      <ol class="brief__stages" aria-label="The six planned stages">
        {
          STAGES.map((s, i) => (
            <li>
              <span class="brief__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {s.name}
            </li>
          ))
        }
      </ol>
      <p class="note brief__status">
        In development. Nothing is available yet; the first pilot is planned for Delhi NCR.
        <a class="text-link" href="#scene-06">See how it is designed to work</a>
      </p>
    </div>
  </div>
</section>

<style>
  .brief {
    border-top: 1px solid var(--rule);
    padding-block: clamp(44px, 5vw, 72px);
  }
  .brief__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: 32px;
    align-items: start;
  }
  .brief__what {
    grid-column: 1 / span 5;
  }
  .brief__title {
    margin-top: 18px;
    max-width: 14em;
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .brief__title em {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.08em;
    letter-spacing: -0.01em;
  }
  .brief__how {
    grid-column: 7 / span 6;
  }
  .brief__lead {
    font-size: var(--fs-body);
    color: var(--muted);
  }
  .brief__stages {
    display: grid;
    grid-template-columns: repeat(6, auto);
    justify-content: space-between;
    gap: 14px 20px;
    margin-top: 20px;
    padding-block: 18px;
    border-block: 1px solid var(--rule);
    font-size: var(--fs-small);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brief__stages li {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .brief__n {
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }
  .brief__status {
    margin-top: 16px;
    max-width: 44em;
  }
  .brief__status .text-link {
    padding-block: 10px;
    margin-left: 4px;
    white-space: nowrap;
    color: var(--text);
    font-weight: 600;
  }
  @media (max-width: 1023px) {
    .brief__what,
    .brief__how {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 599px) {
    .brief__stages {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 7.4em), 1fr));
      justify-content: stretch;
      font-size: 0.8125rem;
    }
  }
</style>
