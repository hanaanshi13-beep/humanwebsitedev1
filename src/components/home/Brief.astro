---
// What HUMAN is — the company introduction, directly after the opening film. A full-viewport black chapter:
// the statement on the left, the HUMAN blood sample photograph on the right, the six-stage pathway along the foot.
// The photograph is shown as supplied (served sharp, never upscaled); its near-black studio backdrop is feathered
// into the section's black so it reads as an object in the room, not a picture in a box. Motion is limited to a
// slow float and a little scroll parallax, and stops entirely with reduced motion. All copy is real HTML.
import { getImage } from 'astro:assets';
import Pathway from './Pathway.astro';
import tube from '../../assets/brief/human-tube-premium.webp';

const w = tube.width;
const sizes = [Math.min(560, w), Math.min(840, w), w];
const shots = await Promise.all(sizes.map((width) => getImage({ src: tube, width, format: 'webp', quality: 90 })));
const srcset = shots.map((s, i) => `${s.src} ${sizes[i]}w`).join(', ');
---

<section class="brief on-dark" id="what-is-human" aria-labelledby="brief-title" data-brief>
  <div class="brief__light" aria-hidden="true"></div>
  <div class="wrap brief__grid">
    <div class="brief__copy" data-reveal-eager>
      <p class="eyebrow no-rule" data-reveal><span>What HUMAN is</span></p>
      <h2 class="display brief__title" id="brief-title" data-reveal="mask" style="--d:60ms">
        <span class="mask"><span>A preventive healthcare company.</span></span>
        <span class="mask" style="--i:1"><span><em>Being built in India.</em></span></span>
      </h2>
      <p class="lede brief__lede" data-reveal style="--d:220ms">
        HUMAN is building a preventive health membership designed to help you better understand your health through
        relevant bloodwork, clear health insights and tracking over time.
      </p>
      <p class="note brief__status" data-reveal="fade" style="--d:320ms">
        In development. Nothing is available yet; the first pilot is planned for Delhi NCR.
        <a class="text-link" href="#scene-06">See how it is designed to work</a>
      </p>
    </div>

    <figure class="brief__tube" data-tube>
      <div class="brief__float" data-tube-float>
        <img
          class="brief__photo"
          src={shots[1].src}
          srcset={srcset}
          sizes="(max-width: 767px) 100vw, 46vw"
          width={tube.width}
          height={tube.height}
          alt="A HUMAN blood collection tube with a burgundy ribbed cap and an ivory label reading HUMAN Bloodwork, EDTA K2, 4.0 mL, lit in warm amber."
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>
  </div>

  <Pathway />
</section>

<script>
  // A little scroll parallax for the photograph: it moves a few pixels against the page while the section is on
  // screen. Only while visible, never with reduced motion. (The slow float is CSS.)
  const fig = document.querySelector<HTMLElement>('[data-tube]');
  const section = fig?.closest<HTMLElement>('[data-brief]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (fig && section) {
    let queued = false;
    let listening = false;
    const apply = () => {
      queued = false;
      if (reduce.matches) return fig.style.removeProperty('--parallax');
      const r = section.getBoundingClientRect();
      // -1 as the section enters from below, 0 when it fills the screen, +1 as it leaves above
      const t = Math.max(-1, Math.min(1, -r.top / Math.max(1, window.innerHeight)));
      fig.style.setProperty('--parallax', `${(t * 22).toFixed(1)}px`);
    };
    const onScroll = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(apply);
      }
    };
    new IntersectionObserver(([en]) => {
      fig.classList.toggle('is-off', !en.isIntersecting);
      if (en.isIntersecting && !listening) {
        window.addEventListener('scroll', onScroll, { passive: true });
        listening = true;
        apply();
      } else if (!en.isIntersecting && listening) {
        window.removeEventListener('scroll', onScroll);
        listening = false;
      }
    }).observe(section);
    reduce.addEventListener('change', apply);
  }
</script>

<style>
  .brief {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(12px, 3vh, 44px);
    padding-block: calc(var(--header-h) + clamp(4px, 1.6vh, 28px)) clamp(0px, 1vh, 16px);
    background: var(--carbon);
    /* its own top padding already clears the header: cancel the page's scroll-padding so a link lands flush */
    scroll-margin-top: calc(-1 * (var(--header-h) + 12px));
    outline: none; /* focused by the opening arrow so reading continues here; it is not a control */
  }
  /* restrained warm studio light behind the tube; the room stays black */
  .brief__light {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      /* the photograph carries its own amber light; this only lifts the room around it */
      radial-gradient(38% 46% at 74% 46%, rgba(232, 165, 35, 0.09), rgba(232, 165, 35, 0) 70%);
  }
  .brief__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    align-items: center;
    width: 100%;
  }
  .brief__copy {
    grid-column: 1 / span 7;
    position: relative;
    z-index: 1;
  }
  .brief__title {
    margin-top: var(--stack-label);
    /* as large as the width allows, but never so tall that the pathway is pushed off a laptop screen */
    font-size: clamp(2.5rem, min(5.9vw, 8.2vh), 6rem);
    max-width: 11.5em;
  }
  .brief__lede {
    margin-top: var(--stack-head);
    max-width: 31em;
    color: var(--text);
  }
  .brief__status {
    margin-top: clamp(18px, 2.4vh, 28px);
    max-width: 44em;
    font-size: var(--fs-small);
  }
  .brief__status .text-link {
    padding-block: 10px;
    margin-left: 4px;
    white-space: nowrap;
    color: var(--text);
    font-weight: 600;
  }

  .brief__tube {
    grid-column: 8 / span 5;
    position: relative;
    margin: 0;
    height: min(58vh, 720px);
    height: min(58svh, 720px);
    min-height: 360px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* the photograph is sized from this box, so it keeps its own proportions in any column shape */
    container-type: size;
  }
  /* the photograph keeps its own proportions at every size: never stretched, never cropped */
  .brief__float {
    width: min(100cqw, 100cqh * 1122 / 1402);
    aspect-ratio: 1122 / 1402;
    /* a touch larger than its box: the feathered edges are only dark air, so they may spill into the margins */
    transform: translate3d(0, var(--parallax, 0px), 0) scale(1.1);
    will-change: transform;
  }
  .brief__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* feather the studio backdrop into the section's black: a soft oval, fully opaque around the tube */
    -webkit-mask-image: radial-gradient(56% 54% at 50% 50%, #000 62%, rgba(0, 0, 0, 0.6) 80%, transparent 100%);
    mask-image: radial-gradient(56% 54% at 50% 50%, #000 62%, rgba(0, 0, 0, 0.6) 80%, transparent 100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .brief__photo {
      animation: brief-float 8s ease-in-out infinite alternate;
    }
    .brief__light {
      animation: brief-light 9s ease-in-out infinite alternate;
    }
    .brief__tube:global(.is-off) .brief__photo {
      animation-play-state: paused;
    }
  }
  /* a slow rise of a few pixels with the faintest lean, like an object resting on air */
  @keyframes brief-float {
    from {
      transform: translate3d(0, 5px, 0) rotate(0.25deg);
    }
    to {
      transform: translate3d(0, -7px, 0) rotate(-0.15deg);
    }
  }
  @keyframes brief-light {
    from {
      opacity: 0.8;
    }
    to {
      opacity: 1;
    }
  }

  /* short laptop screens: a little tighter so the pathway and its pause control stay on the first screen */
  @media (min-width: 1024px) and (max-height: 780px) {
    .brief {
      gap: 8px;
    }
    .brief__title {
      font-size: clamp(2.5rem, min(5.9vw, 7.4vh), 6rem);
    }
    .brief__lede {
      margin-top: 18px;
    }
    .brief__tube {
      height: 54vh;
      height: 54svh;
      min-height: 320px;
    }
  }
  @media (max-width: 1023px) {
    .brief__copy {
      grid-column: 1 / span 7;
    }
    .brief__tube {
      grid-column: 8 / span 5;
    }
  }
  /* phones and portrait tablets: statement first, tube beneath it, pathway at the foot; nothing overlaps */
  @media (max-width: 767px) {
    .brief {
      justify-content: flex-start;
    }
    .brief__copy,
    .brief__tube {
      grid-column: 1 / -1;
    }
    .brief__title {
      font-size: clamp(2.125rem, 9.6vw, 3.25rem);
    }
    /* phones: the whole photograph, centred under the copy, a little shorter than half the screen */
    .brief__tube {
      height: 50vh;
      height: 50svh;
      min-height: 300px;
      max-height: 520px;
      margin-top: 4px;
    }
    .brief__light {
      background: radial-gradient(60% 34% at 50% 58%, rgba(232, 165, 35, 0.16), rgba(232, 165, 35, 0) 70%);
    }
  }
</style>
