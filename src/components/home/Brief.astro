---
// What HUMAN is — the company introduction, directly after the opening film. A full-viewport black chapter:
// the statement on the left, the HUMAN blood tube turning in 3D on the right, the six-stage pathway along the foot.
// The 3D model loads only when this section comes near the screen; until then (and with no WebGL or no JavaScript)
// a still of the same model is shown. All copy is real HTML.
import { getImage } from 'astro:assets';
import Pathway from './Pathway.astro';
import still from '../../assets/brief/tube-still.png';

const fallback = await getImage({ src: still, width: Math.min(still.width, 900), format: 'webp', quality: 86 });
---

<section class="brief on-dark" id="what-is-human" aria-labelledby="brief-title" data-brief>
  <div class="brief__light" aria-hidden="true"></div>
  <div class="wrap brief__grid">
    <div class="brief__copy">
      <p class="eyebrow no-rule" data-reveal><span>What HUMAN is</span></p>
      <h2 class="display brief__title" id="brief-title" data-reveal="mask" style="--d:60ms">
        <span class="mask"><span>A preventive healthcare company.</span></span>
        <span class="mask" style="--i:1"><span><em>Being built in India.</em></span></span>
      </h2>
      <p class="lede brief__lede" data-reveal style="--d:220ms">
        HUMAN is building a preventive health membership designed to help you better understand your health through
        relevant bloodwork, clear health insights and tracking over time.
      </p>
      <p class="note brief__status" data-reveal="fade" style="--d:320ms">
        In development. Nothing is available yet; the first pilot is planned for Delhi NCR.
        <a class="text-link" href="#scene-06">See how it is designed to work</a>
      </p>
    </div>

    <figure class="brief__tube" data-tube-host>
      <img
        class="brief__still"
        src={fallback.src}
        width={fallback.attributes.width ?? 900}
        height={fallback.attributes.height}
        alt="A HUMAN blood collection tube with a burgundy cap and an ivory label reading HUMAN Bloodwork, lit in warm amber."
        loading="lazy"
        decoding="async"
      />
      <div class="brief__stage" data-tube-stage aria-hidden="true"></div>
    </figure>
  </div>

  <Pathway />
</section>

<script>
  // The 3D tube is fetched only when the section is about to be seen. If WebGL is unavailable the still stays.
  const host = document.querySelector<HTMLElement>('[data-tube-host]');
  const stage = host?.querySelector<HTMLElement>('[data-tube-stage]');
  if (host && stage) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let started = false;
    const io = new IntersectionObserver(
      (entries) => {
        if (started || !entries.some((e) => e.isIntersecting)) return;
        started = true;
        io.disconnect();
        import('../../scripts/tube3d')
          .then((m) => m.mountTube(stage, { reducedMotion: reduce.matches }))
          .then((handle) => {
            if (!handle) return;
            host.classList.add('is-3d');
            reduce.addEventListener('change', () => handle.setPlaying(!reduce.matches));
          })
          .catch(() => {
            /* the still remains */
          });
      },
      { rootMargin: '60% 0px 60% 0px' },
    );
    io.observe(host);
  }
</script>

<style>
  .brief {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 5vh, 64px);
    padding-block: calc(var(--header-h) + clamp(12px, 3vh, 40px)) clamp(28px, 5vh, 56px);
    background: var(--carbon);
  }
  /* restrained warm studio light behind the tube; the room stays black */
  .brief__light {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(38% 46% at 74% 44%, rgba(232, 165, 35, 0.16), rgba(232, 165, 35, 0) 70%),
      radial-gradient(22% 30% at 76% 40%, rgba(196, 92, 40, 0.12), rgba(196, 92, 40, 0) 72%);
  }
  .brief__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    align-items: center;
    width: 100%;
  }
  .brief__copy {
    grid-column: 1 / span 7;
    position: relative;
    z-index: 1;
  }
  .brief__title {
    margin-top: var(--stack-label);
    font-size: clamp(2.5rem, 5.9vw, 6rem);
    max-width: 11.5em;
  }
  .brief__lede {
    margin-top: var(--stack-head);
    max-width: 31em;
    color: var(--text);
  }
  .brief__status {
    margin-top: clamp(18px, 2.4vh, 28px);
    max-width: 40em;
  }
  .brief__status .text-link {
    padding-block: 10px;
    margin-left: 4px;
    white-space: nowrap;
    color: var(--text);
    font-weight: 600;
  }

  .brief__tube {
    grid-column: 8 / span 5;
    position: relative;
    margin: 0;
    height: min(64vh, 640px);
    height: min(64svh, 640px);
    min-height: 360px;
  }
  .brief__stage,
  .brief__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .brief__still {
    object-fit: contain;
    transition: opacity 600ms var(--ease-human);
  }
  .brief__tube:global(.is-3d) .brief__still {
    opacity: 0;
  }
  .brief__stage :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }

  @media (max-width: 1023px) {
    .brief__copy {
      grid-column: 1 / span 7;
    }
    .brief__tube {
      grid-column: 8 / span 5;
    }
  }
  /* phones and portrait tablets: statement first, tube beneath it, pathway at the foot; nothing overlaps */
  @media (max-width: 767px) {
    .brief {
      justify-content: flex-start;
    }
    .brief__copy,
    .brief__tube {
      grid-column: 1 / -1;
    }
    .brief__title {
      font-size: clamp(2.125rem, 9.6vw, 3.25rem);
    }
    .brief__tube {
      height: 46vh;
      height: 46svh;
      min-height: 280px;
      margin-top: 8px;
    }
    .brief__light {
      background: radial-gradient(60% 34% at 50% 58%, rgba(232, 165, 35, 0.16), rgba(232, 165, 35, 0) 70%);
    }
  }
</style>
