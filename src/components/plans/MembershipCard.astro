---
// One photographic membership card. The whole card is a single button that opens its category in the overlay;
// the glass arrow is only a visual affordance (no nested control). All text is set in code, never in the image.
import { getImage } from 'astro:assets';
import type { PlanCategory } from '../../data/plans';

interface Props {
  category: PlanCategory;
  image: ImageMetadata;
  index: number;
}
const { category: c, image, index } = Astro.props;
// responsive derivatives of the supplied photograph (the original in src/assets/memberships is never modified)
const widths = [420, 640, 860].filter((w) => w < image.width).concat(image.width);
const shots = await Promise.all(widths.map((w) => getImage({ src: image, width: w, format: 'webp', quality: 82 })));
const srcset = shots.map((s, i) => `${s.src} ${widths[i]}w`).join(', ');
const eager = index < 5;
---

<li class="xp-card" style={`--i:${index};--tint:${c.tint};--shade:${c.shade}`}>
  <button class="xp-card__hit" type="button" data-nav-tone="light" data-plan-open={c.id} aria-haspopup="dialog" aria-controls="plans-overlay">
    <span class="xp-card__media">
      <img
        src={shots[Math.min(1, shots.length - 1)].src}
        srcset={srcset}
        sizes="(max-width: 599px) 78vw, (max-width: 899px) 44vw, (max-width: 1199px) 30vw, (max-width: 1919px) 24vw, 400px"
        width={image.width}
        height={image.height}
        alt=""
        data-nav-tone="light"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        draggable="false"
      />
    </span>
    <span class="xp-card__shade" aria-hidden="true"></span>
    <span class="xp-card__cap">
      <span class="xp-card__brand">HUMAN</span>
      <span class="xp-card__title">{c.title}</span>
    </span>
    <span class="xp-card__go" data-tone="dark" aria-hidden="true">
      <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4.5 11.5l7-7M5.6 4.5h5.9v5.9"></path></svg>
    </span>
    <span class="vh">View memberships</span>
  </button>
</li>

<style is:global>
  /* The card face. These rules are shared with the overlay, which repeats the caption over its photograph for the
     first moments of the expansion so the card appears to open rather than be replaced. */
  .xp-card {
    flex: none;
    width: var(--card-w);
    container-type: inline-size;
  }
  .xp-card__hit {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: 0;
    border: 0;
    border-radius: var(--xp-radius);
    background: var(--tint);
    color: #fbf8f1;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    -webkit-tap-highlight-color: transparent;
    box-shadow:
      0 1px 2px rgba(60, 46, 20, 0.1),
      0 22px 44px -30px rgba(60, 46, 20, 0.55);
    transition: box-shadow 500ms var(--ease-human);
  }
  .xp-card__hit:focus-visible {
    outline: 3px solid #14191c;
    outline-offset: 4px;
    border-radius: var(--xp-radius);
  }
  /* fine translucent edge, drawn over the photograph */
  .xp-card__hit::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
    pointer-events: none;
  }
  .xp-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    overflow: hidden;
    /* if the photograph is missing: a quiet tonal ground in its own colour, never a broken-image icon */
    background:
      radial-gradient(120% 80% at 30% 18%, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 60%),
      var(--tint);
  }
  .xp-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    transform: scale(1);
    transition: transform 700ms var(--ease-human);
    -webkit-user-drag: none;
    user-select: none;
  }
  .xp-card.is-missing .xp-card__media img {
    visibility: hidden;
  }
  .xp-card__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(14, 11, 8, 0) 46%,
      rgba(14, 11, 8, calc(var(--shade) * 0.16)) 60%,
      rgba(14, 11, 8, calc(var(--shade) * 0.52)) 76%,
      rgba(14, 11, 8, calc(var(--shade) * 0.86)) 90%,
      rgba(14, 11, 8, var(--shade)) 100%
    );
  }
  .xp-card__cap {
    position: absolute;
    left: var(--xp-inset);
    right: calc(var(--xp-inset) + var(--xp-go) + 12px); /* the title never runs under the arrow */
    bottom: var(--xp-inset);
    z-index: 2;
    display: grid;
    gap: 8px;
    transition: transform 450ms var(--ease-human);
  }
  .xp-card__brand {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(251, 248, 241, 0.86);
  }
  .xp-card__title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.75rem, 10.6cqw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    text-wrap: balance;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.28);
    padding-bottom: 0.06em; /* room for the italic descenders */
  }
  /* the exploration arrow: a small piece of clear glass on the photograph */
  .xp-card__go {
    position: absolute;
    right: var(--xp-inset);
    bottom: var(--xp-inset);
    z-index: 2;
    width: var(--xp-go);
    height: var(--xp-go);
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.34);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0) 62%),
      rgba(255, 255, 255, 0.11);
    background-clip: padding-box;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.36),
      0 10px 22px -12px rgba(0, 0, 0, 0.6);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    backdrop-filter: blur(12px) saturate(150%);
    transition:
      background-color 400ms var(--ease-human),
      border-color 400ms var(--ease-human),
      box-shadow 400ms var(--ease-human);
  }
  .xp-card__go svg {
    transition: transform 400ms var(--ease-human);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .xp-card__go {
      background-color: rgba(30, 26, 20, 0.5);
    }
  }
  /* hover: the photograph comes a little more alive; the card itself never moves */
  @media (hover: hover) and (pointer: fine) {
    .xp-card__hit:hover {
      box-shadow:
        0 1px 2px rgba(60, 46, 20, 0.12),
        0 26px 50px -30px rgba(60, 46, 20, 0.7);
    }
    .xp-card__hit:hover .xp-card__media img {
      transform: scale(1.05);
    }
    .xp-card__hit:hover .xp-card__cap {
      transform: translateY(-4px);
    }
    .xp-card__hit:hover .xp-card__go {
      background-color: rgba(255, 255, 255, 0.22);
      border-color: rgba(255, 255, 255, 0.62);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.6),
        inset 0 -8px 14px -10px rgba(255, 255, 255, 0.35),
        0 10px 22px -12px rgba(0, 0, 0, 0.6);
    }
    .xp-card__hit:hover .xp-card__go svg {
      transform: translate(1.5px, -1.5px);
    }
  }
  .xp-card__hit:focus-visible .xp-card__go {
    background-color: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.62);
  }
  /* pressed (touch and mouse): a brief, restrained acknowledgement that never sticks */
  .xp-card__hit:active .xp-card__go {
    background-color: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.7);
  }
  .xp-card__hit:active .xp-card__media img {
    transform: scale(1.02);
    transition-duration: 220ms;
  }
  /* while its overlay is open the card has "become" the overlay */
  .xp-card.is-source .xp-card__hit {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .xp-card__media img,
    .xp-card__cap,
    .xp-card__go svg {
      transition: none !important;
      transform: none !important;
    }
  }
  @media (forced-colors: active) {
    .xp-card__hit {
      border: 1px solid ButtonText;
    }
  }
</style>
