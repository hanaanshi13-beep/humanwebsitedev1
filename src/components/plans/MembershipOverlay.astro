---
// The category overlay: one reusable dialog for all nine categories, rendered from data/plans.ts.
// A selected card expands into this panel (scripts/plans-overlay.ts): its photograph on one side, the plan names
// on the other. The plan names are static text. There is no price, description, link or purchase path here.
import MembershipPlanList from './MembershipPlanList.astro';
import { PLAN_CATEGORIES, STATUS_NOTE } from '../../data/plans';
---

<dialog class="xo" id="plans-overlay" data-plans-overlay data-state="closed">
  <div class="xo__scrim" data-xo-scrim></div>
  <div class="xo__stage">
    <div class="xo__shell" data-xo-shell data-tone="light">
      <div class="xo__photo" data-xo-photo>
        <img data-xo-img alt="" decoding="sync" draggable="false" />
        <!-- the card's own caption, repeated here only for the first moments of the expansion -->
        <span class="xo__cap" data-xo-cap aria-hidden="true">
          <span class="xp-card__shade"></span>
          <span class="xp-card__cap">
            <span class="xp-card__brand">HUMAN</span>
            <span class="xp-card__title" data-xo-cap-title></span>
          </span>
        </span>
      </div>
      <div class="xo__body" data-xo-body>
        {
          PLAN_CATEGORIES.map((c) => (
            <section class="xo__panel" data-xo-panel={c.id} data-alt={c.alt} data-focus={c.focus} data-focus-wide={c.focusWide} hidden>
              <p class="xo__brand">HUMAN</p>
              <h2 class="xo__title" id={`xo-title-${c.id}`}>
                <span class="vh">HUMAN </span>
                {c.title}
              </h2>
              <p class="xo__label">Memberships</p>
              <MembershipPlanList plans={c.plans} />
              <p class="xo__status" style={`--r:${c.plans.length}`}>
                {STATUS_NOTE[c.status]}
              </p>
            </section>
          ))
        }
      </div>
      <button class="xo__close" type="button" data-xo-close aria-label="Close" autofocus>
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path></svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  import '../../scripts/plans-overlay.ts';
</script>

<style is:global>
  .xo {
    --xo-radius: 32px;
    --xo-margin-x: clamp(12px, 5vw, 72px);
    --xo-margin-y: clamp(12px, 5.5vh, 56px);
    --xo-w: min(1180px, calc(100vw - 2 * var(--xo-margin-x)));
    --xo-split: 40%;
    --xo-ph: clamp(170px, 34svh, 340px); /* the photograph's height when it sits above the list */
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text-on-light);
    overflow: hidden;
  }
  .xo::backdrop {
    background: transparent;
  }
  /* the page recedes: softly blurred, gently dimmed, still recognisable. Present only while the overlay is open. */
  .xo__scrim {
    position: absolute;
    inset: 0;
    background: rgba(74, 58, 36, 0.26);
    -webkit-backdrop-filter: blur(16px) saturate(112%);
    backdrop-filter: blur(16px) saturate(112%);
  }
  .xo__stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* frosted ivory glass. The scrim has already blurred the page, so this surface needs no second blur of its own:
     it is dense enough to read on, and translucent enough to carry the room's warmth. */
  .xo__shell {
    --text: var(--text-on-light);
    --muted: var(--muted-on-light);
    --rule: rgba(46, 40, 28, 0.14);
    --accent: var(--amber-deep);
    position: absolute;
    inset: 0;
    margin: auto;
    width: calc(100vw - 2 * var(--xo-margin-x));
    max-width: min(560px, 82vw + 40px);
    height: fit-content;
    max-height: calc(100svh - 2 * var(--xo-margin-y) - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    border-radius: var(--xo-radius);
    overflow: hidden;
    pointer-events: auto;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0) 34%),
      rgba(244, 240, 231, 0.9);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 0 0 1px rgba(46, 40, 28, 0.1),
      0 40px 90px -40px rgba(40, 30, 12, 0.6),
      0 12px 30px -18px rgba(40, 30, 12, 0.35);
  }
  .xo__photo {
    position: relative;
    flex: none;
    height: var(--xo-ph);
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 30% 18%, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 60%),
      var(--tint, #8a745c);
  }
  .xo__photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus-wide, 50% 30%);
    -webkit-user-drag: none;
    user-select: none;
  }
  .xo__photo img[hidden] {
    display: none;
  }
  .xo__cap {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    color: #fbf8f1;
  }
  .xo__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: clamp(22px, 5.6vw, 30px) clamp(22px, 6vw, 32px) calc(clamp(22px, 5.6vw, 30px) + env(safe-area-inset-bottom, 0px));
  }
  .xo__body:focus-visible {
    outline-offset: -4px;
  }
  /* when the list is longer than the panel, its last line fades out to say there is more; the fade lifts at the end */
  .xo__body.is-scrollable:not(.is-at-end) {
    -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 44px), transparent 100%);
    mask-image: linear-gradient(180deg, #000 calc(100% - 44px), transparent 100%);
  }
  .xo__brand,
  .xo__label {
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  .xo__brand {
    color: var(--accent);
  }
  .xo__title {
    margin-top: 10px;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.5rem, 4.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.012em;
    padding-bottom: 0.06em;
  }
  .xo__label {
    margin-top: clamp(22px, 2.6vw, 34px);
    color: var(--muted);
  }
  .xo__list {
    margin-top: clamp(8px, 1vw, 12px);
    border-top: 1px solid var(--rule);
  }
  .xo__list li {
    display: grid;
    grid-template-columns: 2.1em 1.6em 1fr;
    align-items: baseline;
    padding: clamp(11px, 1.15vw, 15px) 0;
    border-bottom: 1px solid var(--rule);
    font-size: clamp(1.0625rem, 1.35vw, 1.25rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .xo__n {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .xo__dash {
    color: rgba(46, 40, 28, 0.34);
    font-weight: 400;
  }
  .xo__plan {
    overflow-wrap: anywhere;
  }
  .xo__status {
    margin-top: clamp(16px, 1.8vw, 22px);
    font-size: var(--fs-note);
    line-height: 1.5;
    color: var(--muted);
  }
  /* the close control: a round piece of the site's light-ground glass that stays put while the list scrolls.
     On narrow layouts it sits on the ivory just below the photograph, so it never covers a face. */
  .xo__close {
    position: absolute;
    top: calc(var(--xo-ph) + 12px);
    right: 14px;
    z-index: 4;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 50%;
    color: var(--glass-text);
    border: 1px solid var(--glass-border);
    background: var(--glass-sheen), var(--glass-bg);
    background-clip: padding-box;
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      var(--glass-shadow);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--motion-control) var(--ease-human),
      border-color var(--motion-control) var(--ease-human),
      transform var(--motion-control) var(--ease-human);
  }
  .xo__close:active {
    transform: scale(0.94);
  }
  .xo__close:focus-visible {
    outline: 2px solid var(--glass-focus);
    outline-offset: 3px;
    border-radius: 50%;
  }
  @media (hover: hover) {
    .xo__close:hover {
      --glass-bg: var(--glass-bg-hover);
      border-color: var(--glass-border-hover);
    }
  }
  .xo__title {
    padding-right: 48px; /* the title never runs under the close control */
  }

  /* ----- split composition: photograph left, plan names right (desktop, landscape tablets and phones) ----- */
  @media (min-width: 900px), (orientation: landscape) and (min-width: 600px) {
    .xo__shell {
      max-width: none;
      width: var(--xo-w);
      /* tall enough that the photograph keeps close to its own 3:4 proportion, never taller than the screen */
      height: min(calc(100svh - 2 * var(--xo-margin-y)), max(600px, calc(var(--xo-w) * var(--xo-ratio, 0.5333))));
      max-height: none;
      flex-direction: row;
    }
    .xo__photo {
      width: var(--xo-split);
      height: auto;
    }
    .xo__photo img {
      object-position: var(--focus, 50% 35%);
    }
    .xo__body {
      display: flex;
      flex-direction: column;
      padding: clamp(28px, 4.2vw, 60px) clamp(28px, 4.6vw, 68px) clamp(24px, 3.4vw, 44px);
    }
    .xo__panel {
      margin-block: auto; /* centred when it fits, top-aligned and scrollable when it does not */
      padding-right: 34px; /* the title never runs under the close control */
    }
    .xo__close {
      top: 18px;
      right: 18px;
    }
    .xo__title {
      padding-right: 0;
    }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .xo {
      --xo-split: 42%;
    }
  }
  @media (orientation: landscape) and (max-height: 560px) {
    .xo {
      --xo-split: 36%;
      --xo-margin-y: 10px;
      --xo-radius: 24px;
    }
    .xo__shell {
      height: calc(100svh - 2 * var(--xo-margin-y));
    }
  }
  @media (max-width: 899px) {
    .xo {
      --xo-radius: 28px;
    }
  }
  /* portrait tablets: the same vertical sheet, a little larger */
  @media (min-width: 600px) and (max-width: 899px) and (orientation: portrait) {
    .xo {
      --xo-ph: clamp(280px, 38svh, 440px);
    }
    .xo__shell {
      max-width: 620px;
    }
  }

  /* ----- flight: while the card expands (or returns), the photograph and the text are taken out of the flow so
     the changing box never reflows them. Geometry is animated by the script; this only sets the stage. ----- */
  .xo__shell.is-flying {
    will-change: left, top, width, height;
  }
  .xo__shell.is-flying .xo__photo {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2; /* the text emerges from behind the photograph; it never crosses over it */
    width: 100%;
    height: 100%;
  }
  .xo__shell.is-flying .xo__body {
    position: absolute;
    right: 0;
    bottom: 0;
    overflow: hidden;
  }

  /* ----- content reveal: title first, then the plan names in sequence ----- */
  .js-motion .xo[data-state='opening'] .xo__brand,
  .js-motion .xo[data-state='opening'] .xo__title,
  .js-motion .xo[data-state='opening'] .xo__label,
  .js-motion .xo[data-state='opening'] .xo__list li,
  .js-motion .xo[data-state='opening'] .xo__status,
  .js-motion .xo[data-state='open'] .xo__brand,
  .js-motion .xo[data-state='open'] .xo__title,
  .js-motion .xo[data-state='open'] .xo__label,
  .js-motion .xo[data-state='open'] .xo__list li,
  .js-motion .xo[data-state='open'] .xo__status {
    animation: xo-rise 330ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }
  .js-motion .xo .xo__brand {
    animation-delay: 170ms;
  }
  .js-motion .xo .xo__title {
    animation-delay: 200ms;
  }
  .js-motion .xo .xo__label {
    animation-delay: 250ms;
  }
  .js-motion .xo .xo__list li,
  .js-motion .xo .xo__status {
    animation-delay: calc(290ms + var(--r, 0) * 55ms);
  }
  .js-motion .xo[data-state='opening'] .xo__close {
    animation: xo-fade 200ms ease-out 60ms both;
  }
  @keyframes xo-rise {
    from {
      opacity: 0;
      transform: translateY(9px);
    }
  }
  @keyframes xo-fade {
    from {
      opacity: 0;
    }
  }

  /* ----- fallbacks ----- */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .xo__scrim {
      background: rgba(70, 60, 44, 0.62);
    }
    .xo__shell {
      background: #f4f0e7;
    }
    .xo__close {
      background-color: #f8f5ee;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .xo__scrim {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: rgba(70, 60, 44, 0.66);
    }
    .xo__shell {
      background: #f4f0e7;
    }
  }
  @media (forced-colors: active) {
    .xo__shell {
      border: 1px solid CanvasText;
    }
  }
</style>
