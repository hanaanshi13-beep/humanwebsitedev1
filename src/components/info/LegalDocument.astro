---
// Renders one long-form document (data/legal/*) for reading: every section visible, in order, nothing collapsed.
// A quiet contents list sits beside it on wide screens only. No promotion, no photographs, no animation of text.
import type { LegalDoc } from '../../data/legal/types';
import { rich } from '../../data/rich';

interface Props {
  doc: LegalDoc;
  /** 'h2' when the page heading is separate (Privacy & Terms); 'p' when the document heading supports an h1 */
  headingTag?: 'h2' | 'p';
}
const { doc, headingTag = 'h2' } = Astro.props;
const Heading = headingTag;
const SectionHeading = headingTag === 'h2' ? 'h3' : 'h2';
const nn = (i: number) => String(i + 1).padStart(2, '0');
const sid = (i: number) => `${doc.id}-${nn(i)}`;
---

<article class="lg" data-doc={doc.id} aria-labelledby={`${doc.id}-heading`}>
  <div class="wrap lg__grid">
    <nav class="lg__toc" aria-label="In this document">
      <ol role="list">
        {
          doc.sections.map((s, i) => (
            <li>
              <a href={`#${sid(i)}`}>
                <span class="lg__toc-n" aria-hidden="true">{nn(i)}</span>
                <span>{s.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="lg__doc">
      <Heading class="lg__heading" id={`${doc.id}-heading`}>{doc.heading}</Heading>
      <div class="lg__intro">
        {doc.intro.map((p) => <p set:html={rich(p)} />)}
      </div>
      {doc.updatedAt === 'top' && <p class="lg__updated"><strong>Last updated:</strong> <Fragment set:html={rich(doc.updated)} /></p>}

      {
        doc.sections.map((s, i) => (
          <section class="lg__sec" id={sid(i)} aria-labelledby={`${sid(i)}-h`}>
            <SectionHeading class="lg__h" id={`${sid(i)}-h`}>
              <span class="lg__n">{nn(i)}</span>
              <span class="lg__dash" aria-hidden="true">—</span>
              <span>{s.title}</span>
            </SectionHeading>
            {s.blocks.map((b) => {
              if ('p' in b) return <p set:html={rich(b.p)} />;
              if ('ul' in b) return <ul>{b.ul.map((li) => <li set:html={rich(li)} />)}</ul>;
              if ('fields' in b)
                return (
                  <dl class="lg__fields">
                    {b.fields.map((f) => (
                      <div>
                        <dt>{f.label}:</dt>
                        <dd set:html={rich(f.value)} />
                      </div>
                    ))}
                  </dl>
                );
              if ('urgent' in b) return <div class="lg__urgent">{b.urgent.map((u) => <p set:html={rich(u)} />)}</div>;
              if ('statement' in b) return <p class="lg__statement">{b.statement.map((line) => <span>{line}</span>)}</p>;
            })}
          </section>
        ))
      }

      {doc.updatedAt === 'end' && <p class="lg__updated lg__updated--end"><strong>Last updated:</strong> <Fragment set:html={rich(doc.updated)} /></p>}
    </div>
  </div>
</article>

<style is:global>
  .lg {
    padding-block: clamp(36px, 4.4vw, 64px) clamp(72px, 9vw, 136px);
  }
  .lg__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    align-items: start;
  }
  /* contents: wide screens only, and never louder than the document */
  .lg__toc {
    display: none;
  }
  .lg__doc {
    grid-column: 1 / -1;
    max-width: 41em; /* about 70 characters a line */
  }
  @media (min-width: 1100px) {
    .lg__toc {
      display: block;
      grid-column: 1 / span 3;
      position: sticky;
      top: calc(var(--header-h) + 28px);
      max-height: calc(100svh - var(--header-h) - 56px);
      overflow-y: auto;
      padding-top: 6px;
    }
    .lg__doc {
      grid-column: 5 / -1;
    }
  }
  .lg__toc a {
    display: grid;
    grid-template-columns: 2.1em 1fr;
    align-items: baseline;
    padding: 7px 0;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--motion-micro) var(--ease-human);
  }
  .lg__toc a:hover,
  .lg__toc a:focus-visible {
    color: var(--text);
  }
  .lg__toc-n {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .lg__doc p,
  .lg__doc li,
  .lg__doc dd,
  .lg__doc dt {
    font-size: clamp(1.0625rem, 1.15vw, 1.125rem);
    line-height: 1.68;
    text-wrap: pretty;
  }
  /* the document's own heading (an h2, or a supporting line under the page's h1) */
  .lg__doc .lg__heading {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 3.3vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
  }
  .lg__intro {
    margin-top: clamp(20px, 2.2vw, 30px);
    color: var(--text);
  }
  .lg__intro p + p,
  .lg__sec p + p,
  .lg__sec p + ul,
  .lg__sec ul + p,
  .lg__sec p + dl,
  .lg__sec dl + p,
  .lg__sec p + div,
  .lg__sec div + p {
    margin-top: 0.95em;
  }
  .lg__updated {
    margin-top: clamp(20px, 2.2vw, 28px);
    font-size: var(--fs-small) !important;
    color: var(--muted);
  }
  .lg__updated strong {
    font-weight: 600;
    color: var(--text);
  }
  .lg__updated--end {
    margin-top: clamp(36px, 4vw, 56px);
    padding-top: clamp(20px, 2.2vw, 28px);
    border-top: 1px solid var(--rule);
  }
  .lg__sec {
    margin-top: clamp(34px, 4vw, 54px);
    padding-top: clamp(26px, 3vw, 38px);
    border-top: 1px solid var(--rule);
    color: var(--muted);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  /* section titles are clear, not decorative: the site's sans, with a small amber number */
  .lg__h {
    display: grid;
    grid-template-columns: auto auto 1fr;
    column-gap: 0.55em;
    align-items: baseline;
    margin-bottom: clamp(12px, 1.4vw, 18px);
    font-size: clamp(1.25rem, 1.7vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.012em;
    color: var(--text);
  }
  .lg__n {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .lg__dash {
    color: rgba(46, 40, 28, 0.34);
    font-weight: 400;
  }
  .lg__sec ul {
    list-style: none;
    padding: 0;
  }
  .lg__sec li {
    position: relative;
    padding-left: 1.35em;
  }
  .lg__sec li + li {
    margin-top: 0.35em;
  }
  .lg__sec li::before {
    content: '';
    position: absolute;
    left: 0.15em;
    top: 0.78em;
    width: 0.5em;
    height: 1px;
    background: var(--accent);
  }
  .lg__fields div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
  }
  .lg__fields div + div {
    margin-top: 0.35em;
  }
  .lg__fields dt {
    font-weight: 600;
    color: var(--text);
  }
  .lg__fields dd {
    margin: 0;
  }
  /* emergency information: easy to find, never alarming */
  .lg__urgent {
    padding: 2px 0 2px clamp(16px, 1.6vw, 22px);
    border-left: 2px solid var(--amber-ui-active);
    color: var(--text);
  }
  .lg__urgent p {
    font-size: clamp(1.125rem, 1.35vw, 1.25rem) !important;
    font-weight: 500;
    line-height: 1.5 !important;
  }
  .lg__urgent a {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* the closing thought */
  .lg__statement {
    margin-top: clamp(26px, 3vw, 40px);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.625rem, 2.5vw, 2.25rem) !important;
    line-height: 1.16 !important;
    letter-spacing: -0.008em;
    color: var(--text);
  }
  .lg__statement span {
    display: block;
  }
  .lg__statement span + span {
    margin-top: 0.3em;
  }
  @media print {
    .lg__toc {
      display: none;
    }
  }
</style>
