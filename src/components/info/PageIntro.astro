---
// The opening block shared by the informational pages (FAQ, Privacy & Terms, Medical Disclaimer):
// a small label, the page heading in the site's italic serif, one supporting line. Never a full-screen hero.
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  id?: string;
}
const { eyebrow, title, lede, id = 'page-title' } = Astro.props;
---

<header class="wrap inf__intro" data-reveal-eager>
  <p class="eyebrow no-rule inf__eyebrow" data-reveal><span>{eyebrow}</span></p>
  <h1 class="inf__title" id={id} data-reveal style="--d:80ms">{title}</h1>
  {lede && <p class="lede inf__lede" data-reveal style="--d:160ms">{lede}</p>}
  <slot />
</header>

<style is:global>
  /* ----- shared by the informational pages ----- */
  .inf__intro {
    padding-top: calc(var(--header-h) + clamp(32px, 6vh, 76px));
  }
  .inf__eyebrow {
    color: var(--accent);
    letter-spacing: 0.28em;
  }
  .inf__title {
    margin-top: clamp(14px, 1.6vw, 20px);
    max-width: 16em;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.5rem, 4.5vw, 4.125rem);
    line-height: 1.02;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }
  .inf__lede {
    margin-top: clamp(14px, 1.5vw, 20px);
    max-width: 33em;
    color: var(--muted);
  }
  /* a detail awaiting confirmation: visible to reviewers, impossible to mistake for final wording */
  .inf-pending {
    padding: 0.05em 0; /* no side padding: a wrapped placeholder must never push past the line */
    border-radius: 3px;
    background: rgba(217, 166, 72, 0.2);
    box-shadow: inset 0 0 0 1px rgba(138, 95, 10, 0.28);
    color: inherit;
    font-style: normal;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  /* review-build flag for documents that are not yet approved */
  .inf__draft {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: clamp(18px, 2vw, 26px);
    padding: 6px 13px 6px 11px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
  }
  .inf__draft::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
