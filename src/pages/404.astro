---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — HUMAN" description="This page isn’t here.">
  <section class="page-hero on-dark" data-reveal-eager>
    <div class="wrap">
      <p class="eyebrow" data-reveal><span class="num">404</span><span>Not found</span></p>
      <h1 class="display" data-reveal>This page <em>isn’t here.</em></h1>
      <p class="lede" data-reveal>The link may be old, or the page may not exist yet.</p>
      <div class="actions">
        <a class="btn" href="/">Back to home <span class="arr" aria-hidden="true">→</span></a>
        <a class="link" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
