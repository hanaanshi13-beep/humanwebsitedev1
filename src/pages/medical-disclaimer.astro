---
// Medical Disclaimer: one uninterrupted reading page, eight sections, all visible. No accordion, no promotion.
// DRAFT: not medically or legally approved (see docs/HUMAN-LEGAL-REVIEW-REGISTER.md).
import Base from '../layouts/Base.astro';
import PageIntro from '../components/info/PageIntro.astro';
import LegalDocument from '../components/info/LegalDocument.astro';
import { DISCLAIMER } from '../data/legal/disclaimer';
---

<Base
  title="Medical Disclaimer | HUMAN"
  description="What HUMAN can and cannot do: website information is educational, blood tests have limits, and HUMAN does not replace a qualified medical professional. Draft for review."
>
  <div class="on-light">
    <PageIntro eyebrow="HUMAN" title="Medical Disclaimer" id="md-title">
      <p class="inf__draft" role="note">Draft for review — not approved for publication</p>
    </PageIntro>
    <LegalDocument doc={DISCLAIMER} headingTag="p" />
  </div>
</Base>
