---
// Medical Disclaimer: one uninterrupted reading page, eight sections, all visible. No accordion, no promotion.
// An INTERIM PROTOTYPE NOTICE: not medically or legally reviewed (see data/legal/types.ts).
import Base from '../layouts/Base.astro';
import PageIntro from '../components/info/PageIntro.astro';
import LegalDocument from '../components/info/LegalDocument.astro';
import { DISCLAIMER } from '../data/legal/disclaimer';
import { INTERIM_FLAG } from '../data/legal/types';
---

<Base
  title="Medical Disclaimer | HUMAN"
  description="HUMAN is in development. This website is informational and illustrative: it does not provide medical diagnosis, treatment or individual medical advice."
>
  <div class="on-light">
    <PageIntro eyebrow="HUMAN" title="Medical Disclaimer" id="md-title">
      <p class="inf__draft" role="note">{INTERIM_FLAG}</p>
    </PageIntro>
    <LegalDocument doc={DISCLAIMER} headingTag="p" />
  </div>
</Base>
