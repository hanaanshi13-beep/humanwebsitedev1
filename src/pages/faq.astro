---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL } from '../data/site';
const faqs = [
  { g: 'The basics', q: 'What is HUMAN?', a: 'HUMAN is an India-focused preventive-health membership concept that is currently being developed. The intended experience connects six stages: test, understand, act, track, retest and improve.' },
  { g: 'The basics', q: 'Is HUMAN available yet?', a: 'No. HUMAN is in prelaunch development. Joining the waitlist registers your interest; it does not start any care or service.' },
  { g: 'The basics', q: 'Is the app ready?', a: 'A prototype is in development. Any preview we share will be illustrative and may change.' },
  { g: 'Where and when', q: 'Where will HUMAN launch?', a: 'A first pilot is planned for Delhi NCR. That plan is subject to change. We welcome interest from across India.' },
  { g: 'Where and when', q: 'Can I join the waitlist from anywhere in India?', a: 'Yes — you can express interest from anywhere in India. That does not guarantee that eventual services will be available where you live.' },
  { g: 'Where and when', q: 'Does joining the waitlist guarantee membership or a place?', a: 'No. It registers interest only.' },
  { g: 'What it includes', q: 'How much will it cost?', a: 'Pricing is not final, and no memberships are on sale.' },
  { g: 'What it includes', q: 'What tests or medical services are included?', a: 'The testing, clinician oversight, eligibility and overall scope are still being developed. We are not promising any specific or universal panel.' },
  { g: 'What it includes', q: 'Is this medical advice or a diagnosis service?', a: 'No. This website describes a planned concept. It does not give individual medical advice or diagnoses. For personal health concerns, please contact a licensed professional.' },
  { g: 'Your information', q: 'What information is collected when I express interest?', a: 'The waitlist form asks for your name, email, city and state, with an optional WhatsApp number. It does not ask for health information. Registrations are not being accepted yet — the form is a preview until the privacy notice and the system behind it have been reviewed and approved.' },
  { g: 'Your information', q: 'Will I receive updates?', a: 'Only if you explicitly opt in to updates, and only once we are actually able to send them. Joining the waitlist does not subscribe you to anything by itself.' },
  { g: 'Your information', q: 'How can I contact HUMAN?', a: CONTACT_EMAIL ? `You can write to ${CONTACT_EMAIL}.` : 'A public contact address is being set up and will be listed here once it is confirmed.' },
];
const groups = [...new Set(faqs.map((f) => f.g))];
---

<Base
  title="FAQ — HUMAN"
  description="Straight answers about HUMAN: what it is, whether it is available, where it will pilot, pricing, medical boundaries and the waitlist."
>
  <section class="faq-hero on-dark" data-reveal-eager>
    <div class="wrap">
      <p class="eyebrow" data-reveal="fade"><span>FAQ</span></p>
      <h1 class="display" data-reveal="fade">Straight <em>answers.</em></h1>
      <p class="lede" data-reveal="fade">HUMAN is in development. Here is what that means in practice.</p>
    </div>
  </section>

  <section class="section on-light faq">
    <div class="wrap faq__grid">
      {
        groups.map((g) => (
          <div class="faq__group">
            <h2 class="eyebrow no-rule"><span>{g}</span></h2>
            <div>
              {faqs
                .filter((f) => f.g === g)
                .map((f) => (
                  <details>
                    <summary>
                      <span>{f.q}</span>
                      <span class="faq__ico" aria-hidden="true" />
                    </summary>
                    <p>{f.a}</p>
                  </details>
                ))}
            </div>
          </div>
        ))
      }
      <div class="faq__group">
        <h2 class="eyebrow no-rule"><span>More</span></h2>
        <p class="prose">
          Policies are in draft and awaiting review: <a class="text-link" href="/privacy">Privacy</a>,
          <a class="text-link" href="/terms">Terms</a> and the
          <a class="text-link" href="/medical-disclaimer">Medical disclaimer</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section on-dark cta-band">
    <div class="wrap">
      <h2 class="display" data-reveal>Be part of what <em>we’re building.</em></h2>
      <p class="lede" data-reveal>Register your interest and, if you opt in, hear about HUMAN as it develops.</p>
      <div class="actions">
        <a class="btn" href="/waitlist">Join the waitlist <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .faq-hero {
    padding-block: calc(var(--header-h) + clamp(56px, 8vw, 104px)) clamp(48px, 6vw, 80px);
  }
  .faq-hero h1 {
    margin: 20px 0 22px;
  }
  .faq {
    padding-top: clamp(48px, 6vw, 88px);
  }
  .faq__group {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 16px clamp(20px, 3vw, 48px);
    padding-block: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--text);
  }
  .faq__group h2 {
    padding-top: 22px;
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .faq__ico {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, currentColor 26%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, currentColor 10%, transparent), color-mix(in srgb, currentColor 3%, transparent));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transition:
      transform 260ms var(--ease-human),
      border-color 260ms var(--ease-human);
  }
  summary:hover .faq__ico {
    border-color: color-mix(in srgb, currentColor 55%, transparent);
  }
  details[open] > summary .faq__ico {
    border-color: var(--accent);
  }
  .faq__ico::before,
  .faq__ico::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    top: 16.5px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
  }
  .faq__ico::after {
    transform: rotate(90deg);
  }
  details[open] .faq__ico {
    transform: rotate(45deg);
  }
  details p {
    padding: 0 40px 24px 0;
    color: var(--muted);
    max-width: 40em;
  }
  @media (prefers-reduced-motion: no-preference) {
    details[open] p {
      animation: faq-in 220ms var(--ease-out);
    }
  }
  @keyframes faq-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
  @media (max-width: 767px) {
    .faq__group {
      grid-template-columns: 1fr;
    }
    .faq__group h2 {
      padding-top: 0;
    }
  }
</style>
