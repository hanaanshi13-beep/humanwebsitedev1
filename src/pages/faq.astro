---
// Frequently asked questions: five categories, 26 questions (data/faq.ts). One category shows at a time; each
// question expands in place. Every question and answer is in the page's HTML, so it reads in full without scripts.
import Base from '../layouts/Base.astro';
import PageIntro from '../components/info/PageIntro.astro';
import PlansCta from '../components/plans/PlansCta.astro';
import { FAQ } from '../data/faq';
import { rich } from '../data/rich';
import { CONTACT_EMAIL } from '../data/site';
---

<Base
  title="Frequently Asked Questions | HUMAN"
  description="What HUMAN is, the health plans being developed, blood tests and health insights, medical boundaries, and the waitlist. HUMAN is currently in development."
>
  <section class="fq on-light" aria-labelledby="faq-title" data-faq={FAQ[0].id}>
    <PageIntro
      eyebrow="HUMAN"
      title="Your questions, answered."
      lede="Everything you need to know about HUMAN, what we’re building and how we want to help you understand your health."
      id="faq-title"
    />

    <div class="wrap">
      <div class="fq__cats" data-faq-tabs aria-label="Question categories">
        {
          FAQ.map((c, i) => (
            <button class="fq__cat" type="button" id={`faq-tab-${c.id}`} data-faq-tab={c.id} aria-controls={`faq-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'}>
              {c.name}
            </button>
          ))
        }
      </div>
    </div>

    <div class="wrap fq__panels">
      {
        FAQ.map((c, ci) => (
          <section class:list={['fq__panel', { 'is-active': ci === 0 }]} id={`faq-${c.id}`} data-faq-panel={c.id}>
            <h2 class="fq__heading">{c.name}</h2>
            <div class="fq__list">
              {c.items.map((f, i) => (
                <div class:list={['fq__item', { 'is-open': ci === 0 && i === 0 }]} data-faq-item>
                  <h3 class="fq__q">
                    <button type="button" id={`faq-${c.id}-q${i + 1}`} data-faq-q aria-expanded="true" aria-controls={`faq-${c.id}-a${i + 1}`}>
                      <span>{f.q}</span>
                      <span class="fq__ico" aria-hidden="true" />
                    </button>
                  </h3>
                  <div class="fq__a" id={`faq-${c.id}-a${i + 1}`}>
                    <div>
                      <p set:html={rich(f.a)} />
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))
      }
      <p class="fq__more">
        Have another question? Write to <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>

  <PlansCta />

  <script>
    import '../scripts/faq.ts';
  </script>
</Base>

<style is:global>
  .fq {
    padding-bottom: clamp(40px, 5vw, 72px);
  }
  /* category controls: quiet pills of the site's clear glass; the active one carries a breath of amber */
  .fq__cats {
    display: flex;
    gap: 8px;
    margin: clamp(30px, 3.6vw, 48px) calc(-1 * var(--gutter)) 0;
    padding: 6px var(--gutter) 10px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .fq__cats::-webkit-scrollbar {
    display: none;
  }
  .fq__cat {
    flex: none;
    min-height: 44px;
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--glass-border);
    background: var(--glass-sheen), var(--glass-bg);
    background-clip: padding-box;
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--motion-control) var(--ease-human),
      border-color var(--motion-control) var(--ease-human),
      box-shadow var(--motion-control) var(--ease-human),
      color var(--motion-micro) var(--ease-human);
  }
  @media (hover: hover) {
    .fq__cat:hover {
      color: var(--text);
      border-color: var(--glass-border-hover);
    }
  }
  .fq__cat[aria-selected='true'] {
    color: var(--glass-text);
    font-weight: 600;
    border-color: var(--glass-tint-border);
    background:
      var(--glass-sheen),
      linear-gradient(var(--glass-tint-hover), var(--glass-tint-hover)),
      var(--glass-bg);
    background-clip: padding-box;
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      var(--glass-shadow);
  }
  .fq__cat:focus-visible {
    outline: 2px solid var(--glass-focus);
    outline-offset: 3px;
    border-radius: var(--radius-pill);
  }
  /* without scripting every category is written out below, so the switcher is not shown */
  html:not(.js) .fq__cats {
    display: none;
  }

  .fq__panels {
    margin-top: clamp(28px, 3.4vw, 52px);
  }
  .fq__panel {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--col-gap);
    row-gap: clamp(14px, 2vw, 22px);
    align-items: start;
  }
  .fq__panel + .fq__panel {
    margin-top: clamp(48px, 6vw, 88px);
  }
  html.js .fq__panel {
    margin-top: 0;
  }
  html.js .fq__panel:not(.is-active) {
    display: none;
  }
  .fq__heading {
    grid-column: 1 / span 4;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.875rem, 3vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .fq__list {
    grid-column: 5 / -1;
    border-top: 1px solid var(--text);
  }
  @media (min-width: 900px) {
    .fq__heading {
      position: sticky;
      top: calc(var(--header-h) + 24px);
      padding-top: 18px;
    }
  }
  @media (max-width: 899px) {
    .fq__heading,
    .fq__list {
      grid-column: 1 / -1;
    }
  }
  .fq__item {
    border-bottom: 1px solid var(--rule);
  }
  .fq__q button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 68px;
    padding: 16px 0;
    border: 0;
    background: none;
    text-align: left;
    font-size: clamp(1.0625rem, 1.45vw, 1.3125rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.008em;
    color: var(--text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  html:not(.js) .fq__q button {
    cursor: default;
  }
  .fq__q button:focus-visible {
    outline: 3px solid #14191c;
    outline-offset: 2px;
    border-radius: 6px;
  }
  /* plus becomes minus: the upright bar turns and fades */
  .fq__ico {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    background: var(--glass-sheen), var(--glass-bg);
    background-clip: padding-box;
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    transition:
      border-color var(--motion-control) var(--ease-human),
      background-color var(--motion-control) var(--ease-human);
  }
  .fq__ico::before,
  .fq__ico::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 300ms var(--ease-human),
      opacity 300ms var(--ease-human);
  }
  .fq__ico::after {
    transform: rotate(90deg);
  }
  html.js .fq__item.is-open .fq__ico::after {
    transform: rotate(180deg);
    opacity: 0;
  }
  html:not(.js) .fq__ico {
    display: none;
  }
  @media (hover: hover) {
    html.js .fq__q button:hover .fq__ico {
      border-color: var(--glass-border-hover);
      --glass-bg: var(--glass-bg-hover);
    }
  }
  /* the answer opens by height and opacity; while closed it is out of the tab order and hidden from assistive tech */
  .fq__a {
    display: grid;
    grid-template-rows: 1fr;
  }
  .fq__a > div {
    min-height: 0;
    overflow: hidden;
  }
  .fq__a p {
    max-width: 38em;
    padding: 0 56px clamp(20px, 2.2vw, 28px) 0;
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    line-height: 1.62;
    color: var(--muted);
    text-wrap: pretty;
  }
  html.js .fq__a {
    transition:
      grid-template-rows 320ms var(--ease-human),
      opacity 320ms var(--ease-human),
      visibility 0s linear 0s;
  }
  html.js .fq__item:not(.is-open) .fq__a {
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 320ms var(--ease-human),
      opacity 220ms var(--ease-human),
      visibility 0s linear 320ms;
  }
  /* further questions: one quiet line under the list, aligned with it */
  .fq__more {
    margin-top: clamp(22px, 2.6vw, 34px);
    font-size: var(--fs-small);
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .fq__more {
      margin-left: calc((100% + var(--col-gap)) / 3);
    }
  }
  /* changing category: the new list arrives with a short fade */
  html.js-motion .fq__panel.is-active {
    animation: fq-in 260ms var(--ease-out) both;
  }
  @keyframes fq-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (max-width: 599px) {
    .fq__a p {
      padding-right: 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fq__a,
    .fq__ico::before,
    .fq__ico::after {
      transition: none !important;
    }
  }
</style>
